#!/bin/bash
# Install Easy!Appointments data directories and networks. Do not print secrets.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"

echo "Installing Easy!Appointments for ${SPRW__CUSTOMER} (${SPRW__APPDOMAIN})..."

mkdir -p "$SPRW__COMPOSE_DIR"
mkdir -p "$SPRW__DATA_DIR/db"

# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_mylampiphant_networks "$SPRW__CUSTOMER"

# Official MariaDB image runs as mysql (uid 999).
chown -R 999:999 "$SPRW__DATA_DIR/db"

echo "Installation finished."
echo "URL: https://${SPRW__APPDOMAIN}"
echo "Data directory: ${SPRW__DATA_DIR}"
echo "After the first start, complete the setup wizard at https://${SPRW__APPDOMAIN} and create the admin account."
