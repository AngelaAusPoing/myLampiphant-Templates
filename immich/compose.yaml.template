# App "immich" - compose template
# Immich photo and video backup. Single instance per customer: immich_c_<customer>.
# Services: immich-server, optional immich-machine-learning, Valkey (Redis), PostgreSQL
# with VectorChord (Immich's own image). All images are multi-arch incl. linux/arm64.
#
# Generated by app.sh from _templates_/immich/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   SPRW_IMMICH_ML_ENABLED:  true | false
#     true  = run the machine-learning container (face recognition, smart search).
#             Needs about 1-1.5 GB RAM more and downloads models on first use.
#     false = no ML container. Also switch off "Machine Learning" under
#             Administration > Settings in the Immich UI, otherwise ML jobs fail.
#   SPRW_IMMICH_DB_STORAGE: ssd | hdd
#     hdd = PostgreSQL tuning for spinning disks / network block storage.
#
# Internal services talk on the stack-local network "backend" with the service
# names Immich expects (database, redis, immich-machine-learning). Only the
# server joins proxy-shared and customer-net.
services:
  immich-server:
    image: ${SPRW_IMMICH_IMAGE:-ghcr.io/immich-app/immich-server:v3.4.1}
    container_name: ${SPRW__STACKNAME:-immich_c_customer_directory}
    restart: unless-stopped
    mem_limit: ${SPRW_IMMICH_MEM_LIMIT:-1024m}
    networks:
      - proxy-shared
      - customer-net
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - ${SPRW_IMMICH_UPLOAD_DIR}:/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-immich_c_customer_directory}_upload:/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-immich_c_customer_directory}_upload:/data
    {%- endif %}
      - /etc/localtime:/etc/localtime:ro
    environment:
      - TZ=${SPRW_IMMICH_TIMEZONE:-Europe/Berlin}
      - DB_HOSTNAME=database
      - DB_USERNAME=${SPRW_IMMICH_DB_USER:-immich}
      - DB_PASSWORD=${SPRW_IMMICH_DB_PASSWORD}
      - DB_DATABASE_NAME=${SPRW_IMMICH_DB_NAME:-immich}
      - REDIS_HOSTNAME=redis
    depends_on:
      redis:
        condition: service_healthy
      database:
        condition: service_healthy
    healthcheck:
      disable: false
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.http.routers.${SPRW__STACKNAME:-immich_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-immich_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-immich_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-immich_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-immich_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-immich_c_customer_directory}.loadbalancer.server.port=2283"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      # Only VPN and internal networks. The middleware is defined here, no file provider needed.
      - "traefik.http.middlewares.${SPRW__STACKNAME:-immich_c_customer_directory}-iprestrict.ipallowlist.sourcerange=${SPRW_IMMICH_INTERNAL_SOURCERANGE}"
      - "traefik.http.routers.${SPRW__STACKNAME:-immich_c_customer_directory}.middlewares=${SPRW__STACKNAME:-immich_c_customer_directory}-iprestrict"
      {%- endif %}
{%- if SPRW_IMMICH_ML_ENABLED == "true" %}

  immich-machine-learning:
    image: ${SPRW_IMMICH_ML_IMAGE:-ghcr.io/immich-app/immich-machine-learning:v3.4.1}
    container_name: ${SPRW__STACKNAME:-immich_c_customer_directory}_ml
    restart: unless-stopped
    mem_limit: ${SPRW_IMMICH_ML_MEM_LIMIT:-1536m}
    cpus: ${SPRW_IMMICH_ML_CPUS:-1.5}
    networks:
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-immich_c_customer_directory}/model-cache:/cache
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-immich_c_customer_directory}_model_cache:/cache
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-immich_c_customer_directory}_model_cache:/cache
    {%- endif %}
    environment:
      - TZ=${SPRW_IMMICH_TIMEZONE:-Europe/Berlin}
      - MACHINE_LEARNING_MODEL_REVISION=v2
      # Unload models after 5 minutes without requests (frees RAM on small servers).
      - MACHINE_LEARNING_MODEL_TTL=${SPRW_IMMICH_ML_MODEL_TTL:-300}
      - MACHINE_LEARNING_WORKERS=1
      - MACHINE_LEARNING_REQUEST_THREADS=${SPRW_IMMICH_ML_THREADS:-1}
    healthcheck:
      disable: false
{%- endif %}

  redis:
    image: ${SPRW_IMMICH_REDIS_IMAGE:-valkey/valkey:9.0.7-alpine}
    container_name: ${SPRW__STACKNAME:-immich_c_customer_directory}_redis
    restart: unless-stopped
    mem_limit: ${SPRW_IMMICH_REDIS_MEM_LIMIT:-64m}
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep -q PONG || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 6

  database:
    image: ${SPRW_IMMICH_DB_IMAGE:-ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0}
    container_name: ${SPRW__STACKNAME:-immich_c_customer_directory}_db
    restart: unless-stopped
    mem_limit: ${SPRW_IMMICH_DB_MEM_LIMIT:-512m}
    shm_size: 128mb
    networks:
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-immich_c_customer_directory}/postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-immich_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-immich_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- endif %}
    environment:
      - POSTGRES_USER=${SPRW_IMMICH_DB_USER:-immich}
      - POSTGRES_PASSWORD=${SPRW_IMMICH_DB_PASSWORD}
      - POSTGRES_DB=${SPRW_IMMICH_DB_NAME:-immich}
      - POSTGRES_INITDB_ARGS=--data-checksums
      {%- if SPRW_IMMICH_DB_STORAGE == "hdd" %}
      - DB_STORAGE_TYPE=HDD
      {%- endif %}
    healthcheck:
      disable: false

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-immich_c_customer_directory}_upload:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: ${SPRW_IMMICH_UPLOAD_DIR}

  ${SPRW__STACKNAME:-immich_c_customer_directory}_postgres:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-immich_c_customer_directory}/postgres
  {%- if SPRW_IMMICH_ML_ENABLED == "true" %}

  ${SPRW__STACKNAME:-immich_c_customer_directory}_model_cache:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-immich_c_customer_directory}/model-cache
  {%- endif %}
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-immich_c_customer_directory}_upload:
  ${SPRW__STACKNAME:-immich_c_customer_directory}_postgres:
  {%- if SPRW_IMMICH_ML_ENABLED == "true" %}
  ${SPRW__STACKNAME:-immich_c_customer_directory}_model_cache:
  {%- endif %}
{%- endif %}

# ===================== Networks =====================
# proxy-shared: Traefik (always attached; EXTERNAL_ACCESS=false limits access with an IP allowlist)
# customer-net: other apps of the same customer (created by ensure-networks.sh if missing)
# backend:      stack-local network for database, redis and machine learning. Not
#               internal, because the ML container downloads its models on first use.
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
  backend:
    name: ${SPRW__STACKNAME:-immich_c_customer_directory}_backend
