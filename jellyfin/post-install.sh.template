#!/bin/bash
# post-install.sh for the app "jellyfin" - generated by app.sh from
# _templates_/jellyfin/post-install.sh.template - do not edit, edit the template.
#
# Runs on the host after the stack is up (app.sh jellyfin add|redeploy) or on demand:
#   app.sh jellyfin post-install <customer>
# Idempotent: every step checks the current state first.
#
#   1. SETUP=auto: finish the first-start wizard through the Jellyfin API
#      (admin account from the persistent config). SETUP=manual: skip; you
#      finish the wizard in the browser and enter that admin in the config.
#   2. Get an API key for this script (stored chmod 600 in <data_dir>/secrets/).
#   3. AUTH=ldap: install the "LDAP Authentication" plugin from the official
#      Jellyfin repository, restart Jellyfin and configure the plugin with the
#      LDAP_* values. The bind password is read from LDAP_BIND_PW_FILE.
#      Values that someone changed in the Jellyfin UI are not overwritten
#      (use --force to overwrite them with the config values).
#
# Secrets are read at runtime from the persistent config / secret files and are
# never printed or passed on a command line.
set -euo pipefail

export JF_STACK="!!STACKNAME!!"
export JF_DATA_DIR="!!DATA_DIR!!"
export JF_APPDOMAIN="!!APPDOMAIN!!"
export JF_CONFIG_FILE="$(dirname "$JF_DATA_DIR")/_config_/$JF_STACK.env"
export JF_SECRETS_DIR="$JF_DATA_DIR/secrets"
export JF_FORCE=0
[ "${1:-}" = "--force" ] && JF_FORCE=1
{%- if SPRW_JELLYFIN_SETUP == "auto" %}
export JF_SETUP=auto
{%- elif SPRW_JELLYFIN_SETUP == "manual" %}
export JF_SETUP=manual
{%- endif %}
{%- if SPRW_JELLYFIN_AUTH == "ldap" %}
export JF_LDAP=true
{%- elif SPRW_JELLYFIN_AUTH == "plain" %}
export JF_LDAP=false
{%- endif %}

if [ ! -f "$JF_CONFIG_FILE" ]; then
    echo "ERROR: persistent config not found: $JF_CONFIG_FILE" >&2
    exit 1
fi
mkdir -p "$JF_SECRETS_DIR"
chmod 700 "$JF_SECRETS_DIR"

python3 - <<'PYHOOK'
import hashlib, json, os, re, subprocess, sys, time, urllib.error, urllib.parse, urllib.request

STACK = os.environ["JF_STACK"]
CONFIG_FILE = os.environ["JF_CONFIG_FILE"]
SECRETS_DIR = os.environ["JF_SECRETS_DIR"]
FORCE = os.environ.get("JF_FORCE") == "1"
SETUP = os.environ.get("JF_SETUP", "manual")
LDAP = os.environ.get("JF_LDAP", "false") == "true"
API_KEY_FILE = os.path.join(SECRETS_DIR, "post-install-api.key")
LDAP_STATE_FILE = os.path.join(SECRETS_DIR, "post-install-ldap.state")
KEY_APP_NAME = "post-install"
LDAP_PLUGIN_GUID = "958aad66-3784-4d2a-b89a-a7b6fab6e25c"
LDAP_PLUGIN_NAME = "LDAP Authentication"
CLIENT = 'MediaBrowser Client="post-install", Device="host", DeviceId="post-install-' + STACK + '", Version="1.0"'


def die(msg):
    print("ERROR: " + msg, file=sys.stderr)
    sys.exit(1)


def cfg(name, default=""):
    """Read one value from the persistent config (same rules as read_cfg in install.sh)."""
    with open(CONFIG_FILE, encoding="utf-8") as f:
        for line in f:
            if not line.startswith(name + "="):
                continue
            v = line[len(name) + 1:].rstrip("\n")
            m = re.match(r"^'([^']*)'", v) or re.match(r'^"([^"]*)"', v)
            if m:
                v = m.group(1)
            else:
                v = re.sub(r"\s+#.*$", "", v).strip()
            if v == "" or "!!" in v:
                return default
            return v
    return default


def container_url():
    try:
        out = subprocess.run(["docker", "inspect", STACK], check=True, capture_output=True, text=True).stdout
    except subprocess.CalledProcessError:
        die("container " + STACK + " not found - is the stack deployed?")
    info = json.loads(out)[0]
    if not info.get("State", {}).get("Running"):
        die("container " + STACK + " is not running")
    nets = info.get("NetworkSettings", {}).get("Networks", {})
    for name in ["proxy-shared"] + sorted(nets):
        ip = (nets.get(name) or {}).get("IPAddress")
        if ip:
            return "http://" + ip + ":8096"
    die("no IP address found for " + STACK)


BASE = container_url()


def call(method, path, body=None, token=None, ok=(200, 204), raw=False):
    data = None if body is None else json.dumps(body).encode()
    auth = CLIENT + (', Token="' + token + '"' if token else "")
    req = urllib.request.Request(BASE + path, data=data, method=method,
                                 headers={"Authorization": auth, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            text = r.read().decode() if r.status != 204 else ""
            status = r.status
    except urllib.error.HTTPError as e:
        status, text = e.code, ""
    except (urllib.error.URLError, ConnectionError, TimeoutError) as e:
        return None, None
    if status not in ok:
        return status, None
    if raw or not text:
        return status, text
    try:
        return status, json.loads(text)
    except ValueError:
        return status, text


def wait_ready(timeout=300):
    end = time.time() + timeout
    while time.time() < end:
        status, info = call("GET", "/System/Info/Public")
        if status == 200 and isinstance(info, dict):
            return info
        time.sleep(5)
    die("Jellyfin did not answer within %d s at %s" % (timeout, BASE))


info = wait_ready()
print("Jellyfin %s is up (%s)." % (info.get("Version", "?"), STACK))

admin_user = cfg("SPRW_JELLYFIN_ADMIN_USER", "admin")
admin_pw = cfg("SPRW_JELLYFIN_ADMIN_PASSWORD")

# 1. First-start wizard -------------------------------------------------------
if not info.get("StartupWizardCompleted"):
    if SETUP != "auto":
        print("Setup wizard is still open (SETUP=manual): finish it at https://" + os.environ["JF_APPDOMAIN"]
              + ", enter that admin in SPRW_JELLYFIN_ADMIN_USER/_PASSWORD and run post-install again.")
        sys.exit(0)
    if not admin_pw:
        die("SPRW_JELLYFIN_ADMIN_PASSWORD is empty in " + CONFIG_FILE)
    lang = cfg("SPRW_JELLYFIN_LANGUAGE", "de")
    country = cfg("SPRW_JELLYFIN_COUNTRY", "DE")
    steps = [
        ("POST", "/Startup/Configuration", {"UICulture": lang, "MetadataCountryCode": country,
                                            "PreferredMetadataLanguage": lang}),
        ("GET", "/Startup/User", None),
        ("POST", "/Startup/User", {"Name": admin_user, "Password": admin_pw}),
        ("POST", "/Startup/RemoteAccess", {"EnableRemoteAccess": True}),
        ("POST", "/Startup/Complete", None),
    ]
    for method, path, body in steps:
        status, _ = call(method, path, body)
        if status not in (200, 204):
            die("setup wizard step %s %s failed (HTTP %s)" % (method, path, status))
    print("Setup wizard completed. Admin user: %s (password: SPRW_JELLYFIN_ADMIN_PASSWORD in the persistent config)." % admin_user)
else:
    print("Setup wizard already completed.")

# 2. API key for this script ----------------------------------------------------
def read_key():
    try:
        with open(API_KEY_FILE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def key_works(key):
    return bool(key) and call("GET", "/System/Info", token=key)[0] == 200


token = read_key()
if not key_works(token):
    if not admin_pw:
        die("no working API key in %s and no SPRW_JELLYFIN_ADMIN_PASSWORD in the config. "
            "Either enter the Jellyfin admin in SPRW_JELLYFIN_ADMIN_USER/_PASSWORD or create an API key "
            "(Dashboard > API Keys) and write it to %s (chmod 600)." % (API_KEY_FILE, API_KEY_FILE))
    status, auth = call("POST", "/Users/AuthenticateByName", {"Username": admin_user, "Pw": admin_pw})
    if status != 200 or not isinstance(auth, dict) or not auth.get("AccessToken"):
        die("login as %s failed (HTTP %s). Check SPRW_JELLYFIN_ADMIN_USER/_PASSWORD in %s."
            % (admin_user, status, CONFIG_FILE))
    session = auth["AccessToken"]
    _, keys = call("GET", "/Auth/Keys", token=session)
    found = [k for k in (keys or {}).get("Items", []) if k.get("AppName") == KEY_APP_NAME]
    if not found:
        if call("POST", "/Auth/Keys?app=" + urllib.parse.quote(KEY_APP_NAME), token=session)[0] not in (200, 204):
            die("could not create an API key")
        _, keys = call("GET", "/Auth/Keys", token=session)
        found = [k for k in (keys or {}).get("Items", []) if k.get("AppName") == KEY_APP_NAME]
    if not found:
        die("API key was not created")
    token = found[0]["AccessToken"]
    old = os.umask(0o077)
    with open(API_KEY_FILE, "w", encoding="utf-8") as f:
        f.write(token + "\n")
    os.umask(old)
    os.chmod(API_KEY_FILE, 0o600)
    call("POST", "/Sessions/Logout", token=session)
    print("API key for post-install stored in " + API_KEY_FILE)

if not LDAP:
    print("AUTH=plain: no LDAP plugin needed. Done.")
    sys.exit(0)

# 3. LDAP plugin ----------------------------------------------------------------
def ldap_plugin():
    _, plugins = call("GET", "/Plugins", token=token)
    for p in plugins or []:
        if str(p.get("Id", "")).replace("-", "").lower() == LDAP_PLUGIN_GUID.replace("-", ""):
            return p
    return None


plugin = ldap_plugin()
if plugin is None:
    print("Installing plugin '%s' from the official repository..." % LDAP_PLUGIN_NAME)
    status, _ = call("POST", "/Packages/Installed/" + urllib.parse.quote(LDAP_PLUGIN_NAME)
                     + "?assemblyGuid=" + LDAP_PLUGIN_GUID, token=token)
    if status not in (200, 204):
        die("plugin installation failed (HTTP %s). Is the official plugin repository enabled?" % status)
    print("Restarting Jellyfin to load the plugin...")
    call("POST", "/System/Restart", token=token)
    time.sleep(20)
    wait_ready()
    for _ in range(12):
        plugin = ldap_plugin()
        if plugin:
            break
        time.sleep(5)
    if plugin is None:
        die("plugin is not loaded after the restart. Restart the stack (app.sh jellyfin restart <customer>) "
            "and run post-install again; check the Jellyfin log if it stays missing.")
if str(plugin.get("Status", "Active")) not in ("Active", "Restart"):
    die("LDAP plugin status is %s - check Dashboard > Plugins" % plugin.get("Status"))
print("LDAP plugin %s is installed (status %s)." % (plugin.get("Version", "?"), plugin.get("Status", "?")))

pw_file = cfg("SPRW_JELLYFIN_LDAP_BIND_PW_FILE", "/opt/docker-data/_host_/ldap/secrets/readonly.pw")
try:
    with open(pw_file, encoding="utf-8") as f:
        bind_pw = f.read().strip()
except OSError:
    die("LDAP bind password file not readable: " + pw_file)
if not bind_pw:
    die("LDAP bind password file is empty: " + pw_file)

base_dn = cfg("SPRW_JELLYFIN_LDAP_BASE_DN")
groups_dn = re.sub(r"^ou=people,", "ou=groups,", base_dn) if base_dn.startswith("ou=people,") else ""
user_group = cfg("SPRW_JELLYFIN_LDAP_USER_GROUP")
admin_group = cfg("SPRW_JELLYFIN_LDAP_ADMIN_GROUP", "jellyfin-admin")
if not base_dn or not groups_dn:
    die("SPRW_JELLYFIN_LDAP_BASE_DN must look like ou=people,o=<customer>,<suffix>")
if not cfg("SPRW_JELLYFIN_LDAP_BIND_DN"):
    die("SPRW_JELLYFIN_LDAP_BIND_DN is empty in " + CONFIG_FILE)

desired = {
    "LdapServer": cfg("SPRW_JELLYFIN_LDAP_SERVER", "ldap"),
    "LdapPort": int(cfg("SPRW_JELLYFIN_LDAP_PORT", "389")),
    "UseSsl": False,
    "UseStartTls": False,
    "SkipSslVerify": False,
    "LdapBindUser": cfg("SPRW_JELLYFIN_LDAP_BIND_DN"),
    "LdapBaseDn": base_dn,
    "LdapSearchFilter": ("(memberOf=cn=%s,%s)" % (user_group, groups_dn)) if user_group else "(uid=*)",
    "LdapAdminBaseDn": "",
    "LdapAdminFilter": "(memberOf=cn=%s,%s)" % (admin_group, groups_dn) if admin_group else "_disabled_",
    "EnableLdapAdminFilterMemberUid": False,
    "LdapSearchAttributes": "uid, mail",
    "LdapUidAttribute": "uid",
    "LdapUsernameAttribute": "uid",
    "CreateUsersFromLdap": True,
    "AllowPassChange": False,
    "EnableAllFolders": True,
}
pw_hash = hashlib.sha256(bind_pw.encode()).hexdigest()

_, current = call("GET", "/Plugins/" + LDAP_PLUGIN_GUID + "/Configuration", token=token)
if not isinstance(current, dict):
    die("could not read the LDAP plugin configuration")

try:
    with open(LDAP_STATE_FILE, encoding="utf-8") as f:
        last = json.load(f)
except (OSError, ValueError):
    last = None

managed = list(desired)
cur_view = {k: current.get(k) for k in managed}
apply = True
if all(current.get(k) == v for k, v in desired.items()) and last and last.get("pw") == pw_hash:
    print("LDAP plugin configuration is up to date.")
    apply = False
elif (last is not None and cur_view != last.get("values")
      and current.get("LdapServer") not in (None, "", "ldap-server.contoso.com") and not FORCE):
    print("WARNING: the LDAP settings were changed in the Jellyfin UI since the last run; "
          "not overwriting them. Run 'post-install.sh --force' to apply the config values.")
    sys.exit(0)

if apply:
    new = dict(current)          # keep LdapUsers (links to Jellyfin users) and other fields
    new.update(desired)
    new["LdapBindPassword"] = bind_pw
    status, _ = call("POST", "/Plugins/" + LDAP_PLUGIN_GUID + "/Configuration", new, token=token)
    if status not in (200, 204):
        die("saving the LDAP plugin configuration failed (HTTP %s)" % status)
    old = os.umask(0o077)
    with open(LDAP_STATE_FILE, "w", encoding="utf-8") as f:
        json.dump({"values": desired, "pw": pw_hash}, f)
    os.umask(old)
    print("LDAP plugin configured: server %s:%s, base %s, admins: group %s."
          % (desired["LdapServer"], desired["LdapPort"], base_dn, admin_group or "-"))

# Connection and filter test through the plugin API (answers contain no secrets).
# The test endpoints save the values they get, so they get exactly the config values.
conn = {k: desired[k] for k in ("LdapServer", "LdapPort", "UseSsl", "UseStartTls", "SkipSslVerify",
                                 "LdapBindUser", "LdapBaseDn", "AllowPassChange")}
conn.update({"LdapBindPassword": bind_pw, "PasswordResetUrl": current.get("PasswordResetUrl") or "",
             "LdapClientCertPath": current.get("LdapClientCertPath") or "",
             "LdapClientKeyPath": current.get("LdapClientKeyPath") or "",
             "LdapRootCaPath": current.get("LdapRootCaPath") or ""})
status, result = call("POST", "/Ldap/TestServerBind", conn, token=token)
print("LDAP bind test: %s" % (result if isinstance(result, str) and len(result) < 200 else ("HTTP %s" % status)))
filters = {"LdapSearchFilter": desired["LdapSearchFilter"], "LdapAdminFilter": desired["LdapAdminFilter"],
           "EnableLdapAdminFilterMemberUid": False}
status, result = call("POST", "/Ldap/TestLdapFilters", filters, token=token, ok=(200, 204, 400, 401))
if isinstance(result, dict) and "Users" in result:
    print("LDAP filter test: %s users, %s admins." % (result.get("Users"), result.get("Admins")))
else:
    die("LDAP filter test failed (HTTP %s): %s" % (status, (result or {}).get("Message", "") if isinstance(result, dict) else ""))
print("Done. LDAP users of this customer can now sign in at https://" + os.environ["JF_APPDOMAIN"])
PYHOOK
