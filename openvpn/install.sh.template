#!/bin/bash
# install.sh for the app "openvpn" - generated by app.sh from
# _templates_/openvpn/install.sh.template
# Prepares the host side (networks, subnet allocation, vpn.env, scripts)
# BEFORE the stack is deployed via Komodo.
# Idempotent: existing vpn.env and PKI data are never overwritten.
# Secrets (PKI, client certs) are never printed. This script does not
# change Traefik, host port 443, or sslh. ufw is only opened for the
# UDP listen port when transport is udp1194.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW_OVPN_IMAGE="!!OVPN_IMAGE!!"
SPRW_OVPN_TRANSPORT="!!OVPN_TRANSPORT!!"
SPRW_OVPN_PORT="!!OVPN_PORT!!"
SPRW_OVPN_BACKEND_PORT="!!OVPN_BACKEND_PORT!!"
SPRW_OVPN_MEM_LIMIT="!!OVPN_MEM_LIMIT!!"
# Endpoint and subnet are computed (or loaded from the persistent
# config) below. Do not pull them through !!placeholders!! here: app.sh may
# substitute a circular $SPRW_OVPN_* reference and break set -u.
SPRW_OVPN_ENDPOINT=""
SPRW_OVPN_SUBNET_INDEX=""
SPRW_OVPN_IPV4_CIDR=""
SPRW_OVPN_DNS="!!OVPN_DNS!!"
SPRW_OVPN_CLIENT_NAME="!!OVPN_CLIENT_NAME!!"
SPRW_OVPN_TIMEZONE="!!TIMEZONE!!"
TEMPLATE_DIR="/opt/docker/_templates_/openvpn"
CONFIG_FILE="$(dirname "$SPRW__DATA_DIR")/_config_/${SPRW__STACKNAME}.env"
ALLOC_FILE="/opt/docker-data/_host_/_config_/vpn-subnets.conf"
CUSTOMER_NET="c_${SPRW__CUSTOMER}-net"

echo "Preparing openvpn ${SPRW__STACKNAME} ..."

# ---------------------------------------------------------------------------
# 1. Refuse to continue with unresolved required placeholders
# ---------------------------------------------------------------------------
missing=0
for v in SPRW__CUSTOMER SPRW__STACKNAME SPRW__DATA_DIR SPRW__COMPOSE_DIR \
         SPRW_OVPN_IMAGE SPRW_OVPN_TRANSPORT SPRW_OVPN_PORT SPRW_OVPN_BACKEND_PORT \
         SPRW_OVPN_MEM_LIMIT SPRW_OVPN_DNS SPRW_OVPN_CLIENT_NAME SPRW_OVPN_TIMEZONE; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in the persistent config or pass --var ${v#SPRW_OVPN_}=..." >&2
        missing=1
    fi
done
if [ "$missing" -ne 0 ]; then
    echo "Review the persistent config (<customer>/_config_/${SPRW__STACKNAME}.env) and run app.sh again." >&2
    exit 1
fi
if [ "$SPRW__CUSTOMER" = "_host_" ]; then
    echo "ERROR: openvpn is a per-customer app (openvpn_c_<customer>), not a host app." >&2
    exit 1
fi
case "$SPRW_OVPN_TRANSPORT" in
    udp1194|tcp443_sslh) ;;
    *)
        echo "ERROR: OVPN_TRANSPORT must be udp1194 or tcp443_sslh (got: ${SPRW_OVPN_TRANSPORT})." >&2
        exit 1
        ;;
esac

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}

load_cfg_if_set() {
    local key="$1"
    local dest="$2"
    local val=""
    if [ -f "$CONFIG_FILE" ]; then
        val="$(read_cfg "$key" || true)"
    fi
    if [ -n "$val" ] && [[ "$val" != *'!!'* ]]; then
        printf -v "$dest" '%s' "$val"
    fi
}
load_cfg_if_set SPRW_OVPN_ENDPOINT SPRW_OVPN_ENDPOINT
load_cfg_if_set SPRW_OVPN_SUBNET_INDEX SPRW_OVPN_SUBNET_INDEX
load_cfg_if_set SPRW_OVPN_IPV4_CIDR SPRW_OVPN_IPV4_CIDR

# Update or insert a key=value in the persistent config without printing secrets.
upsert_cfg() {
    local key="$1"
    local value="$2"
    local tmp
    tmp="$(mktemp)"
    if [ -f "$CONFIG_FILE" ] && grep -qE "^${key}=" "$CONFIG_FILE"; then
        awk -v k="$key" -v v="$value" '
            BEGIN { done=0 }
            $0 ~ "^" k "=" {
                print k "='\''" v "'\''"
                done=1
                next
            }
            { print }
            END { if (!done) print k "='\''" v "'\''" }
        ' "$CONFIG_FILE" > "$tmp"
        cat "$tmp" > "$CONFIG_FILE"
    else
        mkdir -p "$(dirname "$CONFIG_FILE")"
        printf "%s='%s'\n" "$key" "$value" >> "$CONFIG_FILE"
    fi
    rm -f "$tmp"
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

cidr_to_netmask() {
    local bits="${1##*/}"
    local mask=$(( 0xffffffff ^ ((1 << (32 - bits)) - 1) ))
    printf '%d.%d.%d.%d' \
        $(( (mask >> 24) & 255 )) $(( (mask >> 16) & 255 )) \
        $(( (mask >> 8) & 255 )) $(( mask & 255 ))
}

# ---------------------------------------------------------------------------
# 2. TUN device (needed by the container; do not load extra host modules here)
# ---------------------------------------------------------------------------
if [ ! -e /dev/net/tun ]; then
    echo "ERROR: /dev/net/tun is missing on the host. Load the tun module and retry." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 3. Customer Docker network (regular bridge, idempotent)
# ---------------------------------------------------------------------------
# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_customer_network "$SPRW__CUSTOMER"

CUSTOMER_CIDR="$(docker network inspect "$CUSTOMER_NET" | jq -r '.[0].IPAM.Config[0].Subnet')"
if [ -z "$CUSTOMER_CIDR" ] || [ "$CUSTOMER_CIDR" = "null" ]; then
    echo "ERROR: could not determine subnet of ${CUSTOMER_NET}" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 4. Subnet allocation (10.51.<n>.0/24) recorded on the host
#    Shared index <n> with WireGuard. See _templates_/wireguard/SUBNETS.md
# ---------------------------------------------------------------------------
mkdir -p "$(dirname "$ALLOC_FILE")"
if [ ! -f "$ALLOC_FILE" ]; then
    umask 022
    cat > "$ALLOC_FILE" <<'ALLOC'
# myLampiphant VPN subnet allocation (host-only, do not commit)
# n  customer            wg_cidr         ovpn_cidr       wg_ipv6
# See _templates_/wireguard/SUBNETS.md
ALLOC
fi

existing_line="$(awk -v c="$SPRW__CUSTOMER" '($1 ~ /^[0-9]+$/) && ($2 == c) {print; exit}' "$ALLOC_FILE" || true)"
if [ -n "$existing_line" ]; then
    alloc_n="$(echo "$existing_line" | awk '{print $1}')"
    alloc_ovpn="$(echo "$existing_line" | awk '{print $4}')"
    if [ -z "$alloc_ovpn" ] || [[ "$alloc_ovpn" == '#'* ]]; then
        alloc_ovpn="10.51.${alloc_n}.0/24"
    fi
    if [ -z "$SPRW_OVPN_SUBNET_INDEX" ] || [[ "$SPRW_OVPN_SUBNET_INDEX" == *'!!'* ]]; then
        SPRW_OVPN_SUBNET_INDEX="$alloc_n"
    fi
    if [ -z "$SPRW_OVPN_IPV4_CIDR" ] || [[ "$SPRW_OVPN_IPV4_CIDR" == *'!!'* ]]; then
        SPRW_OVPN_IPV4_CIDR="$alloc_ovpn"
    fi
    if [ "$SPRW_OVPN_SUBNET_INDEX" != "$alloc_n" ] || [ "$SPRW_OVPN_IPV4_CIDR" != "$alloc_ovpn" ]; then
        echo "ERROR: ${SPRW__CUSTOMER} is already allocated index ${alloc_n} (OpenVPN ${alloc_ovpn}) in ${ALLOC_FILE}, but the config asks for a different value." >&2
        exit 1
    fi
fi

if [ -z "$SPRW_OVPN_SUBNET_INDEX" ] || [[ "$SPRW_OVPN_SUBNET_INDEX" == *'!!'* ]]; then
    if [ -n "$SPRW_OVPN_IPV4_CIDR" ] && [[ "$SPRW_OVPN_IPV4_CIDR" != *'!!'* ]]; then
        SPRW_OVPN_SUBNET_INDEX="$(echo "$SPRW_OVPN_IPV4_CIDR" | awk -F'[./]' '{print $3}')"
    else
        used="$(awk '$1 ~ /^[0-9]+$/ {print $1}' "$ALLOC_FILE" | sort -n)"
        SPRW_OVPN_SUBNET_INDEX=""
        for i in $(seq 1 254); do
            if ! echo "$used" | grep -qx "$i"; then
                SPRW_OVPN_SUBNET_INDEX="$i"
                break
            fi
        done
        if [ -z "$SPRW_OVPN_SUBNET_INDEX" ]; then
            echo "ERROR: no free VPN subnet index left (1-254) in ${ALLOC_FILE}" >&2
            exit 1
        fi
    fi
fi

if ! [[ "$SPRW_OVPN_SUBNET_INDEX" =~ ^[0-9]+$ ]] || [ "$SPRW_OVPN_SUBNET_INDEX" -lt 1 ] || [ "$SPRW_OVPN_SUBNET_INDEX" -gt 254 ]; then
    echo "ERROR: OVPN_SUBNET_INDEX must be an integer 1-254" >&2
    exit 1
fi

if [ -z "$SPRW_OVPN_IPV4_CIDR" ] || [[ "$SPRW_OVPN_IPV4_CIDR" == *'!!'* ]]; then
    SPRW_OVPN_IPV4_CIDR="10.51.${SPRW_OVPN_SUBNET_INDEX}.0/24"
fi

conflict="$(awk -v n="$SPRW_OVPN_SUBNET_INDEX" -v c="$SPRW__CUSTOMER" -v v4="$SPRW_OVPN_IPV4_CIDR" \
    '($1 ~ /^[0-9]+$/) && ($2 != c) && ($1 == n || $4 == v4) {print $2, $1, $4; exit}' "$ALLOC_FILE" || true)"
if [ -n "$conflict" ]; then
    echo "ERROR: subnet index or OpenVPN CIDR already allocated: ${conflict}" >&2
    exit 1
fi

if [ -z "$existing_line" ]; then
    printf '%-4s %-20s %-16s %-16s %s\n' \
        "$SPRW_OVPN_SUBNET_INDEX" "$SPRW__CUSTOMER" \
        "10.50.${SPRW_OVPN_SUBNET_INDEX}.0/24" \
        "$SPRW_OVPN_IPV4_CIDR" \
        "fd50:${SPRW_OVPN_SUBNET_INDEX}::/64" >> "$ALLOC_FILE"
    echo "Allocated VPN index ${SPRW_OVPN_SUBNET_INDEX} (OpenVPN ${SPRW_OVPN_IPV4_CIDR}) for ${SPRW__CUSTOMER}."
fi

upsert_cfg SPRW_OVPN_SUBNET_INDEX "$SPRW_OVPN_SUBNET_INDEX"
upsert_cfg SPRW_OVPN_IPV4_CIDR "$SPRW_OVPN_IPV4_CIDR"

# ---------------------------------------------------------------------------
# 5. Endpoint (public address clients connect to)
# ---------------------------------------------------------------------------
if [ -z "$SPRW_OVPN_ENDPOINT" ] || [[ "$SPRW_OVPN_ENDPOINT" == *'!!'* ]]; then
    cust_profile="$(dirname "$SPRW__DATA_DIR")/customer_profile.sh"
    if [ -f "$cust_profile" ]; then
        SPRW_OVPN_ENDPOINT="$(grep -E '^export HOST_IPv4=' "$cust_profile" | head -1 | cut -d= -f2- | tr -d '"'\''[:space:]')"
    fi
fi
if [ -z "$SPRW_OVPN_ENDPOINT" ] || [[ "$SPRW_OVPN_ENDPOINT" == *'!!'* ]]; then
    SPRW_OVPN_ENDPOINT="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')"
fi
if [ -z "$SPRW_OVPN_ENDPOINT" ]; then
    echo "ERROR: could not determine OVPN_ENDPOINT (public IP or hostname). Set it in the persistent config." >&2
    exit 1
fi
upsert_cfg SPRW_OVPN_ENDPOINT "$SPRW_OVPN_ENDPOINT"

# ---------------------------------------------------------------------------
# 6. Port clash checks. Never bind or inspect host 443 as if we owned it.
# ---------------------------------------------------------------------------
if [ "$SPRW_OVPN_TRANSPORT" = "udp1194" ]; then
    udp_conflict="$(ss -lnu | awk -v p=":${SPRW_OVPN_PORT}" '$4 ~ p"$" {print; exit}')"
    if [ -n "$udp_conflict" ]; then
        echo "ERROR: UDP port ${SPRW_OVPN_PORT} is already in use on the host. Set OVPN_PORT to a free port." >&2
        exit 1
    fi
else
    tcp_conflict="$(ss -lnt | awk -v p="127.0.0.1:${SPRW_OVPN_BACKEND_PORT}" '$4 == p {print; exit}')"
    if [ -n "$tcp_conflict" ]; then
        echo "ERROR: TCP port 127.0.0.1:${SPRW_OVPN_BACKEND_PORT} is already in use. Set OVPN_BACKEND_PORT to a free localhost port." >&2
        exit 1
    fi
    echo "Note: tcp443_sslh will listen on container TCP 443 and bind only 127.0.0.1:${SPRW_OVPN_BACKEND_PORT} on the host."
    echo "      Public TCP 443, Traefik and sslh are left unchanged. Sharing 443 needs a maintenance window and Angela's approval."
fi

# ---------------------------------------------------------------------------
# 7. Directories and scripts
# ---------------------------------------------------------------------------
mkdir -p "$SPRW__DATA_DIR"/{data,secrets,scripts}
chmod 700 "$SPRW__DATA_DIR/secrets" "$SPRW__DATA_DIR/data"
for f in entrypoint.sh openvpn-shim.sh patch-config.sh ovpn-firewall.sh; do
    cp -a "$TEMPLATE_DIR/$f" "$SPRW__DATA_DIR/scripts/$f"
    chmod 755 "$SPRW__DATA_DIR/scripts/$f"
done

OVPN_NET="${SPRW_OVPN_IPV4_CIDR%/*}"
OVPN_MASK="$(cidr_to_netmask "$SPRW_OVPN_IPV4_CIDR")"
CUSTOMER_NET_ADDR="${CUSTOMER_CIDR%/*}"
CUSTOMER_MASK="$(cidr_to_netmask "$CUSTOMER_CIDR")"
if [ "$SPRW_OVPN_TRANSPORT" = "tcp443_sslh" ]; then
    OVPN_PROTO=tcp
    OVPN_LISTEN_PORT=443
else
    OVPN_PROTO=udp
    OVPN_LISTEN_PORT="$SPRW_OVPN_PORT"
fi

umask 077
cat > "$SPRW__DATA_DIR/scripts/firewall.conf" <<FCONF
# Written by install.sh; sourced inside the container. No secrets.
OVPN_IF=tun0
OVPN_CIDR=${SPRW_OVPN_IPV4_CIDR}
OVPN_NET=${OVPN_NET}
OVPN_MASK=${OVPN_MASK}
CUSTOMER_CIDR=${CUSTOMER_CIDR}
CUSTOMER_NET=${CUSTOMER_NET_ADDR}
CUSTOMER_MASK=${CUSTOMER_MASK}
OVPN_PORT=${OVPN_LISTEN_PORT}
OVPN_PROTO=${OVPN_PROTO}
FCONF
chmod 600 "$SPRW__DATA_DIR/scripts/firewall.conf"

# ---------------------------------------------------------------------------
# 8. vpn.env for the image (no keys; PKI is created in data/ on first start)
# ---------------------------------------------------------------------------
DNS1="$(echo "$SPRW_OVPN_DNS" | cut -d, -f1 | tr -d '[:space:]')"
DNS2="$(echo "$SPRW_OVPN_DNS" | cut -d, -f2 | tr -d '[:space:]')"
[ -n "$DNS2" ] || DNS2="$DNS1"

# vpn.env: IP vs FQDN for the client "remote" line
ENDPOINT_IS_IP=0
if printf '%s' "$SPRW_OVPN_ENDPOINT" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
    ENDPOINT_IS_IP=1
fi

if [ ! -f "$SPRW__DATA_DIR/secrets/vpn.env" ]; then
    umask 077
    {
        echo "VPN_PROTO=${OVPN_PROTO}"
        echo "VPN_PORT=${OVPN_LISTEN_PORT}"
        echo "VPN_CLIENT_NAME=${SPRW_OVPN_CLIENT_NAME}"
        echo "VPN_DNS_SRV1=${DNS1}"
        echo "VPN_DNS_SRV2=${DNS2}"
        echo "VPN_DISABLE_USAGE_COUNTS=1"
        if [ "$ENDPOINT_IS_IP" -eq 1 ]; then
            echo "VPN_PUBLIC_IP=${SPRW_OVPN_ENDPOINT}"
        else
            echo "VPN_DNS_NAME=${SPRW_OVPN_ENDPOINT}"
        fi
    } > "$SPRW__DATA_DIR/secrets/vpn.env"
    chmod 600 "$SPRW__DATA_DIR/secrets/vpn.env"
    echo "Wrote secrets/vpn.env (no keys; first-start PKI stays in data/)."
else
    echo "Keeping existing secrets/vpn.env (not overwritten)."
fi

# ---------------------------------------------------------------------------
# 9. Host firewall: UDP listen port only. Never open or change ufw for 443.
# ---------------------------------------------------------------------------
if [ "$SPRW_OVPN_TRANSPORT" = "udp1194" ]; then
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        if ! ufw status | grep -qE "^${SPRW_OVPN_PORT}/udp[[:space:]]+ALLOW"; then
            ufw allow "${SPRW_OVPN_PORT}/udp" comment "OpenVPN ${SPRW__STACKNAME}" >/dev/null
            echo "Opened ufw allow ${SPRW_OVPN_PORT}/udp."
        else
            echo "ufw already allows ${SPRW_OVPN_PORT}/udp."
        fi
    fi
fi

echo "✅ Host preparation done for ${SPRW__STACKNAME}"
echo "📁 Data: ${SPRW__DATA_DIR}"
echo "🌐 Client subnet: ${SPRW_OVPN_IPV4_CIDR} (index ${SPRW_OVPN_SUBNET_INDEX})"
if [ "$SPRW_OVPN_TRANSPORT" = "udp1194" ]; then
    echo "🔌 Transport: UDP ${SPRW_OVPN_PORT} on the host"
else
    echo "🔌 Transport: TCP 443 in the container, host 127.0.0.1:${SPRW_OVPN_BACKEND_PORT} only"
    echo "   Public 443 / sslh / Traefik were not changed."
fi
echo "🧭 Clients reach: this customer's network ${CUSTOMER_NET} (${CUSTOMER_CIDR}) and the VPN subnet (split-tunnel)."
echo "🔒 After deploy: ovpnadmin.sh add-client <name>  and  ovpnadmin.sh export-client <name> <dir>"
echo "   The image also creates a first client named ${SPRW_OVPN_CLIENT_NAME}; export or revoke it on purpose. Configs are never printed."
