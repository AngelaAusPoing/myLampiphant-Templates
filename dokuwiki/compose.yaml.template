# myLampiphant app "dokuwiki" - compose template
# File-based wiki (no database). Multi-instance: dokuwiki_d_<domain_normalized>.
# Image: lscr.io/linuxserver/dokuwiki (multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/dokuwiki/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   DOKUWIKI_AUTH:   plain | ldap
#   DOKUWIKI_ACCESS: open  | closed
services:
  dokuwiki:
    image: ${DOKUWIKI_IMAGE:-lscr.io/linuxserver/dokuwiki:latest}
    container_name: !!STACKNAME!!
    hostname: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: ${DOKUWIKI_MEM_LIMIT:-256m}
    environment:
      - PUID=${PUID:-1000}
      - PGID=${PGID:-1000}
      - TZ=${TIMEZONE:-Europe/Berlin}
      - DOKUWIKI_AUTH=${DOKUWIKI_AUTH:-plain}
      - DOKUWIKI_ACCESS=${DOKUWIKI_ACCESS:-open}
      - LDAP_SERVER=${LDAP_SERVER:-ldap://ldap:389}
      - LDAP_BIND_DN=${LDAP_BIND_DN:-cn=readonly,ou=system,dc=lampiphant,dc=de}
      - LDAP_USER_TREE=${LDAP_USER_TREE:-}
      - LDAP_GROUP_TREE=${LDAP_GROUP_TREE:-}
      - LDAP_ADMIN_GROUP=${LDAP_ADMIN_GROUP:-wiki-admin}
    networks:
      - proxy-shared
      - customer-net
      {%- if DOKUWIKI_AUTH == "ldap" %}
      - ldap-shared
      {%- endif %}
    volumes:
    {%- if VOLUME_MODE == "bind" %}
      - !!DATA_DIR!!/config:/config
    {%- elif VOLUME_MODE == "named_bind" %}
      - !!STACKNAME!!_config:/config
    {%- elif VOLUME_MODE == "managed" %}
      - !!STACKNAME!!_config:/config
    {%- endif %}
      - !!DATA_DIR!!/custom-cont-init.d:/custom-cont-init.d:ro
    {%- if DOKUWIKI_AUTH == "ldap" %}
      # Host read-only bind secret (same account as the mailserver).
      # The start script copies it to a php-readable path; this file is never
      # written into Komodo .env or into local.protected.php.
      - !!LDAP_BIND_PW_FILE!!:/run/secrets/ldap-readonly-host.pw:ro
    {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "pidof nginx >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 40s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if AUTH_PROTECT == "true" and EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=authelia@docker,iprestrict@file"
      {%- elif AUTH_PROTECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=authelia@docker"
      {%- elif EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=iprestrict@file"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.middlewares.iprestrict.ipallowlist.sourcerange=10.8.0.0/24,192.168.0.0/16,172.16.0.0/12,127.0.0.1/32"
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=80"
      - "traefik.docker.network=proxy-shared"
      {%- if DOKUWIKI_AUTH == "plain" %}
      - "mylampiphant.dokuwiki.auth=plain"
      {%- elif DOKUWIKI_AUTH == "ldap" %}
      - "mylampiphant.dokuwiki.auth=ldap"
      {%- endif %}
      {%- if DOKUWIKI_ACCESS == "open" %}
      - "mylampiphant.dokuwiki.access=open"
      {%- elif DOKUWIKI_ACCESS == "closed" %}
      - "mylampiphant.dokuwiki.access=closed"
      {%- endif %}

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_config:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/config
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_config:
{%- endif %}

networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_!!CUSTOMER!!-net
  {%- if DOKUWIKI_AUTH == "ldap" %}
  ldap-shared:
    external: true
    name: ldap-shared
  {%- endif %}
