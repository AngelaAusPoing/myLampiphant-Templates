{%- elif SPRW_POSTIZ_PROVIDER_NOSTR == "false" %}
hide "Nostr" "nostr" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_MEDIUM == "true" %}
offer "Medium" "medium"
{%- elif SPRW_POSTIZ_PROVIDER_MEDIUM == "false" %}
hide "Medium" "medium" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_DEVTO == "true" %}
offer "Dev.to" "devto"
{%- elif SPRW_POSTIZ_PROVIDER_DEVTO == "false" %}
