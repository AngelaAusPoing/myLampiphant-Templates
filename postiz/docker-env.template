# === Stack variables (SPRW__*) ===
# This file is sent to Komodo as the stack .env. Generated secrets and the API
# keys from the persistent config belong here and must not be committed.
SPRW__CUSTOMER=!!CUSTOMER!!
SPRW__APPDOMAIN=!!APPDOMAIN!!
SPRW__STACKNAME=!!STACKNAME!!

# === Images and limits (defaults; override in persistent config) ===
SPRW_POSTIZ_IMAGE=ghcr.io/gitroomhq/postiz-app:v2.26.0
SPRW_POSTIZ_DB_IMAGE=postgres:17.12-alpine
SPRW_POSTIZ_REDIS_IMAGE=valkey/valkey:9.0.7-alpine
SPRW_POSTIZ_TEMPORAL_IMAGE=temporalio/auto-setup:1.28.1
SPRW_POSTIZ_MEM_LIMIT=1536m
SPRW_POSTIZ_CPUS=1.5
SPRW_POSTIZ_DB_MEM_LIMIT=256m
SPRW_POSTIZ_REDIS_MEM_LIMIT=64m
SPRW_POSTIZ_TEMPORAL_MEM_LIMIT=512m
SPRW_POSTIZ_TIMEZONE=Europe/Berlin
SPRW_POSTIZ_INTERNAL_SOURCERANGE=!!INTERNAL_SOURCERANGE!!

# === Database and app secret ===
SPRW_POSTIZ_DB_NAME=postiz
SPRW_POSTIZ_DB_USER=postiz
SPRW_POSTIZ_DB_PASSWORD=!!DB_PASSWORD!!
SPRW_POSTIZ_JWT_SECRET=!!JWT_SECRET!!

# === Social networks ===
# The developer-app keys are NOT sent to Komodo: pre-deploy.sh writes them from the
# persistent config to <data_dir>/secrets/providers.env (env_file of the postiz service).

# === Generic OIDC login (only used with SPRW_POSTIZ_OIDC=true) ===
SPRW_POSTIZ_OIDC_DISPLAY_NAME=!!OIDC_DISPLAY_NAME!!
SPRW_POSTIZ_OIDC_URL=!!OIDC_URL!!
SPRW_POSTIZ_OIDC_AUTH_URL=!!OIDC_AUTH_URL!!
SPRW_POSTIZ_OIDC_TOKEN_URL=!!OIDC_TOKEN_URL!!
SPRW_POSTIZ_OIDC_USERINFO_URL=!!OIDC_USERINFO_URL!!
SPRW_POSTIZ_OIDC_CLIENT_ID=!!OIDC_CLIENT_ID!!
SPRW_POSTIZ_OIDC_CLIENT_SECRET=!!OIDC_CLIENT_SECRET!!
