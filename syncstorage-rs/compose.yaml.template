# App "syncstorage-rs" - compose template
# Mozilla Firefox Sync server (syncstorage + tokenserver), PostgreSQL backend.
# One stack per customer: syncstorage-rs_c_<customer>.
#
# ARM64: Mozilla publishes linux/amd64 images only. Komodo builds the image from
# the pinned upstream git tag with the upstream Dockerfile (PostgreSQL build args).
# The first deploy therefore takes 30-60 minutes and needs about 2-3 GB free RAM.
#
# Firefox clients: identity.sync.tokenserver.uri =
#   PATH_PROTECT=true:  https://!!APPDOMAIN!!/<ACCESS_PATH>/1.0/sync/1.5
#   PATH_PROTECT=false: https://!!APPDOMAIN!!/1.0/sync/1.5
#
# Generated by app.sh from _templates_/syncstorage-rs/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   VOLUME_MODE:     bind | named_bind | managed  (PostgreSQL data)
#   EXTERNAL_ACCESS: true | false  (false = only IPALLOW_RANGES; Firefox must then sync via VPN/LAN)
#   PATH_PROTECT:    true | false  (true = the tokenserver is only reachable under a secret
#                    path /<ACCESS_PATH>/1.0/; without it nobody gets a sync token. Storage
#                    requests (/1.5/...) need such a token (Hawk), so they stay at /1.5/.)
#   ALLOW_NEW_USERS: true | false  (false = only Mozilla accounts that already synced here;
#                    set to false after all users of the customer have signed in once)
#
# Firefox and Brave send their own Authorization header (Bearer/Hawk) and no cookies,
# so Authelia/LDAP or basic auth in front of the sync API would break every client.
services:
  syncserver:
    build:
      context: !!SYNCSTORAGE_REPO!!#!!SYNCSTORAGE_VERSION!!
      dockerfile: Dockerfile
      args:
        SYNCSTORAGE_DATABASE_BACKEND: postgres
        TOKENSERVER_DATABASE_BACKEND: postgres
    image: syncstorage-rs-local:!!SYNCSTORAGE_VERSION!!-postgres
    pull_policy: never
    container_name: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!SYNCSTORAGE_MEM_LIMIT!!
    env_file:
      - !!DATA_DIR!!/secrets/syncserver.env
    environment:
      - TZ=!!TIMEZONE!!
      - RUST_LOG=!!LOG_LEVEL!!
      - SYNC_HOST=0.0.0.0
      - SYNC_PORT=8000
      - SYNC_HUMAN_LOGS=false
      - SYNC_TOKENSERVER__ENABLED=true
      - SYNC_TOKENSERVER__NODE_TYPE=postgres
      - SYNC_TOKENSERVER__RUN_MIGRATIONS=true
      - SYNC_TOKENSERVER__FXA_EMAIL_DOMAIN=api.accounts.firefox.com
      - SYNC_TOKENSERVER__FXA_OAUTH_SERVER_URL=https://oauth.accounts.firefox.com
      - SYNC_TOKENSERVER__INIT_NODE_URL=https://!!APPDOMAIN!!
      {%- if ALLOW_NEW_USERS == "true" %}
      - SYNC_TOKENSERVER__ALLOW_NEW_USERS=true
      {%- elif ALLOW_NEW_USERS == "false" %}
      - SYNC_TOKENSERVER__ALLOW_NEW_USERS=false
      {%- endif %}
      - SYNC_SYNCSTORAGE__DATABASE_POOL_MAX_SIZE=5
      - SYNC_WORKER_MAX_BLOCKING_THREADS=16
    networks:
      - proxy-shared
      - customer-net
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:8000/__heartbeat__"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    labels:
      - "traefik.enable=true"
      {%- if PATH_PROTECT == "true" %}
      # Tokenserver only under the secret path (prefix stripped before the app sees it).
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`) && PathPrefix(`/!!ACCESS_PATH!!/1.0/`)"
      - "traefik.http.middlewares.!!STACKNAME!!-strip.stripprefix.prefixes=/!!ACCESS_PATH!!"
      # Storage API: every request is Hawk-signed with a token from the tokenserver.
      - "traefik.http.routers.!!STACKNAME!!-storage.rule=Host(`!!APPDOMAIN!!`) && PathPrefix(`/1.5/`)"
      - "traefik.http.routers.!!STACKNAME!!-storage.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!-storage.tls=true"
      - "traefik.http.routers.!!STACKNAME!!-storage.service=!!STACKNAME!!"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!-storage.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!-storage.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!-storage.middlewares=!!STACKNAME!!-ipallow"
      {%- endif %}
      {%- elif PATH_PROTECT == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      {%- endif %}
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      - "traefik.http.routers.!!STACKNAME!!.service=!!STACKNAME!!"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.middlewares.!!STACKNAME!!-ipallow.ipallowlist.sourcerange=!!IPALLOW_RANGES!!"
      {%- endif %}
      {%- if PATH_PROTECT == "true" and EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow,!!STACKNAME!!-strip"
      {%- elif PATH_PROTECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-strip"
      {%- elif EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow"
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8000"
      - "traefik.docker.network=proxy-shared"

  db:
    image: !!DB_IMAGE!!
    container_name: !!STACKNAME!!-db
    restart: unless-stopped
    mem_limit: !!DB_MEM_LIMIT!!
    env_file:
      - !!DATA_DIR!!/secrets/db.env
    environment:
      - TZ=!!TIMEZONE!!
      - POSTGRES_DB=!!DB_NAME!!
      - POSTGRES_USER=!!DB_USER!!
    command: ["postgres", "-c", "shared_buffers=48MB", "-c", "max_connections=30", "-c", "work_mem=4MB"]
    networks:
      - customer-net
    volumes:
    {%- if VOLUME_MODE == "bind" %}
      - !!DATA_DIR!!/db:/var/lib/postgresql
    {%- elif VOLUME_MODE == "named_bind" %}
      - !!STACKNAME!!_db:/var/lib/postgresql
    {%- elif VOLUME_MODE == "managed" %}
      - !!STACKNAME!!_db:/var/lib/postgresql
    {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U !!DB_USER!! -d !!DB_NAME!!"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_db:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/db
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_db:
{%- endif %}

# customer-net: syncserver + db; proxy-shared: Traefik and syncserver only.
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_!!CUSTOMER!!-net
