#!/bin/bash
# Prepare host directories, secrets and Authelia configuration.yml.
# Idempotent: existing secret files are never overwritten. Secrets are never printed.
# Generated by app.sh from _templates_/authelia/install.sh.template.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"
SPRW_AUTHELIA_STORAGE_MODE="!!STORAGE_MODE!!"
SPRW_AUTHELIA_NOTIFIER="!!NOTIFIER!!"
SPRW_AUTHELIA_COOKIE_DOMAINS="!!COOKIE_DOMAINS!!"
SPRW_AUTHELIA_AUTH_HOSTS="!!AUTH_HOSTS!!"
SPRW_AUTHELIA_DEFAULT_REDIRECTION_URL="!!DEFAULT_REDIRECTION_URL!!"
SPRW_AUTHELIA_DEFAULT_POLICY="!!DEFAULT_POLICY!!"
SPRW_AUTHELIA_TOTP_ISSUER="!!TOTP_ISSUER!!"
SPRW_AUTHELIA_LDAP_SERVER_HOST="!!LDAP_SERVER_HOST!!"
SPRW_AUTHELIA_LDAP_BASE_DN="!!LDAP_BASE_DN!!"
SPRW_AUTHELIA_LDAP_BIND_DN="!!LDAP_BIND_DN!!"
SPRW_AUTHELIA_LDAP_USERNAME_ATTRIBUTE="!!LDAP_USERNAME_ATTRIBUTE!!"
SPRW_AUTHELIA_SMTP_HOST="!!SMTP_HOST!!"
SPRW_AUTHELIA_SMTP_PORT="!!SMTP_PORT!!"
SPRW_AUTHELIA_SMTP_USER="!!SMTP_USER!!"
SPRW_AUTHELIA_SMTP_SENDER="!!SMTP_SENDER!!"
SPRW_AUTHELIA_SMTP_IDENTIFIER="!!SMTP_IDENTIFIER!!"
TEMPLATE_DIR="/opt/docker/_templates_/authelia"
CONFIG_FILE="$(dirname "$SPRW__DATA_DIR")/_config_/${SPRW__STACKNAME}.env"
LDAP_READONLY_PW_SRC="/opt/docker-data/_host_/ldap/secrets/readonly.pw"

echo "Preparing authelia ${SPRW__STACKNAME} (portal ${SPRW__APPDOMAIN})..."

missing=0
for v in SPRW__STACKNAME SPRW__DATA_DIR SPRW__COMPOSE_DIR SPRW__APPDOMAIN \
         SPRW_AUTHELIA_STORAGE_MODE SPRW_AUTHELIA_NOTIFIER SPRW_AUTHELIA_COOKIE_DOMAINS \
         SPRW_AUTHELIA_AUTH_HOSTS SPRW_AUTHELIA_DEFAULT_POLICY SPRW_AUTHELIA_TOTP_ISSUER \
         SPRW_AUTHELIA_LDAP_SERVER_HOST SPRW_AUTHELIA_LDAP_BASE_DN SPRW_AUTHELIA_LDAP_BIND_DN \
         SPRW_AUTHELIA_LDAP_USERNAME_ATTRIBUTE; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in the persistent config or pass --var." >&2
        missing=1
    fi
done
if [ "$missing" -ne 0 ]; then
    echo "Review the persistent config (${CONFIG_FILE}) and run app.sh again." >&2
    exit 1
fi

case "$SPRW_AUTHELIA_STORAGE_MODE" in
    sqlite|redis) ;;
    *) echo "ERROR: STORAGE_MODE must be sqlite or redis (got: ${SPRW_AUTHELIA_STORAGE_MODE})" >&2; exit 1 ;;
esac
case "$SPRW_AUTHELIA_NOTIFIER" in
    filesystem|smtp) ;;
    *) echo "ERROR: NOTIFIER must be filesystem or smtp (got: ${SPRW_AUTHELIA_NOTIFIER})" >&2; exit 1 ;;
esac
case "$SPRW_AUTHELIA_DEFAULT_POLICY" in
    one_factor|two_factor) ;;
    *) echo "ERROR: DEFAULT_POLICY must be one_factor or two_factor (got: ${SPRW_AUTHELIA_DEFAULT_POLICY})" >&2; exit 1 ;;
esac

if [ ! -f "$LDAP_READONLY_PW_SRC" ]; then
    echo "ERROR: LDAP read-only bind password not found at ${LDAP_READONLY_PW_SRC}." >&2
    echo "Install the host ldap stack first: app.sh ldap add _host_  (if it is not already installed)." >&2
    exit 1
fi

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}

# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_shared_networks

mkdir -p "$SPRW__COMPOSE_DIR"
mkdir -p "$SPRW__DATA_DIR/config" "$SPRW__DATA_DIR/secrets"
chmod 700 "$SPRW__DATA_DIR/secrets" "$SPRW__DATA_DIR/config"

# ---------------------------------------------------------------------------
# Secret files (created once, chmod 600, never printed, never sent to Komodo)
# ---------------------------------------------------------------------------
JWT_SECRET=$(read_cfg SPRW_AUTHELIA_JWT_SECRET)
SESSION_SECRET=$(read_cfg SPRW_AUTHELIA_SESSION_SECRET)
STORAGE_KEY=$(read_cfg SPRW_AUTHELIA_STORAGE_ENCRYPTION_KEY)
if [ -z "$JWT_SECRET" ] || [[ "$JWT_SECRET" == *'!!'* ]] \
   || [ -z "$SESSION_SECRET" ] || [[ "$SESSION_SECRET" == *'!!'* ]] \
   || [ -z "$STORAGE_KEY" ] || [[ "$STORAGE_KEY" == *'!!'* ]]; then
    echo "ERROR: Authelia secrets missing in ${CONFIG_FILE}" >&2
    unset JWT_SECRET SESSION_SECRET STORAGE_KEY
    exit 1
fi

write_secret_once() {
    local dest="$1" value="$2"
    if [ ! -f "$dest" ]; then
        umask 077
        printf '%s' "$value" > "$dest"
        chmod 600 "$dest"
    fi
}

write_secret_once "$SPRW__DATA_DIR/secrets/jwt.secret" "$JWT_SECRET"
write_secret_once "$SPRW__DATA_DIR/secrets/session.secret" "$SESSION_SECRET"
write_secret_once "$SPRW__DATA_DIR/secrets/storage.secret" "$STORAGE_KEY"
unset JWT_SECRET SESSION_SECRET STORAGE_KEY

# LDAP read-only bind: copy from the host ldap stack once (same pattern as mailserver).
if [ ! -f "$SPRW__DATA_DIR/secrets/ldap-bind.pw" ]; then
    cp -a "$LDAP_READONLY_PW_SRC" "$SPRW__DATA_DIR/secrets/ldap-bind.pw"
    chmod 600 "$SPRW__DATA_DIR/secrets/ldap-bind.pw"
fi

if [ "$SPRW_AUTHELIA_NOTIFIER" = "smtp" ]; then
    SMTP_PW=$(read_cfg SPRW_AUTHELIA_SMTP_PASSWORD)
    if [ -z "${SPRW_AUTHELIA_SMTP_USER:-}" ] || [[ "${SPRW_AUTHELIA_SMTP_USER}" == *'!!'* ]]; then
        echo "ERROR: NOTIFIER=smtp but SMTP_USER is not set in ${CONFIG_FILE}" >&2
        unset SMTP_PW
        exit 1
    fi
    if [ -z "$SMTP_PW" ] || [[ "$SMTP_PW" == *'!!'* ]]; then
        echo "ERROR: NOTIFIER=smtp but SMTP_PASSWORD is not set in ${CONFIG_FILE}" >&2
        echo "Use an existing mailbox; do not invent credentials." >&2
        unset SMTP_PW
        exit 1
    fi
    write_secret_once "$SPRW__DATA_DIR/secrets/smtp.pw" "$SMTP_PW"
    unset SMTP_PW
fi

# ---------------------------------------------------------------------------
# configuration.yml (regenerated each install/redeploy; sqlite DB is kept)
# ---------------------------------------------------------------------------
export APPDOMAIN="$SPRW__APPDOMAIN"
export COOKIE_DOMAINS="$SPRW_AUTHELIA_COOKIE_DOMAINS"
export AUTH_HOSTS="$SPRW_AUTHELIA_AUTH_HOSTS"
export DEFAULT_REDIRECTION_URL="${SPRW_AUTHELIA_DEFAULT_REDIRECTION_URL:-}"
export DEFAULT_POLICY="$SPRW_AUTHELIA_DEFAULT_POLICY"
export TOTP_ISSUER="$SPRW_AUTHELIA_TOTP_ISSUER"
export LDAP_SERVER_HOST="$SPRW_AUTHELIA_LDAP_SERVER_HOST"
export LDAP_BASE_DN="$SPRW_AUTHELIA_LDAP_BASE_DN"
export LDAP_BIND_DN="$SPRW_AUTHELIA_LDAP_BIND_DN"
export LDAP_USERNAME_ATTRIBUTE="$SPRW_AUTHELIA_LDAP_USERNAME_ATTRIBUTE"
export STORAGE_MODE="$SPRW_AUTHELIA_STORAGE_MODE"
export NOTIFIER="$SPRW_AUTHELIA_NOTIFIER"
export SMTP_HOST="${SPRW_AUTHELIA_SMTP_HOST:-}"
export SMTP_PORT="${SPRW_AUTHELIA_SMTP_PORT:-587}"
export SMTP_USER="${SPRW_AUTHELIA_SMTP_USER:-}"
export SMTP_SENDER="${SPRW_AUTHELIA_SMTP_SENDER:-}"
export SMTP_IDENTIFIER="${SPRW_AUTHELIA_SMTP_IDENTIFIER:-}"

python3 - "$TEMPLATE_DIR/configuration.yml.src" "$SPRW__DATA_DIR/config/configuration.yml" <<'PY'
import os
import sys
from pathlib import Path
from urllib.parse import urlparse

src_path, dest_path = Path(sys.argv[1]), Path(sys.argv[2])
text = src_path.read_text(encoding="utf-8")

def split_csv(value):
    items = []
    for part in (value or "").split(","):
        item = part.strip()
        if item and item not in items:
            items.append(item)
    return items

def yaml_escape(value):
    return (value or "").replace("'", "''")

cookie_domains = split_csv(os.environ["COOKIE_DOMAINS"])
auth_hosts = split_csv(os.environ["AUTH_HOSTS"])
appdomain = os.environ["APPDOMAIN"]
policy = os.environ["DEFAULT_POLICY"]
redir = os.environ.get("DEFAULT_REDIRECTION_URL", "").strip()
if redir.startswith("!!"):
    redir = ""

def authelia_url_for(domain):
    candidate = f"auth.{domain}"
    if candidate in auth_hosts:
        return f"https://{candidate}"
    if appdomain == domain or appdomain.endswith("." + domain):
        return f"https://{appdomain}"
    return f"https://{candidate}"

def redirection_for(domain):
    if not redir:
        return None
    host = urlparse(redir).hostname or ""
    if host == domain or host.endswith("." + domain):
        return redir
    return None

cookie_yaml = []
for domain in cookie_domains:
    cookie_yaml.append("    - name: 'authelia_session'")
    cookie_yaml.append(f"      domain: '{yaml_escape(domain)}'")
    cookie_yaml.append(f"      authelia_url: '{authelia_url_for(domain)}'")
    dest = redirection_for(domain)
    if dest:
        cookie_yaml.append(f"      default_redirection_url: '{yaml_escape(dest)}'")
if not cookie_yaml:
    sys.stderr.write("ERROR: COOKIE_DOMAINS produced no session cookie entries\n")
    sys.exit(1)

access = []
for host in auth_hosts:
    access.append(f"    - domain: '{yaml_escape(host)}'")
    access.append("      policy: 'bypass'")
for domain in cookie_domains:
    access.append("    - domain:")
    access.append(f"        - '{yaml_escape(domain)}'")
    access.append(f"        - '*.{yaml_escape(domain)}'")
    access.append(f"      policy: '{yaml_escape(policy)}'")

if os.environ["STORAGE_MODE"] == "redis":
    redis_block = (
        "  redis:\n"
        "    host: 'redis'\n"
        "    port: 6379\n"
        "    database_index: 0\n"
        "    timeout: '5 seconds'\n"
        "    max_retries: 3\n"
    )
else:
    redis_block = ""

if os.environ["NOTIFIER"] == "smtp":
    notifier = (
        "  smtp:\n"
        f"    address: 'smtp://{yaml_escape(os.environ['SMTP_HOST'])}:{yaml_escape(os.environ['SMTP_PORT'])}'\n"
        f"    username: '{yaml_escape(os.environ['SMTP_USER'])}'\n"
        f"    sender: '{yaml_escape(os.environ['SMTP_SENDER'])}'\n"
        f"    identifier: '{yaml_escape(os.environ['SMTP_IDENTIFIER'])}'\n"
        "    timeout: '10 seconds'\n"
        "    disable_require_tls: false\n"
    )
else:
    notifier = "  filesystem:\n    filename: '/config/notification.txt'\n"

replacements = {
    "@@TOTP_ISSUER@@": yaml_escape(os.environ["TOTP_ISSUER"]),
    "@@LDAP_SERVER_HOST@@": yaml_escape(os.environ["LDAP_SERVER_HOST"]),
    "@@LDAP_BASE_DN@@": yaml_escape(os.environ["LDAP_BASE_DN"]),
    "@@LDAP_BIND_DN@@": yaml_escape(os.environ["LDAP_BIND_DN"]),
    "@@LDAP_USERNAME_ATTRIBUTE@@": yaml_escape(os.environ["LDAP_USERNAME_ATTRIBUTE"]),
    "@@ACCESS_RULES@@": "\n".join(access),
    "@@COOKIES@@": "\n".join(cookie_yaml),
    "@@REDIS_BLOCK@@": redis_block,
    "@@NOTIFIER_BLOCK@@": notifier,
}
for token, value in replacements.items():
    text = text.replace(token, value)

dest_path.parent.mkdir(parents=True, exist_ok=True)
dest_path.write_text(text, encoding="utf-8")
PY

chmod 640 "$SPRW__DATA_DIR/config/configuration.yml"
# Official Authelia image runs as uid 1000. Keep secret files readable only by that user/root.
chown -R 1000:1000 "$SPRW__DATA_DIR/config"
chown 1000:1000 "$SPRW__DATA_DIR/secrets"/*.secret "$SPRW__DATA_DIR/secrets/ldap-bind.pw" 2>/dev/null || true
if [ -f "$SPRW__DATA_DIR/secrets/smtp.pw" ]; then
    chown 1000:1000 "$SPRW__DATA_DIR/secrets/smtp.pw"
fi
chmod 600 "$SPRW__DATA_DIR/secrets"/* 2>/dev/null || true

echo "Host preparation done for ${SPRW__STACKNAME}"
echo "Portal: https://${SPRW__APPDOMAIN}"
echo "Data: ${SPRW__DATA_DIR}"
echo "Other apps can opt in with AUTH_PROTECT=true (middleware authelia@docker)."
echo "LDAP password changes stay with ldapadmin.sh (read-only bind; Authelia reset is disabled)."
