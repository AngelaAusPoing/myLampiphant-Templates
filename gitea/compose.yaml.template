# App "gitea" - compose template
# Gitea (self-hosted Git) + MariaDB. Single instance per customer: gitea_c_<customer>.
#
# Generated by app.sh from _templates_/gitea/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  server:
    image: ${SPRW_GITEA_IMAGE:-gitea/gitea:latest}
    container_name: ${SPRW__STACKNAME:-gitea_c_customer_directory}
    restart: unless-stopped
    mem_limit: ${SPRW_GITEA_MEM_LIMIT:-512m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-gitea_c_customer_directory}/data:/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-gitea_c_customer_directory}_data:/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-gitea_c_customer_directory}_data:/data
    {%- endif %}
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    {%- if SPRW_GITEA_SSH_ENABLED == "true" %}
    ports:
      - "${SPRW_GITEA_SSH_PORT:-2222}:22"
    {%- endif %}
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__database__DB_TYPE=mysql
      - GITEA__database__HOST=db:3306
      - GITEA__database__NAME=${SPRW_GITEA_DB_NAME:-gitea}
      - GITEA__database__USER=${SPRW_GITEA_DB_USER:-gitea}
      - GITEA__database__PASSWD=${SPRW_GITEA_DB_PASSWORD}
      - GITEA__server__DOMAIN=${SPRW__APPDOMAIN}
      - GITEA__server__ROOT_URL=https://${SPRW__APPDOMAIN}
      - GITEA__server__HTTP_PORT=3000
      {%- if SPRW_GITEA_SSH_ENABLED == "true" %}
      - GITEA__server__SSH_PORT=${SPRW_GITEA_SSH_PORT:-2222}
      - GITEA__server__SSH_DOMAIN=${SPRW__APPDOMAIN}
      {%- elif SPRW_GITEA_SSH_ENABLED == "false" %}
      - GITEA__server__DISABLE_SSH=true
      {%- endif %}
      {%- if SPRW_GITEA_REGISTRATION == "closed" %}
      - GITEA__service__DISABLE_REGISTRATION=true
      {%- elif SPRW_GITEA_REGISTRATION == "open" %}
      - GITEA__service__DISABLE_REGISTRATION=false
      {%- endif %}
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://127.0.0.1:3000/api/healthz || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-gitea_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-gitea_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-gitea_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-gitea_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-gitea_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-gitea_c_customer_directory}.loadbalancer.server.port=3000"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Limit IP access (only VPN and internal networks)
      - "traefik.http.routers.${SPRW__STACKNAME:-gitea_c_customer_directory}.middlewares=iprestrict@file"
      {%- endif %}

  db:
    image: ${SPRW_GITEA_DB_IMAGE:-mariadb:11.4-noble}
    container_name: ${SPRW__STACKNAME:-gitea_c_customer_directory}_db
    restart: unless-stopped
    mem_limit: ${SPRW_GITEA_DB_MEM_LIMIT:-384m}
    networks:
      - customer-net
    command:
      - --innodb-buffer-pool-size=${SPRW_GITEA_INNODB_BUFFER_POOL:-128M}
      - --performance-schema=OFF
      - --skip-name-resolve
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-gitea_c_customer_directory}/mysql:/var/lib/mysql
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-gitea_c_customer_directory}_mysql:/var/lib/mysql
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-gitea_c_customer_directory}_mysql:/var/lib/mysql
    {%- endif %}
    environment:
      - MYSQL_ROOT_PASSWORD=${SPRW_GITEA_DB_ROOT_PASSWORD}
      - MYSQL_DATABASE=${SPRW_GITEA_DB_NAME:-gitea}
      - MYSQL_USER=${SPRW_GITEA_DB_USER:-gitea}
      - MYSQL_PASSWORD=${SPRW_GITEA_DB_PASSWORD}
      - TZ=${SPRW_GITEA_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-gitea_c_customer_directory}_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-gitea_c_customer_directory}/data

  ${SPRW__STACKNAME:-gitea_c_customer_directory}_mysql:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-gitea_c_customer_directory}/mysql
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-gitea_c_customer_directory}_data:
  ${SPRW__STACKNAME:-gitea_c_customer_directory}_mysql:
{%- endif %}

# ===================== Networks =====================
# customer-net: Gitea + MariaDB (created by ensure-networks.sh / app.sh if missing)
# proxy-shared: Traefik + web frontend only; the database stays off this network
{%- if SPRW__EXTERNAL_ACCESS == "true" %}
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- elif SPRW__EXTERNAL_ACCESS == "false" %}
# Container is accessible only internally, e.g. by LAN or VPN.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- endif %}
