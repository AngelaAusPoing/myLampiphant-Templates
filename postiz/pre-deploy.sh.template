#!/bin/bash
# pre-deploy.sh for the app "postiz" - generated by app.sh from
# _templates_/postiz/pre-deploy.sh.template - do not edit, edit the template.
#
# Runs on the host before Komodo deploys the stack (app.sh postiz install|add|redeploy,
# or "app.sh postiz pre-deploy <customer>"). It writes
#   <data_dir>/secrets/providers.env   (chmod 600, read by the postiz container)
# with the developer-app keys of the enabled social networks and HIDDEN_PROVIDERS,
# the list of networks Postiz must not offer:
#   - networks switched off with SPRW_POSTIZ_PROVIDER_<NAME>=false
#   - networks switched on whose keys are still empty in the persistent config
# The keys are read from the persistent config at runtime and are never printed;
# they do not go to Komodo. Networks without server keys (Bluesky, WordPress, ...)
# only need the switch: each user enters their own login when connecting.
set -euo pipefail

STACKNAME="!!STACKNAME!!"
DATA_DIR="!!DATA_DIR!!"
CONFIG_FILE="$(dirname "$DATA_DIR")/_config_/$STACKNAME.env"
OUT_DIR="$DATA_DIR/secrets"
OUT_FILE="$OUT_DIR/providers.env"
PREFIX="SPRW_POSTIZ_"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "ERROR: persistent config not found: $CONFIG_FILE" >&2
    exit 1
fi

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}
is_set() { [ -n "$1" ] && [[ "$1" != *'!!'* ]]; }

mkdir -p "$OUT_DIR"
chmod 700 "$OUT_DIR"
umask 077
TMP_FILE=$(mktemp "$OUT_DIR/.providers.env.XXXXXX")
trap 'rm -f "$TMP_FILE"' EXIT
HIDDEN=""
OFFERED=""

# write KEY='value' (single quotes: docker compose does not interpolate them)
emit() {
    local key="$1" val
    val=$(read_cfg "$PREFIX$key")
    if [[ "$val" == *"'"* ]]; then
        echo "ERROR: $PREFIX$key contains a single quote, which env files cannot hold." >&2
        exit 1
    fi
    printf "%s='%s'\n" "$key" "$val" >> "$TMP_FILE"
}
# have "KEY1 KEY2" [label]: all keys set? (marks the network as offered)
have() {
    local key
    for key in $1; do
        is_set "$(read_cfg "$PREFIX$key")" || return 1
    done
    OFFERED="$OFFERED, $2"
}
# offer NAME IDS [KEY...]: write the keys if all are set; return 1 if one is missing
offer() {
    local name="$1" ids="$2"; shift 2
    local key
    for key in "$@"; do
        is_set "$(read_cfg "$PREFIX$key")" || return 1
    done
    for key in "$@"; do emit "$key"; done
    OFFERED="$OFFERED, $name"
}
optional() {
    is_set "$(read_cfg "$PREFIX$1")" && emit "$1" || true
}
hide() {
    HIDDEN="$HIDDEN,$2"
    [ "$3" = "keys missing" ] && echo "  $1: switched on, but keys are missing in the config - hidden for now." || true
}

echo "Social networks for $STACKNAME:"
{%- if SPRW_POSTIZ_PROVIDER_X == "true" %}
offer "X" "x" X_API_KEY X_API_SECRET || hide "X" "x" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_X == "false" %}
hide "X" "x" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_LINKEDIN == "true" %}
