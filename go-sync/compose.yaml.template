# App "go-sync" - compose template
# Brave Sync Server v2 (Go) with DynamoDB Local as datastore and Redis as cache.
# One stack per customer: go-sync_c_<customer>.
#
# ARM64: Brave publishes no image. Komodo builds go-sync from the pinned upstream
# commit (git build context, upstream Dockerfile, target "artifact").
# DynamoDB Local, the AWS CLI (table init) and Redis are official multi-arch images.
#
# Brave clients: start Brave with --sync-url=https://!!APPDOMAIN!!/v2
#
# Generated by app.sh from _templates_/go-sync/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   VOLUME_MODE:     bind | named_bind | managed  (DynamoDB Local data)
#   EXTERNAL_ACCESS: true | false  (false = only IPALLOW_RANGES, e.g. VPN/LAN)
services:
  go-sync:
    build:
      context: !!GOSYNC_REPO!!#!!GOSYNC_VERSION!!
      dockerfile: Dockerfile
      target: artifact
      args:
        VERSION: !!GOSYNC_VERSION!!
        COMMIT: !!GOSYNC_VERSION!!
    image: go-sync-local:!!GOSYNC_VERSION!!
    pull_policy: never
    container_name: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!GOSYNC_MEM_LIMIT!!
    environment:
      - TZ=!!TIMEZONE!!
      # DynamoDB Local ignores the key values, but the AWS SDK requires them.
      - AWS_ACCESS_KEY_ID=GOSYNC
      - AWS_SECRET_ACCESS_KEY=GOSYNC
      - AWS_REGION=us-west-2
      - AWS_ENDPOINT=http://dynamodb:8000
      - TABLE_NAME=!!TABLE_NAME!!
      # Standalone Redis (ENV must stay empty or "local"; anything else selects Redis cluster mode)
      - REDIS_URL=redis:6379
      - PPROF_ENABLED=false
    networks:
      - proxy-shared
      - backend
    depends_on:
      dynamodb-init:
        condition: service_completed_successfully
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8295/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.middlewares.!!STACKNAME!!-ipallow.ipallowlist.sourcerange=!!IPALLOW_RANGES!!"
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow"
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8295"
      - "traefik.docker.network=proxy-shared"

  # One-shot: make the data volume writable for dynamodblocal (uid 1000) in every VOLUME_MODE
  # (a fresh managed volume would otherwise be owned by root).
  dynamodb-perms:
    image: !!DYNAMODB_IMAGE!!
    container_name: !!STACKNAME!!-dynamodb-perms
    restart: "no"
    mem_limit: 32m
    user: "0:0"
    entrypoint: ["/bin/sh", "-c", "chown -R 1000:1000 /home/dynamodblocal/data"]
    network_mode: none
    volumes:
    {%- if VOLUME_MODE == "bind" %}
      - !!DATA_DIR!!/dynamodb:/home/dynamodblocal/data
    {%- elif VOLUME_MODE == "named_bind" %}
      - !!STACKNAME!!_dynamodb:/home/dynamodblocal/data
    {%- elif VOLUME_MODE == "managed" %}
      - !!STACKNAME!!_dynamodb:/home/dynamodblocal/data
    {%- endif %}

  dynamodb:
    image: !!DYNAMODB_IMAGE!!
    container_name: !!STACKNAME!!-dynamodb
    restart: unless-stopped
    mem_limit: !!DYNAMODB_MEM_LIMIT!!
    user: "1000:1000"
    working_dir: /home/dynamodblocal
    command: ["-Xmx!!DYNAMODB_HEAP!!m", "-XX:+UseSerialGC", "-jar", "DynamoDBLocal.jar", "-sharedDb", "-dbPath", "/home/dynamodblocal/data"]
    environment:
      - TZ=!!TIMEZONE!!
    networks:
      - backend
    volumes:
    {%- if VOLUME_MODE == "bind" %}
      - !!DATA_DIR!!/dynamodb:/home/dynamodblocal/data
    {%- elif VOLUME_MODE == "named_bind" %}
      - !!STACKNAME!!_dynamodb:/home/dynamodblocal/data
    {%- elif VOLUME_MODE == "managed" %}
      - !!STACKNAME!!_dynamodb:/home/dynamodblocal/data
    {%- endif %}
    depends_on:
      dynamodb-perms:
        condition: service_completed_successfully

  dynamodb-init:
    image: !!AWSCLI_IMAGE!!
    container_name: !!STACKNAME!!-dynamodb-init
    restart: "no"
    mem_limit: 128m
    entrypoint: ["/bin/sh", "/init/dynamodb-init.sh"]
    environment:
      - AWS_ACCESS_KEY_ID=GOSYNC
      - AWS_SECRET_ACCESS_KEY=GOSYNC
      - AWS_REGION=us-west-2
      - AWS_ENDPOINT=http://dynamodb:8000
      - TABLE_NAME=!!TABLE_NAME!!
    volumes:
      - !!COMPOSE_DIR!!/init:/init:ro
    networks:
      - backend
    depends_on:
      - dynamodb

  redis:
    image: !!REDIS_IMAGE!!
    container_name: !!STACKNAME!!-redis
    restart: unless-stopped
    mem_limit: !!REDIS_MEM_LIMIT!!
    # Cache only: no persistence, bounded memory.
    command: ["redis-server", "--save", "", "--appendonly", "no", "--maxmemory", "48mb", "--maxmemory-policy", "allkeys-lru"]
    networks:
      - backend
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_dynamodb:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/dynamodb
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_dynamodb:
{%- endif %}

# backend: stack-internal, no internet (go-sync, DynamoDB Local, Redis, init).
# proxy-shared: Traefik and go-sync only.
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  backend:
    internal: true
