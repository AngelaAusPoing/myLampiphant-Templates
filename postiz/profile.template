SPRW_POSTIZ_PROVIDER_MASTODON='!!PROVIDER_MASTODON!!'        # Mastodon: true | false
SPRW_POSTIZ_PROVIDER_TUMBLR='!!PROVIDER_TUMBLR!!'            # Tumblr: true | false
SPRW_POSTIZ_PROVIDER_TELEGRAM='!!PROVIDER_TELEGRAM!!'        # Telegram: true | false
SPRW_POSTIZ_PROVIDER_VK='!!PROVIDER_VK!!'                    # VK: true | false
SPRW_POSTIZ_PROVIDER_WHOP='!!PROVIDER_WHOP!!'                # Whop: true | false
