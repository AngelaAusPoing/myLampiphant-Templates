#!/bin/bash
# ldapadmin.sh - admin helper for the app "ldap" (stack !!STACKNAME!!)
# Generated by app.sh from _templates_/ldap/ldapadmin.sh.template.
# Talks to the running OpenLDAP container (docker exec). Secrets are never printed.
#
# Usage:
#   ldapadmin.sh add-customer <customer>     create o=<customer> + ou=people/groups/aliases + customer admin
#   ldapadmin.sh add-user <customer> <uid> [email]
#   ldapadmin.sh set-password <customer> <uid>
#   ldapadmin.sh add-alias <customer> <alias-address> <target-mailbox>
#   ldapadmin.sh list [customer]
#   ldapadmin.sh export [file]               LDIF dump of the whole tree (or one customer)
#   ldapadmin.sh import-ldif <file>          ldapadd -c (continue on exist)
set -euo pipefail

CONTAINER="!!STACKNAME!!"
DATA_DIR="!!DATA_DIR!!"
CONFIG_FILE="$(dirname "$DATA_DIR")/_config_/${CONTAINER}.env"
BASE_DN="!!LDAP_BASE_DN!!"
ROOT_DN="!!LDAP_ROOT_DN!!"

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}

need_container() {
    if ! docker inspect -f '{% raw %}{{.State.Running}}{% endraw %}' "$CONTAINER" 2>/dev/null | grep -qx true; then
        echo "ERROR: container ${CONTAINER} is not running" >&2
        exit 1
    fi
}

# Write the root password into a root-only temp file inside the container and bind with -y.
# Avoids putting the password on the command line (ps, logs).
install_bind_pw() {
    local pw
    pw=$(read_cfg SPRW_LDAP_ROOT_PASSWORD)
    if [ -z "$pw" ] || [[ "$pw" == *'!!'* ]]; then
        echo "ERROR: SPRW_LDAP_ROOT_PASSWORD missing in ${CONFIG_FILE}" >&2
        exit 1
    fi
    printf '%s' "$pw" | docker exec -i "$CONTAINER" sh -c 'umask 077; cat > /tmp/.ldap-admin-pw'
    unset pw
}
clear_bind_pw() {
    docker exec "$CONTAINER" rm -f /tmp/.ldap-admin-pw >/dev/null 2>&1 || true
}
with_bind() {
    # usage: with_bind ldapadd|ldapmodify|ldapsearch|ldappasswd -- extra args
    install_bind_pw
    set +e
    docker exec -i "$CONTAINER" "$@"
    local st=$?
    set -e
    clear_bind_pw
    return $st
}

ldap_add()    { with_bind ldapadd    -x -H ldapi:/// -D "$ROOT_DN" -y /tmp/.ldap-admin-pw "$@"; }
ldap_modify() { with_bind ldapmodify -x -H ldapi:/// -D "$ROOT_DN" -y /tmp/.ldap-admin-pw "$@"; }
ldap_search() { with_bind ldapsearch -x -H ldapi:/// -D "$ROOT_DN" -y /tmp/.ldap-admin-pw -LLL -o ldif-wrap=no "$@"; }
ldap_passwd() { with_bind ldappasswd -x -H ldapi:/// -D "$ROOT_DN" -y /tmp/.ldap-admin-pw "$@"; }

ldif_escape() {
    # Escape a value for unsafe LDIF (leading space, colon, < or non-ascii -> base64)
    python3 -c 'import sys
v=sys.argv[1]
if not v or v[0] in " :<" or v[-1]==" " or any(ord(c)>127 or c in "\r\n" for c in v):
    import base64; print(":: "+base64.b64encode(v.encode()).decode())
else:
    print(": "+v)
' "$1"
}

customer_dn() {
    echo "o=$1,${BASE_DN}"
}

store_customer_secret() {
    local customer="$1" bind_dn="$2" pw="$3"
    local host_file="${DATA_DIR}/secrets/customers/${customer}.env"
    local cust_dir="/opt/docker-data/${customer}/_config_"
    mkdir -p "$(dirname "$host_file")"
    umask 077
    cat > "$host_file" <<ENV
LDAP_BASE_DN=${BASE_DN}
LDAP_CUSTOMER_DN=o=${customer},${BASE_DN}
LDAP_BIND_DN=${bind_dn}
LDAP_BIND_PASSWORD=${pw}
ENV
    chmod 600 "$host_file"
    if mkdir -p "$cust_dir" 2>/dev/null; then
        cp -a "$host_file" "${cust_dir}/ldap.env"
        chmod 600 "${cust_dir}/ldap.env"
    fi
}

case "${1:-}" in
    add-customer)
        need_container
        customer="${2:?usage: $0 add-customer <customer>}"
        cdn=$(customer_dn "$customer")
        admin_dn="cn=admin,${cdn}"
        if ldap_search -b "$cdn" -s base '(objectClass=*)' dn >/dev/null 2>&1; then
            echo "Customer branch ${cdn} already exists"
        else
            admin_pw=$(openssl rand -base64 24 | tr -d '/=+')
            ldap_add <<LDIF
dn: ${cdn}
objectClass: top
objectClass: organization
o: ${customer}
description: Customer ${customer}

dn: ou=people,${cdn}
objectClass: top
objectClass: organizationalUnit
ou: people

dn: ou=groups,${cdn}
objectClass: top
objectClass: organizationalUnit
ou: groups

dn: ou=aliases,${cdn}
objectClass: top
objectClass: organizationalUnit
ou: aliases

dn: ${admin_dn}
objectClass: top
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: admin
description: LDAP administrator for customer ${customer}
userPassword: temporary
LDIF
            docker exec -i -e P="$admin_pw" "$CONTAINER" sh -c 'umask 077; printf "%s" "$P" > /tmp/.newpw'
            ldap_passwd -T /tmp/.newpw "$admin_dn" >/dev/null
            docker exec "$CONTAINER" rm -f /tmp/.newpw
            store_customer_secret "$customer" "$admin_dn" "$admin_pw"
            unset admin_pw
            echo "Created customer branch ${cdn}"
            echo "Customer admin DN: ${admin_dn}"
            echo "Password stored in ${DATA_DIR}/secrets/customers/${customer}.env (and /opt/docker-data/${customer}/_config_/ldap.env if that directory exists)"
        fi
        ;;
    add-user)
        need_container
        customer="${2:?usage: $0 add-user <customer> <uid> [email]}"
        uid="${3:?usage: $0 add-user <customer> <uid> [email]}"
        email="${4:-${uid}@${customer//_/.}}"
        cdn=$(customer_dn "$customer")
        dn="uid=${uid},ou=people,${cdn}"
        ldap_add <<LDIF
dn: ${dn}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
objectClass: lampiphantMailAccount
uid: ${uid}
cn: ${uid}
sn: ${uid}
mail: ${email}
mailEnabled: TRUE
LDIF
        echo "Created user ${dn} (mail=${email}). Set a password with: $0 set-password ${customer} ${uid}"
        ;;
    set-password)
        need_container
        customer="${2:?usage: $0 set-password <customer> <uid>}"
        uid="${3:?usage: $0 set-password <customer> <uid>}"
        dn="uid=${uid},ou=people,$(customer_dn "$customer")"
        if [ -t 0 ]; then
            echo -n "New password (input hidden): " >&2
            stty -echo
            read -r newpw
            stty echo
            echo >&2
        else
            read -r newpw
        fi
        if [ -z "${newpw:-}" ]; then
            echo "ERROR: empty password" >&2
            exit 1
        fi
        docker exec -i "$CONTAINER" sh -c 'umask 077; cat > /tmp/.newpw'
        # The password was consumed from stdin already into $newpw; write it via env into the file carefully
        docker exec -i -e P="$newpw" "$CONTAINER" sh -c 'umask 077; printf "%s" "$P" > /tmp/.newpw'
        unset newpw
        ldap_passwd -T /tmp/.newpw "$dn" >/dev/null
        docker exec "$CONTAINER" rm -f /tmp/.newpw
        echo "Password updated for ${dn}"
        ;;
    add-alias)
        need_container
        customer="${2:?usage: $0 add-alias <customer> <alias-address> <target-mailbox>}"
        alias_addr="${3:?}"
        target="${4:?}"
        # RDN: the local part of the alias, or the whole address with @ -> .
        localpart="${alias_addr%%@*}"
        safe=$(printf '%s' "$alias_addr" | tr '@.' '__')
        dn="cn=${safe},ou=aliases,$(customer_dn "$customer")"
        ldap_add <<LDIF
dn: ${dn}
objectClass: top
objectClass: applicationProcess
objectClass: lampiphantMailAlias
cn: ${safe}
mailAlias: ${alias_addr}
mail: ${target}
mailEnabled: TRUE
LDIF
        echo "Created alias ${alias_addr} -> ${target} (${dn})"
        ;;
    list)
        need_container
        if [ -n "${2:-}" ]; then
            ldap_search -b "$(customer_dn "$2")" '(objectClass=*)' dn mail mailAlias mailEnabled uid cn
        else
            echo "Customers:"
            ldap_search -b "$BASE_DN" -s one '(objectClass=organization)' o dn
            echo
            echo "Users (mail):"
            ldap_search -b "$BASE_DN" '(&(objectClass=inetOrgPerson)(mail=*))' dn uid mail mailEnabled
            echo
            echo "Aliases:"
            ldap_search -b "$BASE_DN" '(objectClass=lampiphantMailAlias)' dn mailAlias mail mailEnabled
        fi
        ;;
    export)
        need_container
        dest="${2:-${DATA_DIR}/backup/ldap-manual-$(date +%Y%m%d_%H%M%S).ldif}"
        mkdir -p "$(dirname "$dest")"
        ldap_search -b "$BASE_DN" '(objectClass=*)' > "$dest"
        chmod 600 "$dest"
        echo "Exported LDIF to ${dest}"
        ;;
    import-ldif)
        need_container
        file="${2:?usage: $0 import-ldif <file>}"
        [ -f "$file" ] || { echo "ERROR: file not found: $file" >&2; exit 1; }
        # Copy into the container and ldapadd -c (continue on already-exists)
        docker cp "$file" "${CONTAINER}:/tmp/import.ldif"
        with_bind ldapadd -x -H ldapi:/// -D "$ROOT_DN" -y /tmp/.ldap-admin-pw -c -f /tmp/import.ldif
        docker exec "$CONTAINER" rm -f /tmp/import.ldif
        echo "Imported ${file}"
        ;;
    *)
        sed -n '2,16p' "$0"
        exit 1
        ;;
esac
