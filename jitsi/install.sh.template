#!/bin/bash
# Host-side preparation for the app "jitsi". Generated by app.sh from the template.
# Prepares directories, secret files and (for a customer stack) the host JVB drop-in
# BEFORE the stack is deployed via Komodo. Does not print secret values.

set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"

# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh

write_secret_env() {
    local dest="$1"
    shift
    mkdir -p "$(dirname "$dest")"
    umask 077
    : > "$dest"
    local kv name
    for kv in "$@"; do
        name="${kv%%=*}"
        if [[ -z "$name" || "$kv" == *'!!'* ]]; then
            echo "ERROR: refusing to write an empty or unresolved secret ($name) to $dest" >&2
            exit 1
        fi
        printf '%s\n' "$kv" >> "$dest"
    done
    chmod 600 "$dest"
}

{%- if CUSTOMER == "_host_" %}
SPRW_JITSI_JVB_ADVERTISE_IPS="!!JVB_ADVERTISE_IPS!!"
SPRW_JITSI_JVB_PORT="!!JVB_PORT!!"

echo "Preparing host Jitsi Videobridge (${SPRW__STACKNAME}) ..."

ensure_mylampiphant_networks "_host_"

if [ -z "${SPRW_JITSI_JVB_ADVERTISE_IPS}" ] || [[ "${SPRW_JITSI_JVB_ADVERTISE_IPS}" == *'!!'* ]]; then
    SPRW_JITSI_JVB_ADVERTISE_IPS="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}' || true)"
    if [ -z "${SPRW_JITSI_JVB_ADVERTISE_IPS}" ]; then
        echo "ERROR: JVB_ADVERTISE_IPS is empty and the public IPv4 could not be detected."
        echo "Re-run: app.sh jitsi add _host_ --var JVB_ADVERTISE_IPS=<public-ipv4>"
        exit 1
    fi
    echo "Using detected IPv4 for JVB_ADVERTISE_IPS (not printed). Pass --var JVB_ADVERTISE_IPS if you want a fixed value in the persistent config."
fi

mkdir -p "$SPRW__DATA_DIR/secrets"
umask 077
printf 'JVB_ADVERTISE_IPS=%s\n' "$SPRW_JITSI_JVB_ADVERTISE_IPS" > "$SPRW__DATA_DIR/secrets/jvb-advertise.env"
chmod 600 "$SPRW__DATA_DIR/secrets/jvb-advertise.env"

if [ -z "${SPRW_JITSI_JVB_PORT}" ] || [[ "${SPRW_JITSI_JVB_PORT}" == *'!!'* ]]; then
    SPRW_JITSI_JVB_PORT=10000
fi

mkdir -p "$SPRW__COMPOSE_DIR"
mkdir -p "$SPRW__DATA_DIR/jvb"
mkdir -p "$SPRW__DATA_DIR/xmpp-servers"
mkdir -p "$SPRW__DATA_DIR/scripts"
chmod 700 "$SPRW__DATA_DIR/xmpp-servers"

install -m 0755 /opt/docker/_templates_/jitsi/assemble-jvb-xmpp.sh "$SPRW__DATA_DIR/scripts/assemble-jvb-xmpp.sh"
install -m 0755 /opt/docker/_templates_/jitsi/jvb-entrypoint.sh "$SPRW__DATA_DIR/scripts/jvb-entrypoint.sh"

JITSI_JVB_CONFIG_DIR="$SPRW__DATA_DIR/jvb" \
JITSI_XMPP_SERVERS_DIR="$SPRW__DATA_DIR/xmpp-servers" \
    "$SPRW__DATA_DIR/scripts/assemble-jvb-xmpp.sh"

echo "Host JVB preparation done for ${SPRW__STACKNAME}."
echo "Publish UDP ${SPRW_JITSI_JVB_PORT} on the host firewall. TCP fallback needs a TURN server (not in this template)."
echo "The bridge starts with no customer shards until a customer jitsi stack is installed."

{%- else %}
JICOFO_AUTH_PASSWORD="!!JICOFO_AUTH_PASSWORD!!"
JVB_AUTH_PASSWORD="!!JVB_AUTH_PASSWORD!!"
JIBRI_XMPP_PASSWORD="!!JIBRI_XMPP_PASSWORD!!"
JIBRI_RECORDER_PASSWORD="!!JIBRI_RECORDER_PASSWORD!!"

echo "Preparing customer Jitsi Meet (${SPRW__STACKNAME}) ..."

if [ -z "${SPRW__APPDOMAIN}" ] || [[ "${SPRW__APPDOMAIN}" == *'!!'* ]]; then
    echo "ERROR: APPDOMAIN is required (public meeting host, e.g. meet.example.com)."
    echo "Install with: app.sh jitsi add ${SPRW__CUSTOMER} --var APPDOMAIN=meet.example.com"
    echo "Do not pass the host as a positional domain (that would create jitsi_d_<domain>)."
    exit 1
fi

if [ -z "${JICOFO_AUTH_PASSWORD}" ] || [[ "${JICOFO_AUTH_PASSWORD}" == *'!!'* ]] \
    || [ -z "${JVB_AUTH_PASSWORD}" ] || [[ "${JVB_AUTH_PASSWORD}" == *'!!'* ]]; then
    echo "ERROR: required Jitsi passwords were not generated. Re-run app.sh so !!NEW_PASSWORD!! is resolved."
    exit 1
fi

ensure_mylampiphant_networks "$SPRW__CUSTOMER"

mkdir -p "$SPRW__COMPOSE_DIR"
mkdir -p "$SPRW__DATA_DIR/web" "$SPRW__DATA_DIR/web/crontabs" "$SPRW__DATA_DIR/web/transcripts"
mkdir -p "$SPRW__DATA_DIR/prosody/config" "$SPRW__DATA_DIR/prosody/prosody-plugins-custom"
mkdir -p "$SPRW__DATA_DIR/jicofo"
{%- if JITSI_WHITEBOARD == "true" %}
mkdir -p "$SPRW__DATA_DIR/whiteboard"
{%- endif %}
{%- if JITSI_RECORDING == "true" %}
mkdir -p "$SPRW__DATA_DIR/jibri" "$SPRW__DATA_DIR/jibri/storage"
{%- endif %}
mkdir -p "$SPRW__DATA_DIR/secrets"

write_secret_env "$SPRW__DATA_DIR/secrets/jitsi.env" \
    "JICOFO_AUTH_PASSWORD=${JICOFO_AUTH_PASSWORD}" \
    "JVB_AUTH_PASSWORD=${JVB_AUTH_PASSWORD}" \
    "JIBRI_XMPP_PASSWORD=${JIBRI_XMPP_PASSWORD}" \
    "JIBRI_RECORDER_PASSWORD=${JIBRI_RECORDER_PASSWORD}"

HOST_DATA="/opt/docker-data/_host_/jitsi"
if [ ! -d "$HOST_DATA/xmpp-servers" ] || [ ! -x "$HOST_DATA/scripts/assemble-jvb-xmpp.sh" ]; then
    echo "ERROR: host JVB is not prepared at $HOST_DATA."
    echo "Install it first (app.sh normally does this via SPRW__REQUIRES_HOST_APPS):"
    echo "  app.sh jitsi add _host_"
    exit 1
fi

# Unique XMPP domains per customer, matching compose.yaml.template.
XMPP_AUTH_DOMAIN="auth.meet.${SPRW__CUSTOMER}"
XMPP_INTERNAL_MUC_DOMAIN="internal-muc.meet.${SPRW__CUSTOMER}"
XMPP_HOSTNAME="xmpp-${SPRW__STACKNAME}"
DROPIN="${HOST_DATA}/xmpp-servers/${SPRW__STACKNAME}.conf"
# HOCON key must be a simple identifier (stack names use letters, digits, underscore).
HOCON_KEY="${SPRW__STACKNAME}"

umask 077
cat > "$DROPIN" <<DROP
${HOCON_KEY} {
  HOSTNAME = "${XMPP_HOSTNAME}"
  PORT = "5222"
  DOMAIN = "${XMPP_AUTH_DOMAIN}"
  USERNAME = "jvb"
  PASSWORD = "${JVB_AUTH_PASSWORD}"
  MUC_JIDS = "jvbbrewery@${XMPP_INTERNAL_MUC_DOMAIN}"
  MUC_NICKNAME = "jvb-host"
  DISABLE_CERTIFICATE_VERIFICATION = true
}
DROP
chmod 600 "$DROPIN"

JITSI_JVB_CONFIG_DIR="${HOST_DATA}/jvb" \
JITSI_XMPP_SERVERS_DIR="${HOST_DATA}/xmpp-servers" \
    "${HOST_DATA}/scripts/assemble-jvb-xmpp.sh"

if docker container inspect jitsi >/dev/null 2>&1; then
    echo "Restarting host JVB so it joins this customer's brewery MUC."
    echo "Ongoing meetings on the shared bridge will be interrupted."
    docker restart jitsi >/dev/null
else
    echo "Host JVB container is not running yet. It will pick up this customer on the next start."
fi

echo "Customer Jitsi preparation done for ${SPRW__STACKNAME}."
echo "Public UI: https://${SPRW__APPDOMAIN}"
echo "Open UDP 10000 (host JVB) on the firewall. Recordings and the whiteboard follow the template options."
{%- endif %}
