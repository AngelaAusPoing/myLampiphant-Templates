#!/bin/bash
# install.sh for the app "syncstorage-rs" - generated by app.sh from _templates_/syncstorage-rs/install.sh.template
# Prepares directories and secret env files BEFORE Komodo builds and deploys the
# stack. Secrets are read from the persistent config, written chmod 600 under
# <data_dir>/secrets/ and never printed.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW_SYNCSTORAGE_DB_NAME="!!DB_NAME!!"
SPRW_SYNCSTORAGE_DB_USER="!!DB_USER!!"
CONFIG_FILE="$(dirname "$SPRW__DATA_DIR")/_config_/${SPRW__STACKNAME}.env"

echo "Preparing syncstorage-rs ${SPRW__STACKNAME} (${SPRW__APPDOMAIN}) ..."

missing=0
for v in SPRW__CUSTOMER SPRW__STACKNAME SPRW__APPDOMAIN SPRW__DATA_DIR SPRW__COMPOSE_DIR \
         SPRW_SYNCSTORAGE_DB_NAME SPRW_SYNCSTORAGE_DB_USER; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in ${CONFIG_FILE} or pass --var." >&2
        missing=1
    fi
done
[ "$missing" -eq 0 ] || exit 1

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}
is_set() { [ -n "$1" ] && [[ "$1" != *'!!'* ]]; }

# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_shared_networks
ensure_customer_network "$SPRW__CUSTOMER"

mkdir -p "$SPRW__COMPOSE_DIR" "$SPRW__DATA_DIR/db" "$SPRW__DATA_DIR/secrets"
chmod 700 "$SPRW__DATA_DIR/secrets"
# Official postgres alpine image runs as postgres (uid 70)
chown -R 70:70 "$SPRW__DATA_DIR/db"

db_pw=$(read_cfg SPRW_SYNCSTORAGE_DB_PASSWORD)
master=$(read_cfg SPRW_SYNCSTORAGE_MASTER_SECRET)
metrics=$(read_cfg SPRW_SYNCSTORAGE_METRICS_HASH_SECRET)
if ! is_set "$db_pw" || ! is_set "$master" || ! is_set "$metrics"; then
    echo "ERROR: DB password or master/metrics secret missing in ${CONFIG_FILE}" >&2
    unset db_pw master metrics
    exit 1
fi

umask 077
db_url="postgres://${SPRW_SYNCSTORAGE_DB_USER}:${db_pw}@db:5432/${SPRW_SYNCSTORAGE_DB_NAME}"
cat > "$SPRW__DATA_DIR/secrets/db.env" <<ENV
POSTGRES_PASSWORD=${db_pw}
ENV
# Syncstorage and tokenserver share one database (upstream one-shot layout).
cat > "$SPRW__DATA_DIR/secrets/syncserver.env" <<ENV
SYNC_MASTER_SECRET=${master}
SYNC_TOKENSERVER__FXA_METRICS_HASH_SECRET=${metrics}
SYNC_SYNCSTORAGE__DATABASE_URL=${db_url}
SYNC_TOKENSERVER__DATABASE_URL=${db_url}
ENV
chmod 600 "$SPRW__DATA_DIR/secrets/db.env" "$SPRW__DATA_DIR/secrets/syncserver.env"
unset db_pw master metrics db_url

echo "Installation prepared. Komodo builds the image from the upstream repo on the first deploy."
echo "  Expect 30-60 minutes and 2-3 GB RAM for the Rust build on a 2-core ARM64 host."
echo "Firefox: about:config -> identity.sync.tokenserver.uri = https://${SPRW__APPDOMAIN}/1.0/sync/1.5"
