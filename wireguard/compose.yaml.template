# myLampiphant app "wireguard" - compose template
# wg-easy (WireGuard + web UI). One stack per customer: wireguard_c_<customer>.
#
# UDP !!WG_PORT!! is published on the host. The web UI is bound to 127.0.0.1 only
# (SSH tunnel, later Authelia) and is not routed through Traefik. Port 443 is
# not used. The container joins only c_<customer>-net.
#
# Generated by app.sh from _templates_/wireguard/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:

  wg-easy:
    image: !!WG_IMAGE!!
    container_name: !!STACKNAME!!
    hostname: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!WG_MEM_LIMIT!!
    env_file:
      - !!DATA_DIR!!/secrets/wg-easy.env
    environment:
      - TZ=!!TIMEZONE!!
      - PORT=51821
      - HOST=0.0.0.0
      - INSECURE=true
      - DISABLE_IPV6=!!WG_DISABLE_IPV6!!
    ports:
      - "!!WG_PORT!!:!!WG_PORT!!/udp"
      - "127.0.0.1:!!WG_UI_PORT!!:51821"
    volumes:
      - !!DATA_DIR!!/data:/etc/wireguard
      - !!DATA_DIR!!/scripts/entrypoint.sh:/opt/mylampiphant/entrypoint.sh:ro
      - !!DATA_DIR!!/scripts/wg-firewall.sh:/opt/mylampiphant/wg-firewall.sh:ro
      - !!DATA_DIR!!/scripts/firewall.conf:/opt/mylampiphant/firewall.conf:ro
      - /lib/modules:/lib/modules:ro
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
      - net.ipv6.conf.all.disable_ipv6=1
    networks:
      - customer-net
    entrypoint: ["/opt/mylampiphant/entrypoint.sh"]
    command: ["/usr/bin/dumb-init", "node", "server/index.mjs"]
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:51821/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 30s

networks:
  customer-net:
    name: c_!!CUSTOMER!!-net
    external: true
