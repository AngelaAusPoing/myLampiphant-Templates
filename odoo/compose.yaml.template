# App "odoo" - compose template
# Odoo (ERP) + PostgreSQL. Single instance per customer: odoo_c_<customer>.
# Images: odoo and postgres:alpine (both multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/odoo/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   SPRW_ODOO_DB_INIT: true | false
#     true  = first start initialises the database with a wrapper script (default)
#     false = plain Odoo start, create the database in the web UI
#   SPRW_ODOO_LIST_DB: false | true
#     false = database manager and database list disabled, Odoo is locked to
#             SPRW_ODOO_DB_NAME (db_name + dbfilter) (default)
#     true  = database manager enabled (protected by the master password)
# The master password SPRW_ODOO_ADMIN_PASSWD is generated once in the
# persistent config and always set (admin_passwd).
services:
  db:
    image: ${SPRW_ODOO_DB_IMAGE:-postgres:16-alpine}
    container_name: ${SPRW__STACKNAME:-odoo_c_customer_directory}_db
    restart: unless-stopped
    networks:
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-odoo_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-odoo_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- endif %}
    environment:
      - POSTGRES_USER=${SPRW_ODOO_DB_USER:-odoo}
      - POSTGRES_PASSWORD=${SPRW_ODOO_DB_PASSWORD}
      - POSTGRES_DB=${SPRW_ODOO_DB_NAME:-odoo}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${SPRW_ODOO_DB_USER:-odoo} -d ${SPRW_ODOO_DB_NAME:-odoo}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  odoo:
    image: ${SPRW_ODOO_IMAGE:-odoo:18.0}
    container_name: ${SPRW__STACKNAME:-odoo_c_customer_directory}
    restart: unless-stopped
    networks:
      - proxy-shared
      - customer-net
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/odoo-data:/var/lib/odoo
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/addons:/mnt/extra-addons
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-odoo_c_customer_directory}_odoo_data:/var/lib/odoo
      - ${SPRW__STACKNAME:-odoo_c_customer_directory}_addons:/mnt/extra-addons
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-odoo_c_customer_directory}_odoo_data:/var/lib/odoo
      - ${SPRW__STACKNAME:-odoo_c_customer_directory}_addons:/mnt/extra-addons
    {%- endif %}
    {%- if SPRW_ODOO_DB_INIT == "true" %}
      # Wrapper created by install.sh: initialises the database once, then starts Odoo.
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/init-odoo.sh:/usr/local/bin/init-odoo.sh:ro
    {%- elif SPRW_ODOO_DB_INIT == "false" %}
      # No init wrapper: create the database in the Odoo web UI.
    {%- endif %}
    environment:
      # Read by the image entrypoint (database connection). Use the unique
      # container name, not the service name "db": customer-net may contain
      # other stacks' "db" services (DNS alias collision).
      - HOST=${SPRW__STACKNAME:-odoo_c_customer_directory}_db
      - PORT=5432
      - USER=${SPRW_ODOO_DB_USER:-odoo}
      - PASSWORD=${SPRW_ODOO_DB_PASSWORD}
      - POSTGRES_USER=${SPRW_ODOO_DB_USER:-odoo}
      - POSTGRES_PASSWORD=${SPRW_ODOO_DB_PASSWORD}
      - POSTGRES_DB=${SPRW_ODOO_DB_NAME:-odoo}
      - PROXY_MODE=${SPRW_ODOO_PROXY_MODE:-True}
      # Master password (database manager) and database name for the start
      # script below; written into a private copy of odoo.conf, never printed.
      - ODOO_ADMIN_PASSWD=${SPRW_ODOO_ADMIN_PASSWD}
      - ODOO_DB_NAME=${SPRW_ODOO_DB_NAME:-odoo}
    # Start script: copy the image odoo.conf to a private file, add admin_passwd
    # (and the database lock), point ODOO_RC at it, then start Odoo.
    command:
      - sh
      - -c
      - |
        umask 077
        cp /etc/odoo/odoo.conf /tmp/odoo.conf
        printf %s "admin_passwd = " >> /tmp/odoo.conf
        printf %s "$$ODOO_ADMIN_PASSWD" >> /tmp/odoo.conf
        echo >> /tmp/odoo.conf
        {%- if SPRW_ODOO_LIST_DB == "false" %}
        echo "list_db = False" >> /tmp/odoo.conf
        printf %s "db_name = " >> /tmp/odoo.conf
        printf %s "$$ODOO_DB_NAME" >> /tmp/odoo.conf
        echo >> /tmp/odoo.conf
        printf %s "dbfilter = ^" >> /tmp/odoo.conf
        printf %s "$$ODOO_DB_NAME" >> /tmp/odoo.conf
        echo '$' >> /tmp/odoo.conf
        {%- elif SPRW_ODOO_LIST_DB == "true" %}
        echo "list_db = True" >> /tmp/odoo.conf
        {%- endif %}
        unset ODOO_ADMIN_PASSWD
        export ODOO_RC=/tmp/odoo.conf
        {%- if SPRW_ODOO_DB_INIT == "true" %}
        exec /usr/local/bin/init-odoo.sh
        {%- elif SPRW_ODOO_DB_INIT == "false" %}
        exec /entrypoint.sh odoo
        {%- endif %}
    depends_on:
      db:
        condition: service_healthy
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.http.routers.${SPRW__STACKNAME:-odoo_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-odoo_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-odoo_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-odoo_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-odoo_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-odoo_c_customer_directory}.loadbalancer.server.port=8069"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      # Public access
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Only VPN and internal networks. The middleware is defined here, no file provider needed.
      - "traefik.http.middlewares.${SPRW__STACKNAME:-odoo_c_customer_directory}-iprestrict.ipallowlist.sourcerange=${SPRW_ODOO_INTERNAL_SOURCERANGE}"
      - "traefik.http.routers.${SPRW__STACKNAME:-odoo_c_customer_directory}.middlewares=${SPRW__STACKNAME:-odoo_c_customer_directory}-iprestrict"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-odoo_c_customer_directory}_postgres:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/postgres

  ${SPRW__STACKNAME:-odoo_c_customer_directory}_odoo_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/odoo-data

  ${SPRW__STACKNAME:-odoo_c_customer_directory}_addons:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-odoo_c_customer_directory}/addons
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-odoo_c_customer_directory}_postgres:
  ${SPRW__STACKNAME:-odoo_c_customer_directory}_odoo_data:
  ${SPRW__STACKNAME:-odoo_c_customer_directory}_addons:
{%- endif %}

# ===================== Networks =====================
# proxy-shared: Traefik (always attached; EXTERNAL_ACCESS=false limits access with an IP allowlist)
# customer-net: other apps of the same customer (created by ensure-networks.sh if missing)
# backend:      stack-local, internal network for PostgreSQL (no outbound access);
#               the database is not reachable from other stacks
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
  backend:
    name: ${SPRW__STACKNAME:-odoo_c_customer_directory}_backend
    internal: true
