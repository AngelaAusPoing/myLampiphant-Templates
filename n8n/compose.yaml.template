# App "n8n" - compose template
# n8n workflow automation + PostgreSQL. Single instance per customer: n8n_c_<customer>.
#
# Generated by app.sh from _templates_/n8n/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  postgres:
    image: ${SPRW_N8N_DB_IMAGE:-postgres:16-alpine}
    container_name: ${SPRW__STACKNAME:-n8n_c_customer_directory}_db
    restart: unless-stopped
    mem_limit: ${SPRW_N8N_DB_MEM_LIMIT:-256m}
    networks:
      - customer-net
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-n8n_c_customer_directory}/postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-n8n_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-n8n_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- endif %}
    environment:
      - POSTGRES_USER=${SPRW_N8N_DB_USER:-n8n}
      - POSTGRES_PASSWORD=${SPRW_N8N_DB_PASSWORD}
      - POSTGRES_DB=${SPRW_N8N_DB_NAME:-n8n}
      - TZ=${SPRW_N8N_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${SPRW_N8N_DB_USER:-n8n} -d ${SPRW_N8N_DB_NAME:-n8n}"]
      interval: 10s
      timeout: 5s
      retries: 6

  n8n:
    image: ${SPRW_N8N_IMAGE:-n8nio/n8n:latest}
    container_name: ${SPRW__STACKNAME:-n8n_c_customer_directory}
    restart: unless-stopped
    mem_limit: ${SPRW_N8N_MEM_LIMIT:-512m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-n8n_c_customer_directory}/n8n:/home/node/.n8n
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-n8n_c_customer_directory}_n8n:/home/node/.n8n
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-n8n_c_customer_directory}_n8n:/home/node/.n8n
    {%- endif %}
    environment:
      - N8N_HOST=${SPRW__APPDOMAIN}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - WEBHOOK_URL=https://${SPRW__APPDOMAIN}/
      - N8N_PROXY_HOPS=1
      - N8N_ENCRYPTION_KEY=${SPRW_N8N_ENCRYPTION_KEY}
      - GENERIC_TIMEZONE=${SPRW_N8N_TIMEZONE:-Europe/Berlin}
      - TZ=${SPRW_N8N_TIMEZONE:-Europe/Berlin}
      - NODE_OPTIONS=--max-old-space-size=${SPRW_N8N_NODE_MAX_OLD_SPACE:-384}
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_USER=${SPRW_N8N_DB_USER:-n8n}
      - DB_POSTGRESDB_PASSWORD=${SPRW_N8N_DB_PASSWORD}
      - DB_POSTGRESDB_DATABASE=${SPRW_N8N_DB_NAME:-n8n}
      - EXECUTIONS_DATA_PRUNE=true
      - EXECUTIONS_DATA_MAX_AGE=${SPRW_N8N_EXECUTIONS_MAX_AGE:-168}
      - N8N_DIAGNOSTICS_ENABLED=false
      - N8N_PERSONALIZATION_ENABLED=false
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://127.0.0.1:5678/healthz || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-n8n_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-n8n_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-n8n_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-n8n_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-n8n_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-n8n_c_customer_directory}.loadbalancer.server.port=5678"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Limit IP access (only VPN and internal networks)
      - "traefik.http.routers.${SPRW__STACKNAME:-n8n_c_customer_directory}.middlewares=iprestrict@file"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-n8n_c_customer_directory}_postgres:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-n8n_c_customer_directory}/postgres

  ${SPRW__STACKNAME:-n8n_c_customer_directory}_n8n:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-n8n_c_customer_directory}/n8n
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-n8n_c_customer_directory}_postgres:
  ${SPRW__STACKNAME:-n8n_c_customer_directory}_n8n:
{%- endif %}

# ===================== Networks =====================
# customer-net: n8n + PostgreSQL (created by ensure-networks.sh / app.sh if missing)
# proxy-shared: Traefik + web frontend only; the database stays off this network
{%- if SPRW__EXTERNAL_ACCESS == "true" %}
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- elif SPRW__EXTERNAL_ACCESS == "false" %}
# Container is accessible only internally, e.g. by LAN or VPN.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- endif %}
