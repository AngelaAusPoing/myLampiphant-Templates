#!/bin/bash
# install.sh for the app "wireguard" - generated by app.sh from
# _templates_/wireguard/install.sh.template
# Prepares the host side (module, networks, subnet allocation, secrets,
# scripts, ufw) BEFORE the stack is deployed via Komodo.
# Idempotent: existing secret files are never overwritten. Secrets are never printed.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW_WG_IMAGE="!!WG_IMAGE!!"
SPRW_WG_PORT="!!WG_PORT!!"
SPRW_WG_UI_PORT="!!WG_UI_PORT!!"
SPRW_WG_MEM_LIMIT="!!WG_MEM_LIMIT!!"
# Endpoint, subnet and AllowedIPs are computed (or loaded from the persistent
# config) below. Do not pull them through !!placeholders!! here: app.sh may
# substitute a circular $SPRW_WG_* reference and break set -u.
SPRW_WG_ENDPOINT=""
SPRW_WG_SUBNET_INDEX=""
SPRW_WG_IPV4_CIDR=""
SPRW_WG_IPV6_CIDR=""
SPRW_WG_DNS="!!WG_DNS!!"
SPRW_WG_DISABLE_IPV6="!!WG_DISABLE_IPV6!!"
SPRW_WG_UI_USERNAME="!!WG_UI_USERNAME!!"
SPRW_WG_TIMEZONE="!!TIMEZONE!!"
SPRW_WG_ALLOWED_IPS=""
TEMPLATE_DIR="/opt/docker/_templates_/wireguard"
CONFIG_FILE="$(dirname "$SPRW__DATA_DIR")/_config_/${SPRW__STACKNAME}.env"
ALLOC_FILE="/opt/docker-data/_host_/_config_/vpn-subnets.conf"
CUSTOMER_NET="c_${SPRW__CUSTOMER}-net"

echo "Preparing wireguard ${SPRW__STACKNAME} ..."

# ---------------------------------------------------------------------------
# 1. Refuse to continue with unresolved required placeholders
# ---------------------------------------------------------------------------
missing=0
for v in SPRW__CUSTOMER SPRW__STACKNAME SPRW__DATA_DIR SPRW__COMPOSE_DIR \
         SPRW_WG_IMAGE SPRW_WG_PORT SPRW_WG_UI_PORT SPRW_WG_MEM_LIMIT \
         SPRW_WG_DNS SPRW_WG_DISABLE_IPV6 SPRW_WG_UI_USERNAME SPRW_WG_TIMEZONE; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in the persistent config or pass --var ${v#SPRW_WG_}=..." >&2
        missing=1
    fi
done
if [ "$missing" -ne 0 ]; then
    echo "Review the persistent config (<customer>/_config_/${SPRW__STACKNAME}.env) and run app.sh again." >&2
    exit 1
fi
if [ "$SPRW__CUSTOMER" = "_host_" ]; then
    echo "ERROR: wireguard is a per-customer app (wireguard_c_<customer>), not a host app." >&2
    exit 1
fi

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}

load_cfg_if_set() {
    local key="$1"
    local dest="$2"
    local val=""
    if [ -f "$CONFIG_FILE" ]; then
        val="$(read_cfg "$key" || true)"
    fi
    if [ -n "$val" ] && [[ "$val" != *'!!'* ]]; then
        printf -v "$dest" '%s' "$val"
    fi
}
load_cfg_if_set SPRW_WG_ENDPOINT SPRW_WG_ENDPOINT
load_cfg_if_set SPRW_WG_SUBNET_INDEX SPRW_WG_SUBNET_INDEX
load_cfg_if_set SPRW_WG_IPV4_CIDR SPRW_WG_IPV4_CIDR
load_cfg_if_set SPRW_WG_IPV6_CIDR SPRW_WG_IPV6_CIDR
load_cfg_if_set SPRW_WG_ALLOWED_IPS SPRW_WG_ALLOWED_IPS


# Update or insert a key=value in the persistent config without printing the value
# when the key is a secret. For non-secrets we write quoted values.
upsert_cfg() {
    local key="$1"
    local value="$2"
    local tmp
    tmp="$(mktemp)"
    if [ -f "$CONFIG_FILE" ] && grep -qE "^${key}=" "$CONFIG_FILE"; then
        awk -v k="$key" -v v="$value" '
            BEGIN { done=0 }
            $0 ~ "^" k "=" {
                print k "='\''" v "'\''"
                done=1
                next
            }
            { print }
            END { if (!done) print k "='\''" v "'\''" }
        ' "$CONFIG_FILE" > "$tmp"
        cat "$tmp" > "$CONFIG_FILE"
    else
        mkdir -p "$(dirname "$CONFIG_FILE")"
        printf "%s='%s'\n" "$key" "$value" >> "$CONFIG_FILE"
    fi
    rm -f "$tmp"
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# 2. WireGuard kernel module
# ---------------------------------------------------------------------------
if ! lsmod | grep -q '^wireguard'; then
    if ! modprobe wireguard 2>/dev/null; then
        echo "ERROR: could not load the wireguard kernel module. Install linux-image/modules for $(uname -r) and retry." >&2
        exit 1
    fi
    echo "Loaded wireguard kernel module."
fi
if [ ! -d /lib/modules/"$(uname -r)" ]; then
    echo "ERROR: /lib/modules/$(uname -r) is missing; the container needs it read-only." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 3. Customer Docker network (regular bridge, idempotent)
# ---------------------------------------------------------------------------
# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_customer_network "$SPRW__CUSTOMER"

CUSTOMER_CIDR="$(docker network inspect "$CUSTOMER_NET" | jq -r '.[0].IPAM.Config[0].Subnet')"
if [ -z "$CUSTOMER_CIDR" ]; then
    echo "ERROR: could not determine subnet of ${CUSTOMER_NET}" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 4. Subnet allocation (10.50.<n>.0/24) recorded on the host
# ---------------------------------------------------------------------------
mkdir -p "$(dirname "$ALLOC_FILE")"
if [ ! -f "$ALLOC_FILE" ]; then
    umask 022
    cat > "$ALLOC_FILE" <<'ALLOC'
# myLampiphant VPN subnet allocation (host-only, do not commit)
# n  customer            wg_cidr         ovpn_cidr       wg_ipv6
# See _templates_/wireguard/SUBNETS.md
ALLOC
fi

# If this customer is already recorded, reuse that index
existing_line="$(awk -v c="$SPRW__CUSTOMER" '($1 ~ /^[0-9]+$/) && ($2 == c) {print; exit}' "$ALLOC_FILE" || true)"
if [ -n "$existing_line" ]; then
    alloc_n="$(echo "$existing_line" | awk '{print $1}')"
    alloc_v4="$(echo "$existing_line" | awk '{print $3}')"
    alloc_v6="$(echo "$existing_line" | awk '{print $5}')"
    if [ -z "$SPRW_WG_SUBNET_INDEX" ] || [[ "$SPRW_WG_SUBNET_INDEX" == *'!!'* ]]; then
        SPRW_WG_SUBNET_INDEX="$alloc_n"
    fi
    if [ -z "$SPRW_WG_IPV4_CIDR" ] || [[ "$SPRW_WG_IPV4_CIDR" == *'!!'* ]]; then
        SPRW_WG_IPV4_CIDR="$alloc_v4"
    fi
    if [ -z "$SPRW_WG_IPV6_CIDR" ] || [[ "$SPRW_WG_IPV6_CIDR" == *'!!'* ]]; then
        SPRW_WG_IPV6_CIDR="$alloc_v6"
    fi
    if [ "$SPRW_WG_SUBNET_INDEX" != "$alloc_n" ] || [ "$SPRW_WG_IPV4_CIDR" != "$alloc_v4" ]; then
        echo "ERROR: ${SPRW__CUSTOMER} is already allocated index ${alloc_n} (${alloc_v4}) in ${ALLOC_FILE}, but the config asks for a different value." >&2
        exit 1
    fi
fi

if [ -z "$SPRW_WG_SUBNET_INDEX" ] || [[ "$SPRW_WG_SUBNET_INDEX" == *'!!'* ]]; then
    if [ -n "$SPRW_WG_IPV4_CIDR" ] && [[ "$SPRW_WG_IPV4_CIDR" != *'!!'* ]]; then
        SPRW_WG_SUBNET_INDEX="$(echo "$SPRW_WG_IPV4_CIDR" | awk -F'[./]' '{print $3}')"
    else
        used="$(awk '$1 ~ /^[0-9]+$/ {print $1}' "$ALLOC_FILE" | sort -n)"
        SPRW_WG_SUBNET_INDEX=""
        for i in $(seq 1 254); do
            if ! echo "$used" | grep -qx "$i"; then
                SPRW_WG_SUBNET_INDEX="$i"
                break
            fi
        done
        if [ -z "$SPRW_WG_SUBNET_INDEX" ]; then
            echo "ERROR: no free VPN subnet index left (1-254) in ${ALLOC_FILE}" >&2
            exit 1
        fi
    fi
fi

if ! [[ "$SPRW_WG_SUBNET_INDEX" =~ ^[0-9]+$ ]] || [ "$SPRW_WG_SUBNET_INDEX" -lt 1 ] || [ "$SPRW_WG_SUBNET_INDEX" -gt 254 ]; then
    echo "ERROR: WG_SUBNET_INDEX must be an integer 1-254" >&2
    exit 1
fi

if [ -z "$SPRW_WG_IPV4_CIDR" ] || [[ "$SPRW_WG_IPV4_CIDR" == *'!!'* ]]; then
    SPRW_WG_IPV4_CIDR="10.50.${SPRW_WG_SUBNET_INDEX}.0/24"
fi
if [ -z "$SPRW_WG_IPV6_CIDR" ] || [[ "$SPRW_WG_IPV6_CIDR" == *'!!'* ]]; then
    SPRW_WG_IPV6_CIDR="fd50:${SPRW_WG_SUBNET_INDEX}::/64"
fi

# Collision: same index or CIDR used by another customer
conflict="$(awk -v n="$SPRW_WG_SUBNET_INDEX" -v c="$SPRW__CUSTOMER" -v v4="$SPRW_WG_IPV4_CIDR" \
    '($1 ~ /^[0-9]+$/) && ($2 != c) && ($1 == n || $3 == v4) {print $2, $1, $3; exit}' "$ALLOC_FILE" || true)"
if [ -n "$conflict" ]; then
    echo "ERROR: subnet index or CIDR already allocated: ${conflict}" >&2
    exit 1
fi

if [ -z "$existing_line" ]; then
    printf '%-4s %-20s %-16s %-16s %s\n' \
        "$SPRW_WG_SUBNET_INDEX" "$SPRW__CUSTOMER" "$SPRW_WG_IPV4_CIDR" \
        "10.51.${SPRW_WG_SUBNET_INDEX}.0/24" "$SPRW_WG_IPV6_CIDR" >> "$ALLOC_FILE"
    echo "Allocated VPN index ${SPRW_WG_SUBNET_INDEX} (${SPRW_WG_IPV4_CIDR}) for ${SPRW__CUSTOMER}."
fi

upsert_cfg SPRW_WG_SUBNET_INDEX "$SPRW_WG_SUBNET_INDEX"
upsert_cfg SPRW_WG_IPV4_CIDR "$SPRW_WG_IPV4_CIDR"
upsert_cfg SPRW_WG_IPV6_CIDR "$SPRW_WG_IPV6_CIDR"

# ---------------------------------------------------------------------------
# 5. Endpoint (public address clients connect to)
# ---------------------------------------------------------------------------
if [ -z "$SPRW_WG_ENDPOINT" ] || [[ "$SPRW_WG_ENDPOINT" == *'!!'* ]]; then
    cust_profile="$(dirname "$SPRW__DATA_DIR")/customer_profile.sh"
    if [ -f "$cust_profile" ]; then
        SPRW_WG_ENDPOINT="$(grep -E '^export HOST_IPv4=' "$cust_profile" | head -1 | cut -d= -f2- | tr -d '"'\''[:space:]')"
    fi
fi
if [ -z "$SPRW_WG_ENDPOINT" ] || [[ "$SPRW_WG_ENDPOINT" == *'!!'* ]]; then
    SPRW_WG_ENDPOINT="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')"
fi
if [ -z "$SPRW_WG_ENDPOINT" ]; then
    echo "ERROR: could not determine WG_ENDPOINT (public IP or hostname). Set it in the persistent config." >&2
    exit 1
fi
upsert_cfg SPRW_WG_ENDPOINT "$SPRW_WG_ENDPOINT"

# Split-tunnel AllowedIPs: VPN subnet + this customer's Docker network
if [ -z "$SPRW_WG_ALLOWED_IPS" ] || [[ "$SPRW_WG_ALLOWED_IPS" == *'!!'* ]]; then
    SPRW_WG_ALLOWED_IPS="${SPRW_WG_IPV4_CIDR},${CUSTOMER_CIDR}"
    if [ "$SPRW_WG_DISABLE_IPV6" != "true" ]; then
        SPRW_WG_ALLOWED_IPS="${SPRW_WG_ALLOWED_IPS},${SPRW_WG_IPV6_CIDR}"
    fi
fi
upsert_cfg SPRW_WG_ALLOWED_IPS "$SPRW_WG_ALLOWED_IPS"

# ---------------------------------------------------------------------------
# 6. Port clash checks (UI must not be LAM's 18080; UDP must be free)
# ---------------------------------------------------------------------------
if [ "$SPRW_WG_UI_PORT" = "18080" ]; then
    echo "ERROR: WG_UI_PORT 18080 is reserved for LAM. Choose another localhost port (default 18081)." >&2
    exit 1
fi
ui_conflict="$(ss -lnt | awk -v p=":${SPRW_WG_UI_PORT}" '$4 ~ p"$" {print; exit}')"
if [ -n "$ui_conflict" ]; then
    echo "ERROR: TCP port ${SPRW_WG_UI_PORT} is already in use on the host. Set WG_UI_PORT to a free port." >&2
    exit 1
fi
udp_conflict="$(ss -lnu | awk -v p=":${SPRW_WG_PORT}" '$4 ~ p"$" {print; exit}')"
if [ -n "$udp_conflict" ]; then
    echo "ERROR: UDP port ${SPRW_WG_PORT} is already in use on the host. Set WG_PORT to a free port." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 7. Directories and scripts
# ---------------------------------------------------------------------------
mkdir -p "$SPRW__DATA_DIR"/{data,secrets,scripts}
chmod 700 "$SPRW__DATA_DIR/secrets" "$SPRW__DATA_DIR/data"
cp -a "$TEMPLATE_DIR/entrypoint.sh" "$SPRW__DATA_DIR/scripts/entrypoint.sh"
cp -a "$TEMPLATE_DIR/wg-firewall.sh" "$SPRW__DATA_DIR/scripts/wg-firewall.sh"
chmod 755 "$SPRW__DATA_DIR/scripts/entrypoint.sh" "$SPRW__DATA_DIR/scripts/wg-firewall.sh"

umask 077
cat > "$SPRW__DATA_DIR/scripts/firewall.conf" <<FCONF
# Written by install.sh; sourced by wg-firewall.sh inside the container.
WG_IF=wg0
WG_CIDR=${SPRW_WG_IPV4_CIDR}
CUSTOMER_CIDR=${CUSTOMER_CIDR}
FCONF
chmod 600 "$SPRW__DATA_DIR/scripts/firewall.conf"

# ---------------------------------------------------------------------------
# 8. Secret env file for first-start unattended setup (never sent to Komodo)
# ---------------------------------------------------------------------------
UI_PW=$(read_cfg SPRW_WG_UI_PASSWORD)
if [ -z "$UI_PW" ] || [[ "$UI_PW" == *'!!'* ]]; then
    echo "ERROR: WG UI password missing in ${CONFIG_FILE}" >&2
    unset UI_PW
    exit 1
fi

if [ ! -f "$SPRW__DATA_DIR/secrets/wg-easy.env" ]; then
    umask 077
    cat > "$SPRW__DATA_DIR/secrets/wg-easy.env" <<ENV
INIT_ENABLED=true
INIT_USERNAME=${SPRW_WG_UI_USERNAME}
INIT_PASSWORD=${UI_PW}
INIT_HOST=${SPRW_WG_ENDPOINT}
INIT_PORT=${SPRW_WG_PORT}
INIT_DNS=${SPRW_WG_DNS}
INIT_IPV4_CIDR=${SPRW_WG_IPV4_CIDR}
INIT_IPV6_CIDR=${SPRW_WG_IPV6_CIDR}
INIT_ALLOWED_IPS=${SPRW_WG_ALLOWED_IPS}
ENV
    chmod 600 "$SPRW__DATA_DIR/secrets/wg-easy.env"
    echo "Wrote first-start init env (password not printed). After the first successful start, run wgadmin.sh finalize-init to drop INIT_* from the env file."
else
    echo "Keeping existing secrets/wg-easy.env (not overwritten)."
fi
unset UI_PW

# ---------------------------------------------------------------------------
# 9. Host firewall: allow the WireGuard UDP port in ufw if ufw is active
#    (Docker published ports often bypass ufw already; the rule makes this
#    explicit and survives a change in that interaction.)
# ---------------------------------------------------------------------------
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    if ! ufw status | grep -qE "^${SPRW_WG_PORT}/udp[[:space:]]+ALLOW"; then
        ufw allow "${SPRW_WG_PORT}/udp" comment "WireGuard ${SPRW__STACKNAME}" >/dev/null
        echo "Opened ufw allow ${SPRW_WG_PORT}/udp."
    else
        echo "ufw already allows ${SPRW_WG_PORT}/udp."
    fi
fi

echo "✅ Host preparation done for ${SPRW__STACKNAME}"
echo "📁 Data: ${SPRW__DATA_DIR}"
echo "🌐 Client subnet: ${SPRW_WG_IPV4_CIDR} (index ${SPRW_WG_SUBNET_INDEX})"
echo "🔌 UDP port: ${SPRW_WG_PORT}  |  UI: 127.0.0.1:${SPRW_WG_UI_PORT} (SSH tunnel, not Traefik)"
echo "🧭 Clients reach: this customer's network ${CUSTOMER_NET} (${CUSTOMER_CIDR}) and the VPN subnet."
echo "   Not through the tunnel (by design, for now): LAM, Komodo and other 127.0.0.1-only admin UIs (still SSH tunnel); public websites (split-tunnel)."
echo "🔒 After deploy: wgadmin.sh add-client <name>  and  wgadmin.sh export-client <name> <dir>"
