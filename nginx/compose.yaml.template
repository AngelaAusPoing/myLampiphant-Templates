# App "nginx" - compose template
# Static website served by nginx. One stack per domain: nginx_d_<domain>.
#
# Generated by app.sh from _templates_/nginx/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  nginx:
    image: ${SPRW_NGINX_IMAGE:-nginx:alpine}
    container_name: ${SPRW__STACKNAME:-nginx_d_www_example_com}
    restart: unless-stopped
    mem_limit: ${SPRW_NGINX_MEM_LIMIT:-64m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-nginx_d_www_example_com}/html:/usr/share/nginx/html:ro
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-nginx_d_www_example_com}_html:/usr/share/nginx/html:ro
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-nginx_d_www_example_com}_html:/usr/share/nginx/html:ro
    {%- endif %}
      # nginx.conf is created once by install.sh and never overwritten.
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-nginx_d_www_example_com}/nginx.conf:/etc/nginx/nginx.conf:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://127.0.0.1/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-nginx_d_www_example_com}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-nginx_d_www_example_com}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-nginx_d_www_example_com}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-nginx_d_www_example_com}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-nginx_d_www_example_com}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-nginx_d_www_example_com}.loadbalancer.server.port=80"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Limit IP access (only VPN and internal networks)
      - "traefik.http.routers.${SPRW__STACKNAME:-nginx_d_www_example_com}.middlewares=iprestrict@file"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-nginx_d_www_example_com}_html:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-nginx_d_www_example_com}/html
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-nginx_d_www_example_com}_html:
{%- endif %}

# ===================== Networks =====================
{%- if SPRW__EXTERNAL_ACCESS == "true" %}
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- elif SPRW__EXTERNAL_ACCESS == "false" %}
# Container is accessible only internally, e.g. by LAN or VPN.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- endif %}
