#!/bin/bash
# mailadmin.sh - small admin helper for the app "mailserver" (stack !!STACKNAME!!)
# Generated by app.sh from _templates_/mailserver/mailadmin.sh.template.
# Wraps docker-mailserver's `setup` command inside the running container (docker exec).
# Secrets are read from the persistent config and are never printed.
#
# Usage:
#   mailadmin.sh init                 create the postmaster mailbox (password from persistent config) + DKIM for the first domain
#   mailadmin.sh add-user <email>     create a mailbox (asks for the password)
#   mailadmin.sh add-alias <alias> <target>
#   mailadmin.sh list                 list mailboxes and aliases
#   mailadmin.sh dkim <domain>        create DKIM key (+ ARC signing) for a domain and print the DNS record
#   mailadmin.sh dns <domain>         print the DNS records a domain needs
set -euo pipefail

CONTAINER="!!STACKNAME!!"
DATA_DIR="!!DATA_DIR!!"
CONFIG_FILE="$(dirname "$DATA_DIR")/_config_/${CONTAINER}.env"
MAILHOST="!!MAILHOST!!"
MAILDOMAIN="!!MAILDOMAIN!!"
SELECTOR="!!DKIM_SELECTOR!!"

read_cfg() {
    # read one value from the persistent config without executing it
    # (strips surrounding quotes and a trailing "   # comment")
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}

setup() { docker exec "$CONTAINER" setup "$@"; }

dkim_record() {
    local domain="$1"
    local f
    f=$(ls "$DATA_DIR"/config/rspamd/dkim/*-"${SELECTOR}-${domain}".public.dns.txt 2>/dev/null | head -1 || true)
    if [ -z "$f" ]; then
        echo "No DKIM key for ${domain} yet - run: $0 dkim ${domain}" >&2
        return 1
    fi
    echo "${SELECTOR}._domainkey.${domain}. IN TXT \"$(cat "$f")\""
}

case "${1:-}" in
    init)
        pm=$(read_cfg SPRW_MAIL_POSTMASTER)
        if setup email list 2>/dev/null | grep -qF "* ${pm} "; then
            echo "Mailbox ${pm} already exists"
        else
            pw=$(read_cfg SPRW_MAIL_POSTMASTER_PASSWORD)
            if [ -z "$pw" ] || [[ "$pw" == *'!!'* ]]; then
                echo "ERROR: SPRW_MAIL_POSTMASTER_PASSWORD missing in ${CONFIG_FILE}" >&2; exit 1
            fi
            printf '%s\n%s\n' "$pw" "$pw" | docker exec -i "$CONTAINER" setup email add "$pm" >/dev/null
            unset pw
            echo "Created mailbox ${pm} (password: see SPRW_MAIL_POSTMASTER_PASSWORD in ${CONFIG_FILE})"
        fi
        # Roundcube: plugin DB schema (identity_switch). The image's own init runs before the DB config exists, so do it here (idempotent).
        if docker ps --format '{% raw %}{{.Names}}{% endraw %}' | grep -qx "${CONTAINER}-webmail"; then
            if docker exec "${CONTAINER}-webmail" test -d /var/www/html/plugins/identity_switch/SQL \
               && ! docker exec "${CONTAINER}-webmail" php -r '$d=new PDO("sqlite:/var/roundcube/db/sqlite.db"); foreach($d->query("pragma table_info(identities)") as $r) if($r[1]=="identity_switch_prefs") exit(0); exit(1);'; then
                docker exec "${CONTAINER}-webmail" sh -c 'cd /var/www/html && bin/initdb.sh --dir=plugins/identity_switch/SQL' && echo "Roundcube: identity_switch schema created"
            fi
            docker exec "${CONTAINER}-webmail" sh -c 'chown www-data:www-data /var/roundcube/db/sqlite.db && chmod 640 /var/roundcube/db/sqlite.db' || true
        fi
        "$0" dkim "$MAILDOMAIN"
        ;;
    add-user)
        [ -n "${2:-}" ] || { echo "usage: $0 add-user <email>" >&2; exit 1; }
        docker exec -it "$CONTAINER" setup email add "$2"
        ;;
    add-alias)
        [ -n "${3:-}" ] || { echo "usage: $0 add-alias <alias> <target>" >&2; exit 1; }
        setup alias add "$2" "$3"
        ;;
    list)
        setup email list
        setup alias list || true
        ;;
    dkim)
        domain="${2:?usage: $0 dkim <domain>}"
        if ! ls "$DATA_DIR"/config/rspamd/dkim/*-"${SELECTOR}-${domain}".private.txt >/dev/null 2>&1; then
            setup config dkim keytype rsa keysize 2048 selector "$SELECTOR" domain "$domain" >/dev/null
        fi
        # ARC signing uses the same keys/selectors as DKIM signing
        if [ -f "$DATA_DIR/config/rspamd/override.d/dkim_signing.conf" ]; then
            cp "$DATA_DIR/config/rspamd/override.d/dkim_signing.conf" "$DATA_DIR/config/rspamd/override.d/arc.conf"
            docker exec "$CONTAINER" sh -c 'cp /tmp/docker-mailserver/rspamd/override.d/arc.conf /etc/rspamd/override.d/arc.conf && chown _rspamd:_rspamd /etc/rspamd/override.d/arc.conf && supervisorctl restart rspamd >/dev/null'
        fi
        dkim_record "$domain"
        ;;
    dns)
        domain="${2:?usage: $0 dns <domain>}"
        echo "; DNS records for ${domain} (mail host ${MAILHOST})"
        echo "${domain}. IN MX 10 ${MAILHOST}."
        echo "${domain}. IN TXT \"v=spf1 mx -all\""
        echo "_dmarc.${domain}. IN TXT \"v=DMARC1; p=none; rua=mailto:postmaster@${domain}\""
        dkim_record "$domain" || true
        echo "; plus: A record for ${MAILHOST} and PTR/rDNS of the server IP -> ${MAILHOST}"
        ;;
    *)
        sed -n '2,15p' "$0"
        exit 1
        ;;
esac
