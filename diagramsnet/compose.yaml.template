# App "diagramsnet" - compose template
# draw.io / diagrams.net web editor (Tomcat). One stack per customer: diagramsnet_c_<customer>.
# Image: jgraph/drawio (official, multi-arch incl. linux/arm64). No database, no data volume:
# diagrams are stored by the browser (device, download) or in the storage the user selects.
#
# Generated by app.sh from _templates_/diagramsnet/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   AUTH_PROTECT:    false | true   (Traefik ForwardAuth via host Authelia = LDAP login)
#   EXTERNAL_ACCESS: true  | false  (false = only IPALLOW_RANGES, e.g. VPN/LAN)
services:
  diagramsnet:
    image: !!DIAGRAMSNET_IMAGE!!
    container_name: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!DIAGRAMSNET_MEM_LIMIT!!
    environment:
      - TZ=!!TIMEZONE!!
      - JAVA_OPTS=-Xms64m -Xmx!!JAVA_MAX_HEAP!!m -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m
      - DRAWIO_BASE_URL=https://!!APPDOMAIN!!
      - DRAWIO_SERVER_URL=https://!!APPDOMAIN!!/
      # Tomcat speaks plain HTTP behind Traefik; no certificate inside the container.
      - LETS_ENCRYPT_ENABLED=false
    networks:
      - proxy-shared
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS -o /dev/null http://127.0.0.1:8080/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      # Limit access to VPN / internal source ranges (middleware defined by this stack)
      - "traefik.http.middlewares.!!STACKNAME!!-ipallow.ipallowlist.sourcerange=!!IPALLOW_RANGES!!"
      {%- endif %}
      {%- if AUTH_PROTECT == "true" and EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow,authelia@docker"
      {%- elif AUTH_PROTECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=authelia@docker"
      {%- elif EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow"
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8080"
      - "traefik.docker.network=proxy-shared"

networks:
  proxy-shared:
    external: true
    name: proxy-shared
