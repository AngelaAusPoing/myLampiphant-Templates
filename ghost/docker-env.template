# === myLampiphant variables ===
# This file is sent to Komodo as the stack .env. Generated secrets belong here
# and must not be committed.
SPRW__CUSTOMER=!!CUSTOMER!!
SPRW__APPDOMAIN=!!APPDOMAIN!!
SPRW__STACKNAME=!!STACKNAME!!

# === Images and memory limits ===
SPRW_GHOST_IMAGE=!!GHOST_IMAGE!!
SPRW_GHOST_DB_IMAGE=!!DB_IMAGE!!
SPRW_GHOST_MEM_LIMIT=!!GHOST_MEM_LIMIT!!
SPRW_GHOST_DB_MEM_LIMIT=!!DB_MEM_LIMIT!!
SPRW_GHOST_INNODB_BUFFER_POOL=!!INNODB_BUFFER_POOL!!
SPRW_GHOST_NODE_MAX_OLD_SPACE=!!NODE_MAX_OLD_SPACE!!
SPRW_GHOST_TIMEZONE=!!TIMEZONE!!

# === Database ===
SPRW_GHOST_DB_NAME=ghost
SPRW_GHOST_DB_USER=ghost
SPRW_GHOST_DB_ROOT_PASSWORD=!!NEW_PASSWORD!!
SPRW_GHOST_DB_PASSWORD=!!NEW_PASSWORD!!

# === Mail (SMTP via the host mailserver). Leave MAIL_ENABLED=false until
# a real mailbox exists; do not invent credentials here. ===
SPRW_GHOST_MAIL_ENABLED=!!MAIL_ENABLED!!
SPRW_GHOST_MAIL_HOST=!!MAIL_HOST!!
SPRW_GHOST_MAIL_PORT=!!MAIL_PORT!!
SPRW_GHOST_MAIL_SECURE=!!MAIL_SECURE!!
SPRW_GHOST_MAIL_REQUIRE_TLS=!!MAIL_REQUIRE_TLS!!
SPRW_GHOST_MAIL_USER=!!MAIL_USER!!
SPRW_GHOST_MAIL_PASSWORD=!!MAIL_PASSWORD!!
SPRW_GHOST_MAIL_FROM=!!MAIL_FROM!!
