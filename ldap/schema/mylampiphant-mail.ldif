# Mail attributes used by docker-mailserver LDAP mode and optional quota.
# Loaded into cn=schema,cn=config on first start. Private OID arc 1.3.6.1.4.1.55555.
dn: cn=mylampiphant-mail,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: mylampiphant-mail
olcAttributeTypes: ( 1.3.6.1.4.1.55555.1.1.1 NAME 'mailEnabled'
  DESC 'Whether this mail object is active'
  EQUALITY booleanMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.55555.1.1.2 NAME 'mailAlias'
  DESC 'Additional recipient address forwarded to mail'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )
olcAttributeTypes: ( 1.3.6.1.4.1.55555.1.1.3 NAME 'mailGroupMember'
  DESC 'Group address that delivers to this mailbox'
  EQUALITY caseIgnoreIA5Match
  SUBSTR caseIgnoreIA5SubstringsMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 )
olcAttributeTypes: ( 1.3.6.1.4.1.55555.1.1.4 NAME 'mailQuota'
  DESC 'Optional mailbox quota (bytes or DMS-style limit), unused until quotas work with LDAP'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.55555.1.2.1 NAME 'lampiphantMailAccount'
  DESC 'Auxiliary mail attributes for a mailbox user'
  SUP top AUXILIARY
  MAY ( mail $ mailAlias $ mailEnabled $ mailGroupMember $ mailQuota ) )
olcObjectClasses: ( 1.3.6.1.4.1.55555.1.2.2 NAME 'lampiphantMailAlias'
  DESC 'Standalone alias/forward: mailAlias is the public address, mail is the destination'
  SUP top AUXILIARY
  MUST ( mail $ mailAlias )
  MAY ( mailEnabled ) )
