# === myLampiphant variables ===
# This file is sent to Komodo as the stack .env. Generated secrets belong here
# and must not be committed.
SPRW__CUSTOMER=!!CUSTOMER!!
SPRW__APPDOMAIN=!!APPDOMAIN!!
SPRW__STACKNAME=!!STACKNAME!!

# === Images and memory limits (defaults; override in persistent config) ===
SPRW_GHOST_IMAGE=ghost:6.75.0-alpine
SPRW_GHOST_DB_IMAGE=mysql:8.4.13
SPRW_GHOST_MEM_LIMIT=384m
SPRW_GHOST_DB_MEM_LIMIT=384m
SPRW_GHOST_INNODB_BUFFER_POOL=128M
SPRW_GHOST_NODE_MAX_OLD_SPACE=280
SPRW_GHOST_TIMEZONE=Europe/Berlin

# === Database ===
SPRW_GHOST_DB_NAME=ghost
SPRW_GHOST_DB_USER=ghost
SPRW_GHOST_DB_ROOT_PASSWORD=!!NEW_PASSWORD!!
SPRW_GHOST_DB_PASSWORD=!!NEW_PASSWORD!!

# === Mail (SMTP via the host mailserver). Leave MAIL_ENABLED=false until
# a real mailbox exists; do not invent credentials here. ===
SPRW_GHOST_MAIL_ENABLED=false
SPRW_GHOST_MAIL_HOST=mail.lapha.de
SPRW_GHOST_MAIL_PORT=587
SPRW_GHOST_MAIL_SECURE=false
SPRW_GHOST_MAIL_REQUIRE_TLS=true
SPRW_GHOST_MAIL_USER=
SPRW_GHOST_MAIL_PASSWORD=
SPRW_GHOST_MAIL_FROM=Ghost <noreply@!!APPDOMAIN!!>
