# myLampiphant app "matrix" - compose template
# Synapse + PostgreSQL 16 + Redis + Element Web + well-known nginx.
# One stack per homeserver domain: matrix_d_<apex_normalized>.
#
# Generated by app.sh from _templates_/matrix/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Hostnames:
#   Synapse  https://matrix.<APPDOMAIN>     (client + federation on 443)
#   Element  https://chat.<APPDOMAIN>
#   well-known on the apex: /.well-known/matrix/{client,server}
# The well-known Traefik rule uses priority 100 so it can coexist with a
# website (e.g. WordPress) that already uses Host(<APPDOMAIN>).
services:
  postgres:
    image: ${SPRW_MATRIX_POSTGRES_IMAGE:-postgres:16.15-alpine}
    container_name: ${SPRW__STACKNAME:-matrix_d_example_com}_postgres
    restart: unless-stopped
    mem_limit: ${SPRW_MATRIX_POSTGRES_MEM_LIMIT:-256m}
    networks:
      - customer-net
    command:
      - -c
      - shared_buffers=64MB
      - -c
      - max_connections=100
      - -c
      - log_min_duration_statement=1000
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-matrix_d_example_com}_postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-matrix_d_example_com}_postgres:/var/lib/postgresql/data
    {%- endif %}
    environment:
      - POSTGRES_USER=${SPRW_MATRIX_POSTGRES_USER:-synapse}
      - POSTGRES_PASSWORD=${SPRW_MATRIX_POSTGRES_PASSWORD}
      - POSTGRES_DB=${SPRW_MATRIX_POSTGRES_DB:-synapse}
      - POSTGRES_INITDB_ARGS=--encoding=UTF8 --lc-collate=C --lc-ctype=C
      - TZ=${SPRW_MATRIX_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${SPRW_MATRIX_POSTGRES_USER:-synapse} -d ${SPRW_MATRIX_POSTGRES_DB:-synapse}"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s

  redis:
    image: ${SPRW_MATRIX_REDIS_IMAGE:-redis:7.4.12-alpine}
    container_name: ${SPRW__STACKNAME:-matrix_d_example_com}_redis
    restart: unless-stopped
    mem_limit: ${SPRW_MATRIX_REDIS_MEM_LIMIT:-64m}
    networks:
      - customer-net
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  synapse:
    image: ${SPRW_MATRIX_SYNAPSE_IMAGE:-matrixdotorg/synapse:v1.164.2}
    container_name: ${SPRW__STACKNAME:-matrix_d_example_com}_synapse
    restart: unless-stopped
    mem_limit: ${SPRW_MATRIX_SYNAPSE_MEM_LIMIT:-768m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/synapse:/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-matrix_d_example_com}_synapse:/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-matrix_d_example_com}_synapse:/data
    {%- endif %}
    environment:
      - TZ=${SPRW_MATRIX_TIMEZONE:-Europe/Berlin}
      - SYNAPSE_CACHE_FACTOR=0.5
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8008/health', timeout=5)\""]
      interval: 15s
      timeout: 8s
      retries: 12
      start_period: 180s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.rule=Host(`${SPRW_MATRIX_SYNAPSE_HOST}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.loadbalancer.server.port=8008"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Limit IP access (only VPN and internal networks). Public federation needs EXTERNAL_ACCESS=true.
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-synapse.middlewares=iprestrict@file"
      {%- endif %}

  element:
    image: ${SPRW_MATRIX_ELEMENT_IMAGE:-vectorim/element-web:v1.12.33}
    container_name: ${SPRW__STACKNAME:-matrix_d_example_com}_element
    restart: unless-stopped
    mem_limit: ${SPRW_MATRIX_ELEMENT_MEM_LIMIT:-64m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    # Config is a single file created by install.sh; always bind-mount it
    # (VOLUME_MODE only applies to Synapse/Postgres data directories).
    volumes:
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/element/config.json:/app/config.json:ro
    environment:
      - TZ=${SPRW_MATRIX_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-element.rule=Host(`${SPRW_MATRIX_ELEMENT_HOST}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-element.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-element.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-element.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-element.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-matrix_d_example_com}-element.loadbalancer.server.port=80"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-element.middlewares=iprestrict@file"
      {%- endif %}

  wellknown:
    image: ${SPRW_MATRIX_WELLKNOWN_IMAGE:-nginx:1.29-alpine}
    container_name: ${SPRW__STACKNAME:-matrix_d_example_com}_wellknown
    restart: unless-stopped
    mem_limit: ${SPRW_MATRIX_WELLKNOWN_MEM_LIMIT:-32m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    # Config files and the static well-known tree are created by install.sh
    # and always use absolute bind mounts.
    volumes:
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/wellknown/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/wellknown/www:/var/www:ro
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/.well-known/matrix/server || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.rule=Host(`${SPRW__APPDOMAIN}`) && PathPrefix(`/.well-known/matrix`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.entrypoints=websecure"
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.priority=100"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.loadbalancer.server.port=80"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-matrix_d_example_com}-wellknown.middlewares=iprestrict@file"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-matrix_d_example_com}_postgres:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/postgres

  ${SPRW__STACKNAME:-matrix_d_example_com}_synapse:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-matrix_d_example_com}/synapse

{%- endif %}

# ===================== Networks =====================
# customer-net: Synapse + PostgreSQL + Redis (created by ensure-networks.sh / app.sh if missing)
# proxy-shared: Traefik + public frontends only; the database and Redis stay off this network
{%- if SPRW__EXTERNAL_ACCESS == "true" %}
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- elif SPRW__EXTERNAL_ACCESS == "false" %}
# Container is accessible only internally, e.g. by LAN or VPN.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- endif %}
