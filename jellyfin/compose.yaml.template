# App "jellyfin" - compose template
# Jellyfin media server. Single instance per customer: jellyfin_c_<customer>.
# No database container (embedded SQLite in /config).
# Image: jellyfin/jellyfin (official, multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/jellyfin/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Note for small ARM servers (e.g. 2 vCPU, no GPU): there is no hardware
# transcoding. Prefer clients that can play the files directly (Direct Play);
# software transcoding of HD video is slow and is capped by cpus/mem_limit below.
#
# Options (Docusaurus buttons / Jinja2):
#   SPRW_JELLYFIN_AUTH: plain | ldap
#     plain = Jellyfin's own user accounts (default)
#     ldap  = also attach the host LDAP network (ldap-shared) for the
#             "LDAP Authentication" plugin (installed and configured in the Jellyfin UI)
services:
  jellyfin:
    image: ${SPRW_JELLYFIN_IMAGE:-jellyfin/jellyfin:12.4}
    container_name: ${SPRW__STACKNAME:-jellyfin_c_customer_directory}
    restart: unless-stopped
    user: "${SPRW_JELLYFIN_PUID:-1000}:${SPRW_JELLYFIN_PGID:-1000}"
    mem_limit: ${SPRW_JELLYFIN_MEM_LIMIT:-1024m}
    cpus: ${SPRW_JELLYFIN_CPUS:-1.5}
    networks:
      - proxy-shared
      - customer-net
      {%- if SPRW_JELLYFIN_AUTH == "ldap" %}
      - ldap-shared
      {%- elif SPRW_JELLYFIN_AUTH == "plain" %}
      # plain: Jellyfin's own user accounts, no LDAP network
      {%- endif %}
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-jellyfin_c_customer_directory}/config:/config
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-jellyfin_c_customer_directory}/cache:/cache
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_config:/config
      - ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_cache:/cache
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_config:/config
      - ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_cache:/cache
    {%- endif %}
      # Media library on the host (read-only; Jellyfin keeps metadata in /config).
      - ${SPRW_JELLYFIN_MEDIA_DIR}:/media:ro
    environment:
      - TZ=${SPRW_JELLYFIN_TIMEZONE:-Europe/Berlin}
      - JELLYFIN_PublishedServerUrl=https://${SPRW__APPDOMAIN}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:8096/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.http.routers.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.loadbalancer.server.port=8096"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      # Only VPN and internal networks. The middleware is defined here, no file provider needed.
      - "traefik.http.middlewares.${SPRW__STACKNAME:-jellyfin_c_customer_directory}-iprestrict.ipallowlist.sourcerange=${SPRW_JELLYFIN_INTERNAL_SOURCERANGE}"
      - "traefik.http.routers.${SPRW__STACKNAME:-jellyfin_c_customer_directory}.middlewares=${SPRW__STACKNAME:-jellyfin_c_customer_directory}-iprestrict"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_config:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-jellyfin_c_customer_directory}/config

  ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_cache:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-jellyfin_c_customer_directory}/cache
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_config:
  ${SPRW__STACKNAME:-jellyfin_c_customer_directory}_cache:
{%- endif %}

# ===================== Networks =====================
# proxy-shared: Traefik (always attached; EXTERNAL_ACCESS=false limits access with an IP allowlist)
# customer-net: other apps of the same customer (created by ensure-networks.sh if missing)
# ldap-shared:  host OpenLDAP (only with SPRW_JELLYFIN_AUTH=ldap)
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
  {%- if SPRW_JELLYFIN_AUTH == "ldap" %}
  ldap-shared:
    external: true
    name: ldap-shared
  {%- endif %}
