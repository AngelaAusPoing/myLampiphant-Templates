{%- if SPRW_POSTIZ_PROVIDER_TWITCH == "true" %}
offer "Twitch" "twitch" TWITCH_CLIENT_ID TWITCH_CLIENT_SECRET || hide "Twitch" "twitch" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_TWITCH == "false" %}
