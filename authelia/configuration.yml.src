---
# Authelia configuration generated by install.sh from configuration.yml.src.
# Secrets (jwt, session, storage encryption, LDAP bind, optional SMTP password)
# are provided via *_FILE environment variables and are not stored in this file.
# Edit the persistent config and re-run install/redeploy to regenerate this file.
# The SQLite database (/config/db.sqlite3) is not touched by regeneration.

theme: 'auto'
default_2fa_method: 'totp'

server:
  address: 'tcp://0.0.0.0:9091/'

log:
  level: 'info'
  format: 'text'

ntp:
  # Authelia also joins the internal ldap-shared network; do not fail startup
  # if the default NTP host is unreachable.
  disable_failure: true

totp:
  disable: false
  issuer: '@@TOTP_ISSUER@@'

identity_validation:
  reset_password:
    jwt_lifespan: '5 minutes'

authentication_backend:
  password_change:
    disable: true
  password_reset:
    disable: true
  refresh_interval: '5 minutes'
  ldap:
    address: '@@LDAP_SERVER_HOST@@'
    implementation: 'custom'
    timeout: '10 seconds'
    start_tls: false
    base_dn: '@@LDAP_BASE_DN@@'
    # Users live under o=<customer>/ou=people/<uid>. Search the whole tree.
    users_filter: '(&(|({username_attribute}={input})(mail={input}))(objectClass=inetOrgPerson))'
    # ou=groups exists per customer; no groups are provisioned yet.
    groups_filter: '(&(|(member={dn})(uniqueMember={dn})(memberUid={username}))(|(objectClass=groupOfNames)(objectClass=groupOfUniqueNames)(objectClass=posixGroup)))'
    user: '@@LDAP_BIND_DN@@'
    attributes:
      username: '@@LDAP_USERNAME_ATTRIBUTE@@'
      display_name: 'cn'
      mail: 'mail'
      member_of: 'memberOf'
      group_name: 'cn'

access_control:
  default_policy: 'deny'
  rules:
@@ACCESS_RULES@@

session:
  name: 'authelia_session'
  same_site: 'lax'
  inactivity: '5 minutes'
  expiration: '1 hour'
  remember_me: '1 month'
  cookies:
@@COOKIES@@
@@REDIS_BLOCK@@

storage:
  local:
    path: '/config/db.sqlite3'

notifier:
  disable_startup_check: true
@@NOTIFIER_BLOCK@@
