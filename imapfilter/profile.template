SPRW_IMAPFILTER_TEST=!!TEST!!
SPRW_IMAPFILTER_SLEEP=!!SLEEP!!
SPRW_IMAPFILTER_MEMORY_LIMIT=!!MEMORY_LIMIT!!
SPRW_IMAPFILTER_TIMEZONE=!!TIMEZONE!!
