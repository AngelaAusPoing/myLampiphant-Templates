#!/bin/bash
# Odoo Migration für !!CUSTOMERNAME!!

set -euo pipefail

CUSTOMER="!!CUSTOMERNAME!!"
APPDOMAIN="!!APPDOMAIN!!"
DATA_DIR="!!DATA_DIR!!"

echo "Odoo Migration für ${CUSTOMER} (${APPDOMAIN})..."

if [ -d "$DATA_DIR/odoo-data" ]; then
    BACKUP_DIR="${DATA_DIR}/backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    cp -r "$DATA_DIR/odoo-data" "$BACKUP_DIR/"
    echo "✅ Backup erstellt: $BACKUP_DIR"
fi

echo "✅ Migration vorbereitet"
echo "🔧 Zugriff auf Datenbank über: https://${APPDOMAIN}"
