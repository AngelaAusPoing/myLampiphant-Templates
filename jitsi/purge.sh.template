#!/bin/bash
# Host-side cleanup for the app "jitsi". Generated by app.sh from the template.
# Does not print secret values.

set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"

{%- if CUSTOMER == "_host_" %}
echo "Purging host Jitsi JVB data in ${SPRW__DATA_DIR} ..."
echo "WARNING: this removes the shared videobridge data and all customer XMPP drop-ins."
echo "Customer meeting stacks will no longer have a bridge until the host app is reinstalled."
rm -rf "$SPRW__DATA_DIR/jvb" "$SPRW__DATA_DIR/xmpp-servers" "$SPRW__DATA_DIR/scripts" "$SPRW__DATA_DIR/secrets"
echo "Host Jitsi data removed."
{%- else %}
HOST_DATA="/opt/docker-data/_host_/jitsi"
DROPIN="${HOST_DATA}/xmpp-servers/${SPRW__STACKNAME}.conf"

if [ -f "$DROPIN" ]; then
    rm -f "$DROPIN"
    echo "Removed host JVB drop-in for ${SPRW__STACKNAME}."
fi

if [ -x "${HOST_DATA}/scripts/assemble-jvb-xmpp.sh" ]; then
    JITSI_JVB_CONFIG_DIR="${HOST_DATA}/jvb" \
    JITSI_XMPP_SERVERS_DIR="${HOST_DATA}/xmpp-servers" \
        "${HOST_DATA}/scripts/assemble-jvb-xmpp.sh"
fi

if docker container inspect jitsi >/dev/null 2>&1; then
    echo "Restarting host JVB so it drops this customer's XMPP connection."
    echo "Ongoing meetings on the shared bridge will be interrupted."
    docker restart jitsi >/dev/null
fi

rm -rf "$SPRW__DATA_DIR/secrets"
echo "Customer Jitsi host-side cleanup done for ${SPRW__STACKNAME}."
{%- endif %}
