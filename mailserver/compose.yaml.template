{#- ============================================================================
    myLampiphant app "mailserver" – compose template
    docker-mailserver (Postfix, Dovecot + Sieve/ManageSieve, Rspamd + Redis, fail2ban)
    + Unbound (local recursive resolver for DNSBL/RBL lookups)
    + cert dumper (exports ONLY the mail host certificate from Traefik's acme.json)
    + Roundcube (optional, toggle ENABLE_WEBMAIL) + imapfilter (optional, toggle ENABLE_IMAPFILTER)

    Toggles (true/false) come from the persistent config (SPRW_MAIL_ENABLE_*), exported by app.sh
    under their bare name (ENABLE_*); the default applies if a toggle is not set.
============================================================================ -#}
{%- set WEBMAIL = ENABLE_WEBMAIL | default("true") %}
{%- set IMAPFILTER = ENABLE_IMAPFILTER | default("false") %}
{%- set POP3 = ENABLE_POP3 | default("false") %}
{%- set CLAMAV = ENABLE_CLAMAV | default("false") %}
{%- set FAIL2BAN = ENABLE_FAIL2BAN | default("true") %}
{%- set GREYLISTING = ENABLE_GREYLISTING | default("true") %}
{%- set NEURAL = ENABLE_NEURAL | default("false") %}
{%- set PROVISIONER = ACCOUNT_PROVISIONER | default("FILE") %}
# Generated by app.sh from _templates_/mailserver/compose.yaml.template - do not edit, edit the template or the persistent config.
services:

  # ======================================================================
  # Mail server: Postfix (25, 587), Dovecot (993, optional 995, 4190 internal), Rspamd, Redis, fail2ban
  # ======================================================================
  mailserver:
    image: ghcr.io/docker-mailserver/docker-mailserver:!!DMS_VERSION!!
    container_name: !!STACKNAME!!
    hostname: !!MAILHOST!!
    restart: unless-stopped
    stop_grace_period: 1m
    ports:
      # Only these ports are published. 143 (IMAP), 465 (SMTPS) and 4190 (ManageSieve) stay internal.
      - "!!BIND_IP!!:25:25"
      - "!!BIND_IP!!:587:587"
      - "!!BIND_IP!!:993:993"
      {%- if POP3 == "true" %}
      - "!!BIND_IP!!:995:995"
      {%- endif %}
    dns:
      - !!RESOLVER_IP!!
    networks:
      mailnet:
        aliases:
          # Webmail/imapfilter connect to the real mail host name, so the TLS certificate matches.
          - !!MAILHOST!!
      # Shared internal networks (created by install.sh if missing, no internet):
      # ldap-shared: directory lookups; mail-shared: IMAP/SMTP for other stacks (e.g. customer Roundcube).
      ldap-shared: {}
      mail-shared:
        aliases:
          - !!MAILHOST!!
    {%- if PROVISIONER == "LDAP" %}
    env_file:
      - !!DATA_DIR!!/secrets/ldap-bind.env
    {%- endif %}
    environment:
      - TZ=!!TIMEZONE!!
      - LOG_LEVEL=info
      - ACCOUNT_PROVISIONER={{ PROVISIONER }}
      - POSTMASTER_ADDRESS=!!POSTMASTER!!
      - PERMIT_DOCKER=none                # never trust docker networks (no open relay), always require auth
      - POSTFIX_INET_PROTOCOLS=ipv4
      - DOVECOT_INET_PROTOCOLS=ipv4
      - POSTFIX_MESSAGE_SIZE_LIMIT=!!MESSAGE_SIZE_LIMIT!!
      - ENABLE_QUOTAS={% if PROVISIONER == "LDAP" %}0{% else %}1{% endif %}
      - SPOOF_PROTECTION=1
      - ENABLE_SRS=0
      # TLS: certificate exported from Traefik by the certdumper service (only the mail host)
      - SSL_TYPE=manual
      - SSL_CERT_PATH=/etc/dms-tls/fullchain.pem
      - SSL_KEY_PATH=/etc/dms-tls/privkey.pem
      - TLS_LEVEL=modern
      # Protocols
      - ENABLE_IMAP=1
      - ENABLE_POP3={% if POP3 == "true" %}1{% else %}0{% endif %}
      - ENABLE_MANAGESIEVE=1
      # Spam protection: Rspamd (DKIM signing, SPF/DMARC/ARC checks, RBLs, Bayes, greylisting) with internal Redis
      - ENABLE_RSPAMD=1
      - ENABLE_RSPAMD_REDIS=1
      - RSPAMD_LEARN=1                    # IMAPSieve: move to Junk = learn spam, Junk -> INBOX = learn ham
      - RSPAMD_GREYLISTING={% if GREYLISTING == "true" %}1{% else %}0{% endif %}
      - RSPAMD_NEURAL={% if NEURAL == "true" %}1{% else %}0{% endif %}
      - RSPAMD_CHECK_AUTHENTICATED=0
      - RSPAMD_HFILTER=1
      - MOVE_SPAM_TO_JUNK=1
      - ENABLE_DNSBL=0                    # RBLs are scored by Rspamd instead of hard postscreen rejects
      # Legacy components replaced by Rspamd - keep disabled
      - ENABLE_AMAVIS=0
      - ENABLE_SPAMASSASSIN=0
      - ENABLE_OPENDKIM=0
      - ENABLE_OPENDMARC=0
      - ENABLE_POLICYD_SPF=0
      - ENABLE_POSTGREY=0
      - ENABLE_CLAMAV={% if CLAMAV == "true" %}1{% else %}0{% endif %}
      - ENABLE_FAIL2BAN={% if FAIL2BAN == "true" %}1{% else %}0{% endif %}
      - FAIL2BAN_BLOCKTYPE=drop
      {%- if PROVISIONER == "LDAP" %}
      # LDAP: bind password comes from a host file (LDAP_BIND_PW__FILE), never from the Komodo .env
      - LDAP_SERVER_HOST=!!LDAP_SERVER_HOST!!
      - LDAP_SEARCH_BASE=!!LDAP_SEARCH_BASE!!
      - LDAP_BIND_DN=!!LDAP_BIND_DN!!
      - LDAP_BIND_PW__FILE=/run/secrets/ldap_bind_pw
      - LDAP_START_TLS=no
      - 'LDAP_QUERY_FILTER_DOMAIN=(&(|(mail=*@%s)(mailAlias=*@%s)(mailGroupMember=*@%s))(mailEnabled=TRUE))'
      - 'LDAP_QUERY_FILTER_USER=(&(objectClass=lampiphantMailAccount)(mail=%s)(mailEnabled=TRUE))'
      - 'LDAP_QUERY_FILTER_ALIAS=(&(mailAlias=%s)(mailEnabled=TRUE))'
      - 'LDAP_QUERY_FILTER_GROUP=(&(mailGroupMember=%s)(mailEnabled=TRUE))'
      - 'LDAP_QUERY_FILTER_SENDERS=(|(&(mail=%s)(mailEnabled=TRUE))(&(mailAlias=%s)(mailEnabled=TRUE)))'
      - 'DOVECOT_USER_FILTER=(&(objectClass=lampiphantMailAccount)(mail=%{user})(mailEnabled=TRUE))'
      - 'DOVECOT_PASS_FILTER=(&(objectClass=lampiphantMailAccount)(mail=%{user})(mailEnabled=TRUE))'
      - 'DOVECOT_USER_ATTRS==uid=5000,=gid=5000,=home=/var/mail/%{user | domain}/%{user | username},=mail_path=/var/mail/%{user | domain}/%{user | username}'
      - DOVECOT_PASS_ATTRS=mail=user,userPassword=password
      - DOVECOT_DEFAULT_PASS_SCHEME=CRYPT
      - DOVECOT_AUTH_BIND=yes
      - DOVECOT_PASSDB_LDAP_BIND=yes
      {%- endif %}
    volumes:
      - !!DATA_DIR!!/mail-data:/var/mail
      - !!DATA_DIR!!/mail-state:/var/mail-state
      - !!DATA_DIR!!/mail-logs:/var/log/mail
      - !!DATA_DIR!!/config:/tmp/docker-mailserver
      - !!DATA_DIR!!/tls:/etc/dms-tls:ro
      {%- if PROVISIONER == "LDAP" %}
      - !!DATA_DIR!!/secrets/ldap-bind.pw:/run/secrets/ldap_bind_pw:ro
      {%- endif %}
    {%- if FAIL2BAN == "true" %}
    cap_add:
      - NET_ADMIN
    {%- endif %}
    healthcheck:
      test: "ss --listening --tcp | grep -P 'LISTEN.+:smtp' || exit 1"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 60s
    depends_on:
      - resolver
      - certdumper

  # ======================================================================
  # Local recursive DNS resolver (Unbound). DNSBL/RBL providers like Spamhaus refuse queries
  # that come through large public/shared resolvers, so Rspamd must not use the provider's DNS.
  # ======================================================================
  resolver:
    image: docker.io/klutchell/unbound:latest
    container_name: !!STACKNAME!!-resolver
    restart: unless-stopped
    networks:
      mailnet:
        ipv4_address: !!RESOLVER_IP!!

  # ======================================================================
  # Cert dumper: reads Traefik's acme.json (read-only) and writes ONLY the certificate of the
  # mail host to <data_dir>/tls. docker-mailserver detects the change and reloads Postfix/Dovecot.
  # ======================================================================
  certdumper:
    image: docker.io/library/python:3.13-alpine
    container_name: !!STACKNAME!!-certdumper
    restart: unless-stopped
    network_mode: none
    command: ["python3", "-u", "/app/certdumper.py"]
    environment:
      - CERT_DOMAIN=!!MAILHOST!!
      - ACME_JSON=/traefik/acme.json
      - OUT_DIR=/out
      - INTERVAL=60
    volumes:
      - !!TRAEFIK_ACME_DIR!!:/traefik:ro
      - !!DATA_DIR!!/certdumper:/app:ro
      - !!DATA_DIR!!/tls:/out

  {%- if WEBMAIL == "true" %}

  # ======================================================================
  # Webmail: Roundcube (plugins: managesieve, persistent_login, identity_switch, markasjunk, archive, zipdownload)
  # Served via Traefik on !!APPDOMAIN!! - this router also makes Traefik obtain the certificate
  # for the mail host (when APPDOMAIN = MAILHOST).
  # ======================================================================
  webmail:
    image: docker.io/roundcube/roundcubemail:!!ROUNDCUBE_VERSION!!
    container_name: !!STACKNAME!!-webmail
    restart: unless-stopped
    networks:
      - mailnet
      - proxy-shared
    environment:
      - TZ=!!TIMEZONE!!
      - ROUNDCUBEMAIL_DEFAULT_HOST=ssl://!!MAILHOST!!
      - ROUNDCUBEMAIL_DEFAULT_PORT=993
      - ROUNDCUBEMAIL_SMTP_SERVER=tls://!!MAILHOST!!
      - ROUNDCUBEMAIL_SMTP_PORT=587
      - ROUNDCUBEMAIL_DB_TYPE=sqlite
      - ROUNDCUBEMAIL_SKIN=elastic
      - ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=25M
      - ROUNDCUBEMAIL_COMPOSER_PLUGINS=mfreiholz/persistent_login:dev-master,toteph42/identity_switch
      - ROUNDCUBEMAIL_PLUGINS=archive,zipdownload,managesieve,markasjunk,persistent_login,identity_switch
    volumes:
      - !!DATA_DIR!!/roundcube/db:/var/roundcube/db
      - !!DATA_DIR!!/roundcube/config:/var/roundcube/config:ro
    depends_on:
      - mailserver
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!-webmail.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-webmail.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!-webmail.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!-webmail.tls.certresolver=letsencrypt-dns"
      {%- else %}
      - "traefik.http.routers.!!STACKNAME!!-webmail.tls.certresolver=letsencrypt"
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!-webmail.loadbalancer.server.port=80"
      - "traefik.docker.network=proxy-shared"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!-webmail.middlewares=!!STACKNAME!!-iprestrict"
      - "traefik.http.middlewares.!!STACKNAME!!-iprestrict.ipallowlist.sourcerange=10.8.0.0/24,192.168.0.0/16,172.16.0.0/12,127.0.0.1/32"
      {%- endif %}
  {%- endif %}

  {%- if IMAPFILTER == "true" %}

  # ======================================================================
  # imapfilter (community image ntnn/imapfilter): moves mail across folders/accounts.
  # Config: <data_dir>/imapfilter/config.lua (contains credentials -> chmod 600, never in git)
  # ======================================================================
  imapfilter:
    image: docker.io/ntnn/imapfilter:latest-tag
    container_name: !!STACKNAME!!-imapfilter
    restart: unless-stopped
    networks:
      - mailnet
    environment:
      - TZ=!!TIMEZONE!!
      - IMAPFILTER_CONFIG_BASE=/config
      - IMAPFILTER_CONFIG=config.lua
      - IMAPFILTER_SLEEP=300
    volumes:
      - !!DATA_DIR!!/imapfilter:/config:ro
    depends_on:
      - mailserver
  {%- endif %}

networks:
  mailnet:
    name: !!STACKNAME!!_mailnet
    driver: bridge
    ipam:
      config:
        - subnet: !!MAILNET_SUBNET!!
  ldap-shared:
    external: true
  mail-shared:
    external: true
  {%- if WEBMAIL == "true" %}
  proxy-shared:
    external: true
  {%- endif %}
