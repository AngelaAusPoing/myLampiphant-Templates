{%- elif SPRW_POSTIZ_PROVIDER_LINKEDIN == "false" %}
hide "LinkedIn (Profil + Seite)" "linkedin,linkedin-page" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_REDDIT == "true" %}
offer "Reddit" "reddit" REDDIT_CLIENT_ID REDDIT_CLIENT_SECRET || hide "Reddit" "reddit" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_REDDIT == "false" %}
hide "Reddit" "reddit" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_FACEBOOK == "true" %}
offer "Facebook + Instagram (Business)" "facebook,instagram" FACEBOOK_APP_ID FACEBOOK_APP_SECRET || hide "Facebook + Instagram (Business)" "facebook,instagram" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_FACEBOOK == "false" %}
hide "Facebook + Instagram (Business)" "facebook,instagram" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_INSTAGRAM == "true" %}
offer "Instagram (Standalone)" "instagram-standalone" INSTAGRAM_APP_ID INSTAGRAM_APP_SECRET || hide "Instagram (Standalone)" "instagram-standalone" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_INSTAGRAM == "false" %}
hide "Instagram (Standalone)" "instagram-standalone" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_THREADS == "true" %}
offer "Threads" "threads" THREADS_APP_ID THREADS_APP_SECRET || hide "Threads" "threads" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_THREADS == "false" %}
hide "Threads" "threads" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_YOUTUBE == "true" %}
offer "YouTube" "youtube" YOUTUBE_CLIENT_ID YOUTUBE_CLIENT_SECRET || hide "YouTube" "youtube" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_YOUTUBE == "false" %}
hide "YouTube" "youtube" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_GMB == "true" %}
offer "Google Business Profile" "gmb" GOOGLE_GMB_CLIENT_ID GOOGLE_GMB_CLIENT_SECRET || have "YOUTUBE_CLIENT_ID YOUTUBE_CLIENT_SECRET" "Google Business Profile (YouTube OAuth client)" || hide "Google Business Profile" "gmb" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_GMB == "false" %}
hide "Google Business Profile" "gmb" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_TIKTOK == "true" %}
offer "TikTok" "tiktok" TIKTOK_CLIENT_ID TIKTOK_CLIENT_SECRET || hide "TikTok" "tiktok" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_TIKTOK == "false" %}
hide "TikTok" "tiktok" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_TIKTOK_BUSINESS == "true" %}
