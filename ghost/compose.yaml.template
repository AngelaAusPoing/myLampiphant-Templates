# myLampiphant app "ghost" - compose template
# Official Ghost (Node.js CMS) + MySQL 8. One stack per domain: ghost_d_<domain>.
#
# Generated by app.sh from _templates_/ghost/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  db:
    image: ${SPRW_GHOST_DB_IMAGE:-mysql:8.4.13}
    container_name: ${SPRW__STACKNAME:-ghost_d_www_example_com}_db
    restart: unless-stopped
    mem_limit: ${SPRW_GHOST_DB_MEM_LIMIT:-384m}
    networks:
      - customer-net
    command:
      - --innodb-buffer-pool-size=${SPRW_GHOST_INNODB_BUFFER_POOL:-128M}
      - --innodb-log-buffer-size=16M
      - --max-connections=50
      - --performance-schema=OFF
      - --skip-name-resolve
      - --disable-log-bin
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-ghost_d_www_example_com}/db:/var/lib/mysql
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-ghost_d_www_example_com}_db_data:/var/lib/mysql
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-ghost_d_www_example_com}_db_data:/var/lib/mysql
    {%- endif %}
    environment:
      - MYSQL_ROOT_PASSWORD=${SPRW_GHOST_DB_ROOT_PASSWORD}
      - MYSQL_DATABASE=${SPRW_GHOST_DB_NAME:-ghost}
      - MYSQL_USER=${SPRW_GHOST_DB_USER:-ghost}
      - MYSQL_PASSWORD=${SPRW_GHOST_DB_PASSWORD}
      - TZ=${SPRW_GHOST_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s

  ghost:
    image: ${SPRW_GHOST_IMAGE:-ghost:6.75.0-alpine}
    container_name: ${SPRW__STACKNAME:-ghost_d_www_example_com}
    restart: unless-stopped
    mem_limit: ${SPRW_GHOST_MEM_LIMIT:-384m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    {%- if SPRW__VOLUME_MODE == "bind" %}
    volumes:
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-ghost_d_www_example_com}/content:/var/lib/ghost/content
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
    volumes:
      - ${SPRW__STACKNAME:-ghost_d_www_example_com}_content:/var/lib/ghost/content
    {%- elif SPRW__VOLUME_MODE == "managed" %}
    volumes:
      - ${SPRW__STACKNAME:-ghost_d_www_example_com}_content:/var/lib/ghost/content
    {%- endif %}
    environment:
      - url=https://${SPRW__APPDOMAIN}
      - NODE_ENV=production
      - NODE_OPTIONS=--max-old-space-size=${SPRW_GHOST_NODE_MAX_OLD_SPACE:-280}
      - TZ=${SPRW_GHOST_TIMEZONE:-Europe/Berlin}
      - database__client=mysql
      - database__connection__host=db
      - database__connection__user=${SPRW_GHOST_DB_USER:-ghost}
      - database__connection__password=${SPRW_GHOST_DB_PASSWORD}
      - database__connection__database=${SPRW_GHOST_DB_NAME:-ghost}
      - security__staffDeviceVerification=${SPRW_GHOST_STAFF_DEVICE_VERIFICATION:-true}
      {%- if SPRW_GHOST_MAIL_ENABLED == "true" %}
      - mail__transport=SMTP
      - mail__options__host=${SPRW_GHOST_MAIL_HOST}
      - mail__options__port=${SPRW_GHOST_MAIL_PORT:-587}
      - mail__options__secure=${SPRW_GHOST_MAIL_SECURE:-false}
      - mail__options__requireTLS=${SPRW_GHOST_MAIL_REQUIRE_TLS:-true}
      - mail__from=${SPRW_GHOST_MAIL_FROM}
      {%- if SPRW_GHOST_MAIL_USER %}
      - mail__options__auth__user=${SPRW_GHOST_MAIL_USER}
      - mail__options__auth__pass=${SPRW_GHOST_MAIL_PASSWORD}
      {%- endif %}
      {%- endif %}
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      # List form: Komodo's YAML parser rejects the quoted flow-style command
      # (colons in the URL were parsed as mappings).
      test:
        - CMD-SHELL
        - node -e "require('http').get('http://127.0.0.1:2368/',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 90s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-ghost_d_www_example_com}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-ghost_d_www_example_com}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-ghost_d_www_example_com}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-ghost_d_www_example_com}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-ghost_d_www_example_com}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-ghost_d_www_example_com}.loadbalancer.server.port=2368"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Limit IP access (only VPN and internal networks)
      - "traefik.http.routers.${SPRW__STACKNAME:-ghost_d_www_example_com}.middlewares=iprestrict@file"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-ghost_d_www_example_com}_db_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-ghost_d_www_example_com}/db

  ${SPRW__STACKNAME:-ghost_d_www_example_com}_content:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-ghost_d_www_example_com}/content
{%- endif %}

# ===================== Networks =====================
# customer-net: Ghost + MySQL (created by ensure-networks.sh / app.sh if missing)
# proxy-shared: Traefik + web frontend only; the database stays off this network
{%- if SPRW__EXTERNAL_ACCESS == "true" %}
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- elif SPRW__EXTERNAL_ACCESS == "false" %}
# Container is accessible only internally, e.g. by LAN or VPN.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- endif %}
