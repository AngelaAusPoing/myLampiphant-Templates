# App "pollaris" - compose template
# Pollaris polls (date + classic), the software behind the current Framadate.
# One stack per customer: pollaris_c_<customer>.
#   web    - FrankenPHP serving Symfony (image built by Komodo from the compose dir)
#   worker - same image, Symfony Messenger worker (async jobs, scheduled cleanup)
#   db     - official PostgreSQL (multi-arch incl. linux/arm64)
#
# Generated by app.sh from _templates_/pollaris/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   VOLUME_MODE:  bind | named_bind | managed
#   AUTH_PROTECT: none | admin | all
#   MAIL_ENABLED: false | true  (SMTP settings are written by install.sh to secrets/pollaris.env)
services:
  web:
    build:
      context: !!COMPOSE_DIR!!/image
      dockerfile: Dockerfile
      args:
        POLLARIS_VERSION: !!POLLARIS_VERSION!!
        FRANKENPHP_IMAGE: !!FRANKENPHP_IMAGE!!
        COMPOSER_IMAGE: !!COMPOSER_IMAGE!!
    image: pollaris-local:!!POLLARIS_VERSION!!
    pull_policy: never
    container_name: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!POLLARIS_MEM_LIMIT!!
    env_file:
      - !!DATA_DIR!!/secrets/pollaris.env
    environment:
      - TZ=!!TIMEZONE!!
      - POLLARIS_RUN_MIGRATIONS=true
    networks:
      - proxy-shared
      - customer-net
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:80/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 90s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.middlewares.!!STACKNAME!!-ipallow.ipallowlist.sourcerange=!!IPALLOW_RANGES!!"
      {%- endif %}
      {%- if AUTH_PROTECT == "all" and EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow,authelia@docker"
      {%- elif AUTH_PROTECT == "all" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=authelia@docker"
      {%- elif EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=!!STACKNAME!!-ipallow"
      {%- endif %}
      {%- if AUTH_PROTECT == "admin" %}
      # Admin area only: second router with higher priority and Authelia in front.
      - "traefik.http.routers.!!STACKNAME!!-admin.rule=Host(`!!APPDOMAIN!!`) && (PathPrefix(`/admin`) || PathPrefix(`/login`))"
      - "traefik.http.routers.!!STACKNAME!!-admin.priority=100"
      - "traefik.http.routers.!!STACKNAME!!-admin.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!-admin.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!-admin.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!-admin.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.routers.!!STACKNAME!!-admin.service=!!STACKNAME!!"
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!-admin.middlewares=!!STACKNAME!!-ipallow,authelia@docker"
      {%- else %}
      - "traefik.http.routers.!!STACKNAME!!-admin.middlewares=authelia@docker"
      {%- endif %}
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=80"
      - "traefik.docker.network=proxy-shared"

  worker:
    image: pollaris-local:!!POLLARIS_VERSION!!
    pull_policy: never
    container_name: !!STACKNAME!!-worker
    restart: unless-stopped
    mem_limit: !!WORKER_MEM_LIMIT!!
    env_file:
      - !!DATA_DIR!!/secrets/pollaris.env
    environment:
      - TZ=!!TIMEZONE!!
      - POLLARIS_RUN_MIGRATIONS=false
    command: ["php", "bin/console", "messenger:consume", "async", "scheduler_default", "--time-limit=3600", "--memory-limit=96M"]
    networks:
      - customer-net
    depends_on:
      web:
        condition: service_healthy

  db:
    image: !!DB_IMAGE!!
    container_name: !!STACKNAME!!-db
    restart: unless-stopped
    mem_limit: !!DB_MEM_LIMIT!!
    env_file:
      - !!DATA_DIR!!/secrets/db.env
    environment:
      - TZ=!!TIMEZONE!!
      - POSTGRES_DB=!!DB_NAME!!
      - POSTGRES_USER=!!DB_USER!!
    command: ["postgres", "-c", "shared_buffers=32MB", "-c", "max_connections=30", "-c", "work_mem=2MB"]
    networks:
      - customer-net
    volumes:
    {%- if VOLUME_MODE == "bind" %}
      - !!DATA_DIR!!/db:/var/lib/postgresql
    {%- elif VOLUME_MODE == "named_bind" %}
      - !!STACKNAME!!_db:/var/lib/postgresql
    {%- elif VOLUME_MODE == "managed" %}
      - !!STACKNAME!!_db:/var/lib/postgresql
    {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U !!DB_USER!! -d !!DB_NAME!!"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_db:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/db
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_db:
{%- endif %}

# customer-net: web + worker + db; proxy-shared: Traefik and the web container only.
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_!!CUSTOMER!!-net
