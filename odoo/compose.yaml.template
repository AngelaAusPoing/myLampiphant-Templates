services:
  postgres:
    image: postgres:16-alpine
    container_name: ${STACKNAME:-odoo_d_www_example_com}_db
    restart: unless-stopped
    networks:
      - proxy-shared
    volumes:
      - /opt/docker-data/${CUSTOMERNAME:-customer_directory}/${STACKNAME:-odoo_d_www_example_com}/postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_USER=odoo
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=odoo
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo -d odoo"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

  odoo:
    image: odoo:18.0
    container_name: ${STACKNAME:-odoo_d_www_example_com}
    restart: unless-stopped
    networks:
      - proxy-shared
    volumes:
      - /opt/docker-data/${CUSTOMERNAME:-customer_directory}/${STACKNAME:-odoo_d_www_example_com}/odoo-data:/var/lib/odoo
      - /opt/docker-data/${CUSTOMERNAME:-customer_directory}/${STACKNAME:-odoo_d_www_example_com}/addons:/mnt/extra-addons
      - /opt/docker-data/${CUSTOMERNAME:-customer_directory}/${STACKNAME:-odoo_d_www_example_com}/init-odoo.sh:/usr/local/bin/init-odoo.sh:ro
    environment:
      - HOST=postgres
      - USER=odoo
      - PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_USER=odoo
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - PORT=5432
      - PROXY_MODE=True
    command: ["/usr/local/bin/init-odoo.sh"]
    depends_on:
      postgres:
        condition: service_healthy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${STACKNAME:-odoo_d_www_example_com}.rule=Host(`${APPDOMAIN}`)"
      - "traefik.http.routers.${STACKNAME:-odoo_d_www_example_com}.entrypoints=websecure"
      - "traefik.http.routers.${STACKNAME:-odoo_d_www_example_com}.tls.certresolver=letsencrypt"
      - "traefik.http.services.${STACKNAME:-odoo_d_www_example_com}.loadbalancer.server.port=8069"
      - "traefik.docker.network=proxy-shared"

networks:
  proxy-shared:
    external: true
