# App "joplin" - compose template
# Joplin Server (sync server for the Joplin note apps) + PostgreSQL.
# Single instance per customer: joplin_c_<customer>.
# Images: joplin/server and postgres:alpine (both multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/joplin/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   SPRW_JOPLIN_AUTH: plain | ldap
#     plain = Joplin's own accounts (admin creates users; default)
#     ldap  = login against the host OpenLDAP (users log in with their e-mail
#             address, accounts are created on first login). The read-only bind
#             password is read from a file at start and never written to .env.
#   SPRW_JOPLIN_SIGNUP: false | true  (self-registration of new accounts)
services:
  db:
    image: ${SPRW_JOPLIN_DB_IMAGE:-postgres:17.12-alpine}
    container_name: ${SPRW__STACKNAME:-joplin_c_customer_directory}_db
    restart: unless-stopped
    mem_limit: ${SPRW_JOPLIN_DB_MEM_LIMIT:-256m}
    networks:
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-joplin_c_customer_directory}/postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-joplin_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-joplin_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- endif %}
    environment:
      - POSTGRES_USER=${SPRW_JOPLIN_DB_USER:-joplin}
      - POSTGRES_PASSWORD=${SPRW_JOPLIN_DB_PASSWORD}
      - POSTGRES_DB=${SPRW_JOPLIN_DB_NAME:-joplin}
      - TZ=${SPRW_JOPLIN_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${SPRW_JOPLIN_DB_USER:-joplin} -d ${SPRW_JOPLIN_DB_NAME:-joplin}"]
      interval: 10s
      timeout: 5s
      retries: 6

  joplin:
    image: ${SPRW_JOPLIN_IMAGE:-joplin/server:3.7.6}
    container_name: ${SPRW__STACKNAME:-joplin_c_customer_directory}
    restart: unless-stopped
    mem_limit: ${SPRW_JOPLIN_MEM_LIMIT:-512m}
    networks:
      - proxy-shared
      - customer-net
      - backend
      {%- if SPRW_JOPLIN_AUTH == "ldap" %}
      - ldap-shared
      {%- elif SPRW_JOPLIN_AUTH == "plain" %}
      # plain: Joplin's own accounts, no LDAP network
      {%- endif %}
    {%- if SPRW_JOPLIN_AUTH == "ldap" %}
    volumes:
      # Copy of the host read-only bind secret (created by install.sh, readable only by the joplin user).
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-joplin_c_customer_directory}/secrets/ldap-readonly.pw:/run/secrets/ldap-readonly.pw:ro
    # Image entrypoint is tini; this replaces only CMD (yarn start-prod) and loads the bind password from the file.
    command:
      - sh
      - -c
      - 'export LDAP_1_BIND_PW="$$(cat /run/secrets/ldap-readonly.pw)"; exec yarn start-prod'
    {%- endif %}
    environment:
      - APP_PORT=22300
      - APP_BASE_URL=https://${SPRW__APPDOMAIN}
      - TZ=${SPRW_JOPLIN_TIMEZONE:-Europe/Berlin}
      - DB_CLIENT=pg
      - POSTGRES_HOST=db
      - POSTGRES_PORT=5432
      - POSTGRES_USER=${SPRW_JOPLIN_DB_USER:-joplin}
      - POSTGRES_PASSWORD=${SPRW_JOPLIN_DB_PASSWORD}
      - POSTGRES_DATABASE=${SPRW_JOPLIN_DB_NAME:-joplin}
      {%- if SPRW_JOPLIN_SIGNUP == "true" %}
      - SIGNUP_ENABLED=true
      {%- else %}
      - SIGNUP_ENABLED=false
      {%- endif %}
      - NODE_OPTIONS=--max-old-space-size=${SPRW_JOPLIN_NODE_MAX_OLD_SPACE:-384}
      {%- if SPRW_JOPLIN_AUTH == "ldap" %}
      - LDAP_1_ENABLED=true
      - LDAP_1_USER_AUTO_CREATION=true
      - LDAP_1_HOST=${SPRW_JOPLIN_LDAP_SERVER}
      - LDAP_1_BASE_DN=${SPRW_JOPLIN_LDAP_BASE_DN}
      - LDAP_1_BIND_DN=${SPRW_JOPLIN_LDAP_BIND_DN}
      - LDAP_1_MAIL_ATTRIBUTE=mail
      - LDAP_1_FULLNAME_ATTRIBUTE=displayName
      {%- endif %}
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test:
        - CMD-SHELL
        - node -e "require('http').get('http://127.0.0.1:22300/api/ping',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.http.routers.${SPRW__STACKNAME:-joplin_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-joplin_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-joplin_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-joplin_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-joplin_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-joplin_c_customer_directory}.loadbalancer.server.port=22300"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      # Only VPN and internal networks. The middleware is defined here, no file provider needed.
      - "traefik.http.middlewares.${SPRW__STACKNAME:-joplin_c_customer_directory}-iprestrict.ipallowlist.sourcerange=${SPRW_JOPLIN_INTERNAL_SOURCERANGE}"
      - "traefik.http.routers.${SPRW__STACKNAME:-joplin_c_customer_directory}.middlewares=${SPRW__STACKNAME:-joplin_c_customer_directory}-iprestrict"
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-joplin_c_customer_directory}_postgres:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-joplin_c_customer_directory}/postgres
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-joplin_c_customer_directory}_postgres:
{%- endif %}

# ===================== Networks =====================
# proxy-shared: Traefik (always attached; EXTERNAL_ACCESS=false limits access with an IP allowlist)
# customer-net: other apps of the same customer (created by ensure-networks.sh if missing)
# backend:      stack-local, internal network for PostgreSQL (no outbound access)
# ldap-shared:  host OpenLDAP (only with SPRW_JOPLIN_AUTH=ldap)
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
  backend:
    name: ${SPRW__STACKNAME:-joplin_c_customer_directory}_backend
    internal: true
  {%- if SPRW_JOPLIN_AUTH == "ldap" %}
  ldap-shared:
    external: true
    name: ldap-shared
  {%- endif %}
