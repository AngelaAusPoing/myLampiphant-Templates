#!/bin/bash
# install.sh for the app "pollaris" - generated by app.sh from _templates_/pollaris/install.sh.template
# Prepares the host side (directories, secret env files, build context) BEFORE
# Komodo builds and deploys the stack. Secrets are read from the persistent
# config, written chmod 600 under <data_dir>/secrets/ and never printed.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW_POLLARIS_DB_NAME="!!DB_NAME!!"
SPRW_POLLARIS_DB_USER="!!DB_USER!!"
SPRW_POLLARIS_APP_NAME="!!POLLARIS_APP_NAME!!"
SPRW_POLLARIS_TIMEZONE="!!TIMEZONE!!"
SPRW_POLLARIS_REQUIRE_EMAILS="!!REQUIRE_EMAILS!!"
SPRW_POLLARIS_POLL_EXPIRES_COMPLETED="!!POLL_EXPIRES_COMPLETED!!"
SPRW_POLLARIS_MAIL_ENABLED="!!MAIL_ENABLED!!"
TEMPLATE_DIR="/opt/docker/_templates_/pollaris"
CONFIG_FILE="$(dirname "$SPRW__DATA_DIR")/_config_/${SPRW__STACKNAME}.env"

echo "Preparing pollaris ${SPRW__STACKNAME} (${SPRW__APPDOMAIN}) ..."

# 1. Refuse to continue with unresolved placeholders
missing=0
for v in SPRW__CUSTOMER SPRW__STACKNAME SPRW__APPDOMAIN SPRW__DATA_DIR SPRW__COMPOSE_DIR \
         SPRW_POLLARIS_DB_NAME SPRW_POLLARIS_DB_USER SPRW_POLLARIS_APP_NAME SPRW_POLLARIS_TIMEZONE \
         SPRW_POLLARIS_REQUIRE_EMAILS SPRW_POLLARIS_POLL_EXPIRES_COMPLETED SPRW_POLLARIS_MAIL_ENABLED; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in ${CONFIG_FILE} or pass --var." >&2
        missing=1
    fi
done
[ "$missing" -eq 0 ] || exit 1

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}
is_set() { [ -n "$1" ] && [[ "$1" != *'!!'* ]]; }

# 2. Networks (idempotent)
# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_shared_networks
ensure_customer_network "$SPRW__CUSTOMER"

# 3. Directories and build context
mkdir -p "$SPRW__COMPOSE_DIR/image" "$SPRW__DATA_DIR/db" "$SPRW__DATA_DIR/secrets"
chmod 700 "$SPRW__DATA_DIR/secrets"
cp -a "$TEMPLATE_DIR/Dockerfile" "$SPRW__COMPOSE_DIR/image/Dockerfile"
cp -a "$TEMPLATE_DIR/pollaris-entrypoint.sh" "$SPRW__COMPOSE_DIR/image/pollaris-entrypoint.sh"
chmod 755 "$SPRW__COMPOSE_DIR/image/pollaris-entrypoint.sh"
# Official postgres image runs as postgres (uid 70 on alpine)
chown -R 70:70 "$SPRW__DATA_DIR/db"

# 4. Secret env files (derived from the persistent config; rewritten on every
#    install so a changed mail setting is picked up)
db_pw=$(read_cfg SPRW_POLLARIS_DB_PASSWORD)
app_secret=$(read_cfg SPRW_POLLARIS_APP_SECRET)
if ! is_set "$db_pw" || ! is_set "$app_secret"; then
    echo "ERROR: SPRW_POLLARIS_DB_PASSWORD / SPRW_POLLARIS_APP_SECRET missing in ${CONFIG_FILE}" >&2
    unset db_pw app_secret
    exit 1
fi

mailer_dsn="null://null"
mail_from="noreply@${SPRW__APPDOMAIN}"
if [ "$SPRW_POLLARIS_MAIL_ENABLED" = "true" ]; then
    mail_host=$(read_cfg SPRW_POLLARIS_MAIL_HOST)
    mail_port=$(read_cfg SPRW_POLLARIS_MAIL_PORT)
    mail_user=$(read_cfg SPRW_POLLARIS_MAIL_USER)
    mail_pw=$(read_cfg SPRW_POLLARIS_MAIL_PASSWORD)
    mail_from_cfg=$(read_cfg SPRW_POLLARIS_MAIL_FROM)
    is_set "$mail_from_cfg" && mail_from="$mail_from_cfg"
    if ! is_set "$mail_host" || ! is_set "$mail_port"; then
        echo "ERROR: MAIL_ENABLED=true but SPRW_POLLARIS_MAIL_HOST / _PORT are not set in ${CONFIG_FILE}" >&2
        exit 1
    fi
    if is_set "$mail_user" && is_set "$mail_pw"; then
        mailer_dsn=$(python3 -c 'import sys,urllib.parse as u;print("smtp://%s:%s@%s:%s"%(u.quote(sys.argv[1],safe=""),u.quote(sys.argv[2],safe=""),sys.argv[3],sys.argv[4]))' \
            "$mail_user" "$mail_pw" "$mail_host" "$mail_port")
    else
        mailer_dsn="smtp://${mail_host}:${mail_port}"
    fi
    unset mail_pw
fi

umask 077
cat > "$SPRW__DATA_DIR/secrets/db.env" <<ENV
POSTGRES_PASSWORD=${db_pw}
ENV
cat > "$SPRW__DATA_DIR/secrets/pollaris.env" <<ENV
APP_ENV=prod
APP_SECRET=${app_secret}
APP_BASE_URL=https://${SPRW__APPDOMAIN}
APP_NAME=${SPRW_POLLARIS_APP_NAME}
APP_TIMEZONE=${SPRW_POLLARIS_TIMEZONE}
APP_REQUIRE_EMAILS=${SPRW_POLLARIS_REQUIRE_EMAILS}
POLL_EXPIRES_COMPLETED=${SPRW_POLLARIS_POLL_EXPIRES_COMPLETED}
DATABASE_URL=postgresql://${SPRW_POLLARIS_DB_USER}:${db_pw}@db:5432/${SPRW_POLLARIS_DB_NAME}?serverVersion=18&charset=utf8
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=${mailer_dsn}
MAILER_FROM=${mail_from}
MAILER_FROM_NAME=${SPRW_POLLARIS_APP_NAME}
SERVER_NAME=:80
SYMFONY_TRUSTED_PROXIES=127.0.0.1,PRIVATE_SUBNETS
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port
ENV
chmod 600 "$SPRW__DATA_DIR/secrets/db.env" "$SPRW__DATA_DIR/secrets/pollaris.env"
unset db_pw app_secret mailer_dsn

echo "Installation prepared. Komodo builds the image on the first deploy (several minutes on ARM64)."
echo "Pollaris URL: https://${SPRW__APPDOMAIN}"
echo "Optional admin account after the first start:"
echo "  docker exec -it ${SPRW__STACKNAME} php bin/console app:user:create"
