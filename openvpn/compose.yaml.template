# myLampiphant app "openvpn" - compose template
# OpenVPN (hwdsl2/openvpn-server). One stack per customer: openvpn_c_<customer>.
#
# Transport is selected with SPRW_OVPN_TRANSPORT / !!OVPN_TRANSPORT!!:
#   udp1194     - publish UDP !!OVPN_PORT!! on the host (default 1194)
#   tcp443_tls  - OpenVPN listens on TCP !!OVPN_PORT!! *inside* the container
#                 (default 1194). No host ports are published. Traefik
#                 terminates TLS on entrypoint websecure (already public 443)
#                 with HostSNI(`!!OVPN_HOSTNAME!!`) and a Let's Encrypt cert,
#                 then forwards plain TCP to this container on the
#                 proxy-shared network. Clients need a TLS wrapper (stunnel)
#                 because a raw OpenVPN handshake has no TLS ClientHello/SNI.
#                 This template does not change Traefik's static config, host
#                 port 443, the firewall, or install sslh.
#
# The container always joins c_<customer>-net. tcp443_tls also joins
# proxy-shared so Traefik can reach it. There is no HTTP router and no web UI.
#
# Generated by app.sh from _templates_/openvpn/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:

  openvpn:
    image: !!OVPN_IMAGE!!
    container_name: !!STACKNAME!!
    hostname: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!OVPN_MEM_LIMIT!!
    environment:
      - TZ=!!TIMEZONE!!
    {%- if SPRW_OVPN_TRANSPORT == "udp1194" %}
    ports:
      - "!!OVPN_PORT!!:!!OVPN_PORT!!/udp"
    {%- endif %}
    {%- if SPRW__VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/data:/etc/openvpn
      - !!DATA_DIR!!/secrets/vpn.env:/vpn.env:ro
      - !!DATA_DIR!!/scripts/entrypoint.sh:/opt/mylampiphant/entrypoint.sh:ro
      - !!DATA_DIR!!/scripts/openvpn-shim.sh:/opt/mylampiphant/bin/openvpn:ro
      - !!DATA_DIR!!/scripts/patch-config.sh:/opt/mylampiphant/patch-config.sh:ro
      - !!DATA_DIR!!/scripts/ovpn-firewall.sh:/opt/mylampiphant/ovpn-firewall.sh:ro
      - !!DATA_DIR!!/scripts/firewall.conf:/opt/mylampiphant/firewall.conf:ro
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_ovpn_data:/etc/openvpn
      - !!DATA_DIR!!/secrets/vpn.env:/vpn.env:ro
      - !!DATA_DIR!!/scripts/entrypoint.sh:/opt/mylampiphant/entrypoint.sh:ro
      - !!DATA_DIR!!/scripts/openvpn-shim.sh:/opt/mylampiphant/bin/openvpn:ro
      - !!DATA_DIR!!/scripts/patch-config.sh:/opt/mylampiphant/patch-config.sh:ro
      - !!DATA_DIR!!/scripts/ovpn-firewall.sh:/opt/mylampiphant/ovpn-firewall.sh:ro
      - !!DATA_DIR!!/scripts/firewall.conf:/opt/mylampiphant/firewall.conf:ro
    {%- elif SPRW__VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_ovpn_data:/etc/openvpn
      - !!DATA_DIR!!/secrets/vpn.env:/vpn.env:ro
      - !!DATA_DIR!!/scripts/entrypoint.sh:/opt/mylampiphant/entrypoint.sh:ro
      - !!DATA_DIR!!/scripts/openvpn-shim.sh:/opt/mylampiphant/bin/openvpn:ro
      - !!DATA_DIR!!/scripts/patch-config.sh:/opt/mylampiphant/patch-config.sh:ro
      - !!DATA_DIR!!/scripts/ovpn-firewall.sh:/opt/mylampiphant/ovpn-firewall.sh:ro
      - !!DATA_DIR!!/scripts/firewall.conf:/opt/mylampiphant/firewall.conf:ro
    {%- endif %}
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
      - net.ipv6.conf.all.disable_ipv6=1
    {%- if SPRW_OVPN_TRANSPORT == "tcp443_tls" %}
    networks:
      - customer-net
      - proxy-shared
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.tcp.routers.!!STACKNAME!!.rule=HostSNI(`!!OVPN_HOSTNAME!!`)"
      - "traefik.tcp.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.tcp.routers.!!STACKNAME!!.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.tcp.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- else %}
      - "traefik.tcp.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- endif %}
      - "traefik.tcp.services.!!STACKNAME!!.loadbalancer.server.port=!!OVPN_PORT!!"
    {%- else %}
    networks:
      - customer-net
    {%- endif %}
    entrypoint: ["/opt/mylampiphant/entrypoint.sh"]
    healthcheck:
      test: ["CMD-SHELL", "ip link show tun0 >/dev/null 2>&1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 90s

{%- if SPRW__VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_ovpn_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/data
{%- elif SPRW__VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_ovpn_data:
    name: !!STACKNAME!!_ovpn_data
{%- endif %}

{%- if SPRW_OVPN_TRANSPORT == "tcp443_tls" %}
networks:
  customer-net:
    name: c_!!CUSTOMER!!-net
    external: true
  proxy-shared:
    name: proxy-shared
    external: true
{%- else %}
networks:
  customer-net:
    name: c_!!CUSTOMER!!-net
    external: true
{%- endif %}

