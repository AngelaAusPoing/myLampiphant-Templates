# myLampiphant app "homer" - compose template
# Lightweight dashboard. Single instance per customer: homer_c_<customer>.
# Image: b4bz/homer (multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/homer/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  homer:
    image: ${HOMER_IMAGE:-b4bz/homer:v26.11.1}
    container_name: !!STACKNAME!!
    hostname: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: ${HOMER_MEM_LIMIT:-32m}
    environment:
      - INIT_ASSETS=1
      - UID=${HOMER_UID:-1000}
      - GID=${HOMER_GID:-1000}
      - TZ=${TIMEZONE:-Europe/Berlin}
    networks:
      - proxy-shared
      - customer-net
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/assets:/www/assets
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_assets:/www/assets
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_assets:/www/assets
    {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://127.0.0.1:8080/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 20s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "true" %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8080"
      - "traefik.docker.network=proxy-shared"
      {%- elif EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=iprestrict@file"
      - "traefik.http.middlewares.iprestrict.ipallowlist.sourcerange=10.8.0.0/24,192.168.0.0/16,172.16.0.0/12,127.0.0.1/32"
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8080"
      - "traefik.docker.network=proxy-shared"
      {%- endif %}

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_assets:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/assets
{%- endif %}

networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_!!CUSTOMER!!-net
