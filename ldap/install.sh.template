#!/bin/bash
# install.sh for the app "ldap" - generated by app.sh from _templates_/ldap/install.sh.template
# Prepares the host side (directories, secrets, build context) BEFORE the stack is deployed via Komodo.
# Idempotent: existing secret files are never overwritten. Secrets are never printed.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW_LDAP_BASE_DN="!!LDAP_BASE_DN!!"
SPRW_LDAP_ORGANISATION="!!LDAP_ORGANISATION!!"
SPRW_LDAP_ROOT_DN="!!LDAP_ROOT_DN!!"
SPRW_LDAP_READONLY_DN="!!LDAP_READONLY_DN!!"
SPRW_LDAP_LAM_IMAGE="!!LAM_IMAGE!!"
SPRW_LDAP_LAM_PORT="!!LAM_PORT!!"
SPRW_LDAP_LAM_LANG="!!LAM_LANG!!"
SPRW_LDAP_TIMEZONE="!!TIMEZONE!!"
SPRW_LDAP_BACKUP_INTERVAL="!!BACKUP_INTERVAL!!"
TEMPLATE_DIR="/opt/docker/_templates_/ldap"
CONFIG_FILE="$(dirname "$SPRW__DATA_DIR")/_config_/${SPRW__STACKNAME}.env"

echo "Preparing ldap ${SPRW__STACKNAME} (base DN ${SPRW_LDAP_BASE_DN}) ..."

# ---------------------------------------------------------------------------
# 1. Refuse to continue with unresolved placeholders
# ---------------------------------------------------------------------------
missing=0
for v in SPRW__STACKNAME SPRW__DATA_DIR SPRW__COMPOSE_DIR SPRW_LDAP_BASE_DN SPRW_LDAP_ORGANISATION \
         SPRW_LDAP_ROOT_DN SPRW_LDAP_READONLY_DN SPRW_LDAP_LAM_IMAGE SPRW_LDAP_LAM_PORT \
         SPRW_LDAP_LAM_LANG SPRW_LDAP_TIMEZONE SPRW_LDAP_BACKUP_INTERVAL; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in the persistent config or pass --var ${v#SPRW_LDAP_}=..." >&2
        missing=1
    fi
done
if [ "$missing" -ne 0 ]; then
    echo "Review the persistent config (<customer>/_config_/${SPRW__STACKNAME}.env) and run app.sh again." >&2
    exit 1
fi

read_cfg() {
    grep -E "^$1=" "$CONFIG_FILE" | head -1 | cut -d= -f2- \
        | sed -E -e "s/^'([^']*)'.*\$/\\1/" -e 's/^"([^"]*)".*$/\1/' -e 's/[[:space:]]+#.*$//' -e 's/[[:space:]]+$//'
}

# ---------------------------------------------------------------------------
# 2. Shared internal Docker network (idempotent). Declared as external in compose.
# ---------------------------------------------------------------------------
if ! docker network inspect ldap-shared >/dev/null 2>&1; then
    docker network create --driver bridge --internal \
        --label mylampiphant.role=shared \
        ldap-shared >/dev/null
    echo "Created Docker network ldap-shared (internal bridge, no internet)"
fi

# ---------------------------------------------------------------------------
# 3. Directories and build context (Dockerfile + entrypoint + schema)
# ---------------------------------------------------------------------------
mkdir -p "$SPRW__COMPOSE_DIR/schema"
mkdir -p "$SPRW__DATA_DIR"/{config,data,backup,lam/config,secrets,secrets/customers}
chmod 700 "$SPRW__DATA_DIR/secrets" "$SPRW__DATA_DIR/config" "$SPRW__DATA_DIR/data" "$SPRW__DATA_DIR/backup"

# Copy image sources into the compose dir (Komodo builds from this context)
cp -a "$TEMPLATE_DIR/Dockerfile" "$SPRW__COMPOSE_DIR/Dockerfile"
cp -a "$TEMPLATE_DIR/entrypoint.sh" "$SPRW__COMPOSE_DIR/entrypoint.sh"
cp -a "$TEMPLATE_DIR/backup-loop.sh" "$SPRW__COMPOSE_DIR/backup-loop.sh"
cp -a "$TEMPLATE_DIR/schema/mylampiphant-mail.ldif" "$SPRW__COMPOSE_DIR/schema/mylampiphant-mail.ldif"
cp -a "$TEMPLATE_DIR/schema/ppolicy.ldif" "$SPRW__COMPOSE_DIR/schema/ppolicy.ldif"
chmod 755 "$SPRW__COMPOSE_DIR/entrypoint.sh" "$SPRW__COMPOSE_DIR/backup-loop.sh"

# ---------------------------------------------------------------------------
# 4. Secret files (created once, chmod 600, never printed, never sent to Komodo)
# ---------------------------------------------------------------------------
ROOT_PW=$(read_cfg SPRW_LDAP_ROOT_PASSWORD)
READONLY_PW=$(read_cfg SPRW_LDAP_READONLY_PASSWORD)
LAM_PW=$(read_cfg SPRW_LDAP_LAM_PASSWORD)
if [ -z "$ROOT_PW" ] || [[ "$ROOT_PW" == *'!!'* ]] \
   || [ -z "$READONLY_PW" ] || [[ "$READONLY_PW" == *'!!'* ]] \
   || [ -z "$LAM_PW" ] || [[ "$LAM_PW" == *'!!'* ]]; then
    echo "ERROR: LDAP passwords missing in ${CONFIG_FILE}" >&2
    unset ROOT_PW READONLY_PW LAM_PW
    exit 1
fi

if [ ! -f "$SPRW__DATA_DIR/secrets/root.pw" ]; then
    printf '%s' "$ROOT_PW" > "$SPRW__DATA_DIR/secrets/root.pw"
    chmod 600 "$SPRW__DATA_DIR/secrets/root.pw"
fi
if [ ! -f "$SPRW__DATA_DIR/secrets/readonly.pw" ]; then
    printf '%s' "$READONLY_PW" > "$SPRW__DATA_DIR/secrets/readonly.pw"
    chmod 600 "$SPRW__DATA_DIR/secrets/readonly.pw"
fi

# env_file for the OpenLDAP / backup containers (host path, not the Komodo .env)
if [ ! -f "$SPRW__DATA_DIR/secrets/openldap.env" ]; then
    umask 077
    cat > "$SPRW__DATA_DIR/secrets/openldap.env" <<ENV
LDAP_BASE_DN=${SPRW_LDAP_BASE_DN}
LDAP_ORGANISATION=${SPRW_LDAP_ORGANISATION}
LDAP_ROOT_DN=${SPRW_LDAP_ROOT_DN}
LDAP_READONLY_DN=${SPRW_LDAP_READONLY_DN}
LDAP_ROOT_PW_FILE=/run/secrets/ldap_root_pw
LDAP_READONLY_PW_FILE=/run/secrets/ldap_readonly_pw
ENV
    chmod 600 "$SPRW__DATA_DIR/secrets/openldap.env"
fi

# env_file for LAM (password via env; image has no *_FILE for all vars)
if [ ! -f "$SPRW__DATA_DIR/secrets/lam.env" ]; then
    umask 077
    cat > "$SPRW__DATA_DIR/secrets/lam.env" <<ENV
LAM_SKIP_PRECONFIGURE=false
LAM_PASSWORD=${LAM_PW}
LDAP_SERVER=ldap://ldap:389
LDAP_BASE_DN=${SPRW_LDAP_BASE_DN}
LDAP_USER=${SPRW_LDAP_ROOT_DN}
LDAP_USERS_DN=${SPRW_LDAP_BASE_DN}
LDAP_GROUPS_DN=${SPRW_LDAP_BASE_DN}
ENV
    chmod 600 "$SPRW__DATA_DIR/secrets/lam.env"
fi
unset ROOT_PW READONLY_PW LAM_PW

# Seed LAM config volume from the official image once. Bind-mounting an empty
# directory would hide unix.sample.conf, which LAM's preconfigure step needs.
if [ ! -f "$SPRW__DATA_DIR/lam/config/unix.sample.conf" ]; then
    echo "Seeding LAM config volume from ${SPRW_LDAP_LAM_IMAGE} ..."
    docker run --rm --entrypoint /bin/sh "$SPRW_LDAP_LAM_IMAGE"         -c 'cd /var/lib/ldap-account-manager/config && tar --exclude=config.cfg -cf - .'         | tar -xf - -C "$SPRW__DATA_DIR/lam/config"
    # LAM (www-data) must be able to write lam.conf
    chown -R 33:0 "$SPRW__DATA_DIR/lam/config" 2>/dev/null || true
    chmod 770 "$SPRW__DATA_DIR/lam/config"
fi

echo "✅ Host preparation done for ${SPRW__STACKNAME}"
echo "📁 Data: ${SPRW__DATA_DIR}"
echo "📝 After the stack is running: run ldapadmin.sh add-customer <customer>"
echo "🔒 LAM listens on 127.0.0.1:${SPRW_LDAP_LAM_PORT} (SSH tunnel, not Traefik)"
