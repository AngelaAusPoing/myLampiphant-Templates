#!/bin/bash
# Default variables for the app "dokuwiki"
#
# This file is generated ONCE into /opt/docker-data/<customer>/_config_/<app_dir>.env
# and then kept (persistent config). Change values there, not in the generated
# compose/.env files.
#
# Install (several stacks per customer, one per domain — same instance type as wordpress):
#   app.sh dokuwiki add <customer> <domain>
#   example: app.sh dokuwiki add lapha_de wiki.example.com
#   LDAP:    app.sh dokuwiki add <customer> <domain> --var DOKUWIKI_AUTH=ldap --var DOKUWIKI_ACCESS=closed
#
# The stack is named dokuwiki_d_<domain_normalized>.
#
# Options (Jinja2 / Docusaurus buttons):
#   DOKUWIKI_AUTH:   plain (default) | ldap
#   DOKUWIKI_ACCESS: open  (default) | closed
# closed = only logged-in users can read (* @ALL 0, * @user 8) and self-registration is disabled.
# ldap   = authldap against the host OpenLDAP stack (readonly bind, customer subtree).

# The following variables are read by app.sh
SPRW__APP_NAME='dokuwiki'
SPRW__APP_PREFIX='DOKUWIKI'

# Global (customer/domain-specific values are !!PLACEHOLDER!!, filled by app.sh)
SPRW__APPDOMAIN='!!APPDOMAIN!!'
SPRW__VOLUME_MODE='!!VOLUME_MODE!!'
SPRW__HTTP_REDIRECT='!!HTTP_REDIRECT!!'
SPRW__LETSENCRYPT_METHOD='!!LETSENCRYPT_METHOD!!'
SPRW__EXTERNAL_ACCESS='!!EXTERNAL_ACCESS!!'

# Homer dashboard tile (optional; app.sh default is HOMER_LINK=true)
SPRW__HOMER_LINK='!!HOMER_LINK!!'
SPRW__HOMER_NAME='DokuWiki'
SPRW__HOMER_ICON='fas fa-book'
SPRW__HOMER_GROUP='Apps'

# Optional Traefik ForwardAuth via the host Authelia stack (middleware authelia@docker).
# Default false. Requires the host app "authelia" to be running.
SPRW_DOKUWIKI_AUTH_PROTECT='!!AUTH_PROTECT!!'

# App-specific defaults (not customer-specific; override here or with --var)
SPRW_DOKUWIKI_IMAGE='lscr.io/linuxserver/dokuwiki:latest'
SPRW_DOKUWIKI_MEM_LIMIT='256m'
SPRW_DOKUWIKI_PUID='1000'
SPRW_DOKUWIKI_PGID='1000'
SPRW_DOKUWIKI_TIMEZONE='Europe/Berlin'

# Auth and access options
SPRW_DOKUWIKI_AUTH='!!DOKUWIKI_AUTH!!'                 # plain | ldap
SPRW_DOKUWIKI_ACCESS='!!DOKUWIKI_ACCESS!!'             # open | closed

# LDAP (used when DOKUWIKI_AUTH=ldap). Bind password is NOT stored here;
# the compose file mounts LDAP_BIND_PW_FILE (host read-only account).
SPRW_DOKUWIKI_LDAP_SERVER='!!LDAP_SERVER!!'            # e.g. ldap://ldap:389
SPRW_DOKUWIKI_LDAP_BIND_DN='!!LDAP_BIND_DN!!'          # read-only bind DN
SPRW_DOKUWIKI_LDAP_USER_TREE='!!LDAP_USER_TREE!!'      # ou=people,o=<customer>,dc=lampiphant,dc=de
SPRW_DOKUWIKI_LDAP_GROUP_TREE='!!LDAP_GROUP_TREE!!'    # ou=groups,o=<customer>,dc=lampiphant,dc=de
SPRW_DOKUWIKI_LDAP_ADMIN_GROUP='!!LDAP_ADMIN_GROUP!!'  # LDAP group CN that becomes DokuWiki superuser (@group)
SPRW_DOKUWIKI_LDAP_BIND_PW_FILE='!!LDAP_BIND_PW_FILE!!'

# ------------------------------------------------------------------------------------------------
# Do not manually edit the lines below, change the values above instead (defaults for empty values).
if [ -z "$SPRW__VOLUME_MODE" ] || [[ "$SPRW__VOLUME_MODE" == *'!!'* ]]; then
	SPRW__VOLUME_MODE=bind
fi
if [ -z "$SPRW__HTTP_REDIRECT" ] || [[ "$SPRW__HTTP_REDIRECT" == *'!!'* ]]; then
	SPRW__HTTP_REDIRECT=true
fi
if [ -z "$SPRW__LETSENCRYPT_METHOD" ] || [[ "$SPRW__LETSENCRYPT_METHOD" == *'!!'* ]]; then
	SPRW__LETSENCRYPT_METHOD=acme
fi
if [ -z "$SPRW__EXTERNAL_ACCESS" ] || [[ "$SPRW__EXTERNAL_ACCESS" == *'!!'* ]]; then
	SPRW__EXTERNAL_ACCESS=true
fi
if [ -z "$SPRW__HOMER_LINK" ] || [[ "$SPRW__HOMER_LINK" == *'!!'* ]]; then
	SPRW__HOMER_LINK=true
fi
if [ -z "$SPRW_DOKUWIKI_AUTH_PROTECT" ] || [[ "$SPRW_DOKUWIKI_AUTH_PROTECT" == *'!!'* ]]; then
	SPRW_DOKUWIKI_AUTH_PROTECT=false
fi
if [ -z "$SPRW_DOKUWIKI_AUTH" ] || [[ "$SPRW_DOKUWIKI_AUTH" == *'!!'* ]]; then
	SPRW_DOKUWIKI_AUTH=plain
fi
if [ -z "$SPRW_DOKUWIKI_ACCESS" ] || [[ "$SPRW_DOKUWIKI_ACCESS" == *'!!'* ]]; then
	SPRW_DOKUWIKI_ACCESS=open
fi
if [ -z "$SPRW_DOKUWIKI_LDAP_SERVER" ] || [[ "$SPRW_DOKUWIKI_LDAP_SERVER" == *'!!'* ]]; then
	SPRW_DOKUWIKI_LDAP_SERVER='ldap://ldap:389'
fi
if [ -z "$SPRW_DOKUWIKI_LDAP_BIND_DN" ] || [[ "$SPRW_DOKUWIKI_LDAP_BIND_DN" == *'!!'* ]]; then
	SPRW_DOKUWIKI_LDAP_BIND_DN='cn=readonly,ou=system,dc=lampiphant,dc=de'
fi
# Customer subtree: o=<customer>,dc=lampiphant,dc=de (see ldapadmin.sh add-customer)
_dw_customer="${SPRW__CUSTOMER:-}"
if [ -z "$_dw_customer" ] || [[ "$_dw_customer" == *'!!'* ]]; then
	_dw_customer='!!CUSTOMER!!'
fi
if [ -z "$SPRW_DOKUWIKI_LDAP_USER_TREE" ] || [[ "$SPRW_DOKUWIKI_LDAP_USER_TREE" == *'!!'* ]]; then
	SPRW_DOKUWIKI_LDAP_USER_TREE="ou=people,o=${_dw_customer},dc=lampiphant,dc=de"
fi
if [ -z "$SPRW_DOKUWIKI_LDAP_GROUP_TREE" ] || [[ "$SPRW_DOKUWIKI_LDAP_GROUP_TREE" == *'!!'* ]]; then
	SPRW_DOKUWIKI_LDAP_GROUP_TREE="ou=groups,o=${_dw_customer},dc=lampiphant,dc=de"
fi
if [ -z "$SPRW_DOKUWIKI_LDAP_ADMIN_GROUP" ] || [[ "$SPRW_DOKUWIKI_LDAP_ADMIN_GROUP" == *'!!'* ]]; then
	SPRW_DOKUWIKI_LDAP_ADMIN_GROUP='wiki-admin'
fi
if [ -z "$SPRW_DOKUWIKI_LDAP_BIND_PW_FILE" ] || [[ "$SPRW_DOKUWIKI_LDAP_BIND_PW_FILE" == *'!!'* ]]; then
	SPRW_DOKUWIKI_LDAP_BIND_PW_FILE='/opt/docker-data/_host_/ldap/secrets/readonly.pw'
fi
unset _dw_customer

# ------------------------------------------------------------------------------------------------
# Bridge for app.sh: placeholders are resolved by their bare name.
DOKUWIKI_IMAGE="$SPRW_DOKUWIKI_IMAGE"
DOKUWIKI_MEM_LIMIT="$SPRW_DOKUWIKI_MEM_LIMIT"
PUID="$SPRW_DOKUWIKI_PUID"
PGID="$SPRW_DOKUWIKI_PGID"
TIMEZONE="$SPRW_DOKUWIKI_TIMEZONE"
APPDOMAIN="$SPRW__APPDOMAIN"
VOLUME_MODE="$SPRW__VOLUME_MODE"
HTTP_REDIRECT="$SPRW__HTTP_REDIRECT"
LETSENCRYPT_METHOD="$SPRW__LETSENCRYPT_METHOD"
EXTERNAL_ACCESS="$SPRW__EXTERNAL_ACCESS"
HOMER_LINK="$SPRW__HOMER_LINK"
HOMER_NAME="$SPRW__HOMER_NAME"
HOMER_ICON="$SPRW__HOMER_ICON"
HOMER_GROUP="$SPRW__HOMER_GROUP"
AUTH_PROTECT="$SPRW_DOKUWIKI_AUTH_PROTECT"
DOKUWIKI_AUTH="$SPRW_DOKUWIKI_AUTH"
DOKUWIKI_ACCESS="$SPRW_DOKUWIKI_ACCESS"
LDAP_SERVER="$SPRW_DOKUWIKI_LDAP_SERVER"
LDAP_BIND_DN="$SPRW_DOKUWIKI_LDAP_BIND_DN"
LDAP_USER_TREE="$SPRW_DOKUWIKI_LDAP_USER_TREE"
LDAP_GROUP_TREE="$SPRW_DOKUWIKI_LDAP_GROUP_TREE"
LDAP_ADMIN_GROUP="$SPRW_DOKUWIKI_LDAP_ADMIN_GROUP"
LDAP_BIND_PW_FILE="$SPRW_DOKUWIKI_LDAP_BIND_PW_FILE"
