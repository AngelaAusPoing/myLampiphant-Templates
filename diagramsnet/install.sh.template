#!/bin/bash
# install.sh for the app "diagramsnet" - generated by app.sh from _templates_/diagramsnet/install.sh.template
# draw.io is stateless: no data directory content, no secrets. Only checks and networks.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"

echo "Preparing diagramsnet ${SPRW__STACKNAME} (${SPRW__APPDOMAIN}) ..."

missing=0
for v in SPRW__CUSTOMER SPRW__STACKNAME SPRW__APPDOMAIN SPRW__COMPOSE_DIR; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved)." >&2
        missing=1
    fi
done
[ "$missing" -eq 0 ] || exit 1

mkdir -p "$SPRW__COMPOSE_DIR"

# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_shared_networks

echo "Installation prepared."
echo "draw.io URL: https://${SPRW__APPDOMAIN}"
