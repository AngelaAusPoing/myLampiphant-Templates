#!/bin/bash
CUSTOMER="!!CUSTOMER!!" # Name of the customer, e.g. julian_snowden
APPDOMAIN="!!APPDOMAIN!!" # Domain for WordPress, e.g. www.example.com
DATA_DIR="!!DATA_DIR!!" # Path to persistent data, e.g. /opt/docker-data/julian_snowden/wordpress
COMPOSE_DIR="!!COMPOSE_DIR!!" # Path to Docker-Compose configuration, e.g. /opt/docker/julian_snowden/wordpress

DB_PASSWORD="!!DB_PASSWORD!!" # Self-chosen password for the database
DB_ROOT_PASSWORD="!!DB_ROOT_PASSWORD!!" # Self-chosen root password for the database

echo "Installiere WordPress für ${CUSTOMER} (${APPDOMAIN})..."

mkdir -p "$COMPOSE_DIR"
mkdir -p "$DATA_DIR/db"
mkdir -p "$DATA_DIR/wordpress"

chown -R 33:33 "$DATA_DIR/wordpress"

echo "✅ Installation abgeschlossen"
echo "🌐 WordPress URL: https://${APPDOMAIN}"
echo "📁 Daten: ${DATA_DIR}"
echo "🔐 DB User: wpuser / ${DB_PASSWORD}"
echo "🔐 DB Root: root / ${DB_ROOT_PASSWORD}"
echo ""
echo "📝 Nach dem ersten Start bitte die WordPress-Installation unter https://${APPDOMAIN} abschließen."