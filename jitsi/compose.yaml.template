# myLampiphant app "jitsi" - compose template
#
# Host (customer "_host_", stack "jitsi"): shared Jitsi Videobridge (JVB).
# Customer (stack jitsi_c_<customer>): web UI + Prosody + Jicofo, optional
# Excalidraw whiteboard and Jibri. See README.md for the multi-tenant JVB design.
#
# Generated by app.sh from _templates_/jitsi/compose.yaml.template - do not
# edit, edit the template or the persistent config.

{%- if CUSTOMER == "_host_" %}
# ----------------------------- host: shared JVB -----------------------------
services:
  jvb:
    image: !!IMAGE_REPO!!/jvb:!!IMAGE_VERSION!!
    container_name: !!STACKNAME!!
    hostname: !!STACKNAME!!
    restart: unless-stopped
    mem_limit: !!JVB_MEM_LIMIT!!
    read_only: true
    tmpfs:
      - /run:size=32M,mode=1750,exec
      - /tmp:size=16M,mode=1777,noexec
    ports:
      - "!!JVB_PORT!!:!!JVB_PORT!!/udp"
    env_file:
      - !!DATA_DIR!!/secrets/jvb-advertise.env
    environment:
      - TZ=!!TIMEZONE!!
      - JVB_PORT=!!JVB_PORT!!
      - JVB_DISABLE_XMPP=1
      - JVB_STUN_SERVERS=!!JVB_STUN_SERVERS!!
      - JVB_MUC_NICKNAME=jvb-host
      - JVB_ADVERTISE_PRIVATE_CANDIDATES=true
      - VIDEOBRIDGE_MAX_MEMORY=!!JVB_MAX_MEMORY!!
      - COLIBRI_REST_ENABLED=false
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/jvb:/config
      - !!DATA_DIR!!/xmpp-servers:/xmpp-servers
      - !!DATA_DIR!!/scripts/assemble-jvb-xmpp.sh:/opt/mylampiphant/assemble-jvb-xmpp.sh:ro
      - !!DATA_DIR!!/scripts/jvb-entrypoint.sh:/opt/mylampiphant/jvb-entrypoint.sh:ro
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_jvb_data:/config
      - !!DATA_DIR!!/xmpp-servers:/xmpp-servers
      - !!DATA_DIR!!/scripts/assemble-jvb-xmpp.sh:/opt/mylampiphant/assemble-jvb-xmpp.sh:ro
      - !!DATA_DIR!!/scripts/jvb-entrypoint.sh:/opt/mylampiphant/jvb-entrypoint.sh:ro
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_jvb_data:/config
      - !!DATA_DIR!!/xmpp-servers:/xmpp-servers
      - !!DATA_DIR!!/scripts/assemble-jvb-xmpp.sh:/opt/mylampiphant/assemble-jvb-xmpp.sh:ro
      - !!DATA_DIR!!/scripts/jvb-entrypoint.sh:/opt/mylampiphant/jvb-entrypoint.sh:ro
    {%- endif %}
    networks:
      - jitsi-shared
    entrypoint: ["/opt/mylampiphant/jvb-entrypoint.sh"]

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_jvb_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/jvb
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_jvb_data:
{%- endif %}

networks:
  jitsi-shared:
    external: true
    name: jitsi-shared

{%- else %}
# ---------------------- customer: web + Prosody + Jicofo --------------------
services:
  web:
    image: !!IMAGE_REPO!!/web:!!IMAGE_VERSION!!
    container_name: !!STACKNAME!!-web
    hostname: !!STACKNAME!!-web
    restart: unless-stopped
    mem_limit: !!WEB_MEM_LIMIT!!
    read_only: true
    tmpfs:
      - /run:size=16M,mode=1750,exec
      - /tmp:size=16M,mode=1777,noexec
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/web:/config
      - !!DATA_DIR!!/web/transcripts:/usr/share/jitsi-meet/transcripts
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_web_data:/config
      - !!DATA_DIR!!/web/transcripts:/usr/share/jitsi-meet/transcripts
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_web_data:/config
      - !!DATA_DIR!!/web/transcripts:/usr/share/jitsi-meet/transcripts
    {%- endif %}
    environment:
      - TZ=!!TIMEZONE!!
      - PUBLIC_URL=https://!!APPDOMAIN!!
      - DISABLE_HTTPS=1
      - ENABLE_HTTP_REDIRECT=0
      - ENABLE_LETSENCRYPT=0
      - ENABLE_XMPP_WEBSOCKET=1
      - XMPP_BOSH_URL_BASE=http://prosody:5280
      - XMPP_SERVER=prosody
      - XMPP_DOMAIN=meet.!!CUSTOMER!!
      - XMPP_AUTH_DOMAIN=auth.meet.!!CUSTOMER!!
      - XMPP_GUEST_DOMAIN=guest.meet.!!CUSTOMER!!
      - XMPP_MUC_DOMAIN=muc.meet.!!CUSTOMER!!
      - XMPP_HIDDEN_DOMAIN=hidden.meet.!!CUSTOMER!!
      - XMPP_RECORDER_DOMAIN=recorder.meet.!!CUSTOMER!!
      - ENABLE_AUTH=!!ENABLE_AUTH!!
      - ENABLE_GUESTS=!!ENABLE_GUESTS!!
      - ENABLE_PREJOIN_PAGE=!!ENABLE_PREJOIN_PAGE!!
      - ENABLE_WELCOME_PAGE=1
      - DEFAULT_LANGUAGE=!!DEFAULT_LANGUAGE!!
      - RESOLUTION=!!RESOLUTION!!
      - BRANDING_DATA_URL=!!BRANDING_DATA_URL!!
      {%- if JITSI_WHITEBOARD == "true" %}
      - WHITEBOARD_COLLAB_SERVER_URL_BASE=http://whiteboard
      - WHITEBOARD_COLLAB_SERVER_PUBLIC_URL=https://!!APPDOMAIN!!
      {%- elif JITSI_WHITEBOARD == "false" %}
      # Whiteboard disabled
      {%- endif %}
      {%- if JITSI_RECORDING == "true" %}
      - ENABLE_RECORDING=1
      {%- elif JITSI_RECORDING == "false" %}
      - ENABLE_RECORDING=0
      {%- endif %}
    depends_on:
      - prosody
    networks:
      - proxy-shared
      - customer-net
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=Host(`!!APPDOMAIN!!`)"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "true" %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8000"
      - "traefik.docker.network=proxy-shared"
      {%- elif EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=iprestrict@file"
      - "traefik.http.middlewares.iprestrict.ipallowlist.sourcerange=10.8.0.0/24,192.168.0.0/16,172.16.0.0/12,127.0.0.1/32"
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=8000"
      - "traefik.docker.network=proxy-shared"
      {%- endif %}

  prosody:
    image: !!IMAGE_REPO!!/prosody:!!IMAGE_VERSION!!
    container_name: !!STACKNAME!!-prosody
    hostname: !!STACKNAME!!-prosody
    restart: unless-stopped
    mem_limit: !!PROSODY_MEM_LIMIT!!
    read_only: true
    tmpfs:
      - /run:size=16M,mode=1750,exec
      - /tmp:size=16M,mode=1777,noexec
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/prosody/config:/config
      - !!DATA_DIR!!/prosody/prosody-plugins-custom:/prosody-plugins-custom
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_prosody_data:/config
      - !!DATA_DIR!!/prosody/prosody-plugins-custom:/prosody-plugins-custom
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_prosody_data:/config
      - !!DATA_DIR!!/prosody/prosody-plugins-custom:/prosody-plugins-custom
    {%- endif %}
    env_file:
      - !!DATA_DIR!!/secrets/jitsi.env
    environment:
      - TZ=!!TIMEZONE!!
      - PUBLIC_URL=https://!!APPDOMAIN!!
      - XMPP_DOMAIN=meet.!!CUSTOMER!!
      - XMPP_AUTH_DOMAIN=auth.meet.!!CUSTOMER!!
      - XMPP_GUEST_DOMAIN=guest.meet.!!CUSTOMER!!
      - XMPP_MUC_DOMAIN=muc.meet.!!CUSTOMER!!
      - XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.!!CUSTOMER!!
      - XMPP_HIDDEN_DOMAIN=hidden.meet.!!CUSTOMER!!
      - XMPP_RECORDER_DOMAIN=recorder.meet.!!CUSTOMER!!
      - JVB_AUTH_USER=jvb
      - JICOFO_AUTH_USER=focus
      - ENABLE_AUTH=!!ENABLE_AUTH!!
      - ENABLE_GUESTS=!!ENABLE_GUESTS!!
      - ENABLE_XMPP_WEBSOCKET=1
      {%- if JITSI_RECORDING == "true" %}
      - ENABLE_RECORDING=1
      - JIBRI_XMPP_USER=jibri
      - JIBRI_RECORDER_USER=recorder
      {%- elif JITSI_RECORDING == "false" %}
      - ENABLE_RECORDING=0
      {%- endif %}
    networks:
      customer-net: {}
      jitsi-shared:
        aliases:
          - xmpp-!!STACKNAME!!

  jicofo:
    image: !!IMAGE_REPO!!/jicofo:!!IMAGE_VERSION!!
    container_name: !!STACKNAME!!-jicofo
    hostname: !!STACKNAME!!-jicofo
    restart: unless-stopped
    mem_limit: !!JICOFO_MEM_LIMIT!!
    read_only: true
    tmpfs:
      - /run:size=32M,mode=1750,exec
      - /tmp:size=16M,mode=1777,noexec
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/jicofo:/config
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_jicofo_data:/config
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_jicofo_data:/config
    {%- endif %}
    env_file:
      - !!DATA_DIR!!/secrets/jitsi.env
    environment:
      - TZ=!!TIMEZONE!!
      - XMPP_SERVER=prosody
      - XMPP_DOMAIN=meet.!!CUSTOMER!!
      - XMPP_AUTH_DOMAIN=auth.meet.!!CUSTOMER!!
      - XMPP_MUC_DOMAIN=muc.meet.!!CUSTOMER!!
      - XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.!!CUSTOMER!!
      - XMPP_HIDDEN_DOMAIN=hidden.meet.!!CUSTOMER!!
      - JVB_BREWERY_MUC=jvbbrewery
      - ENABLE_AUTH=!!ENABLE_AUTH!!
      {%- if JITSI_RECORDING == "true" %}
      - ENABLE_RECORDING=1
      - JIBRI_BREWERY_MUC=jibribrewery
      {%- elif JITSI_RECORDING == "false" %}
      - ENABLE_RECORDING=0
      {%- endif %}
    depends_on:
      - prosody
    networks:
      - customer-net

  {%- if JITSI_WHITEBOARD == "true" %}
  whiteboard:
    image: !!WHITEBOARD_IMAGE!!
    container_name: !!STACKNAME!!-whiteboard
    hostname: !!STACKNAME!!-whiteboard
    restart: unless-stopped
    mem_limit: !!WHITEBOARD_MEM_LIMIT!!
    depends_on:
      - web
    networks:
      customer-net:
        aliases:
          - whiteboard
  {%- elif JITSI_WHITEBOARD == "false" %}
  # Whiteboard (Excalidraw) not enabled
  {%- endif %}

  {%- if JITSI_RECORDING == "true" %}
  jibri:
    image: !!IMAGE_REPO!!/jibri:!!IMAGE_VERSION!!
    container_name: !!STACKNAME!!-jibri
    hostname: !!STACKNAME!!-jibri
    restart: unless-stopped
    mem_limit: !!JIBRI_MEM_LIMIT!!
    shm_size: "2gb"
    read_only: true
    tmpfs:
      - /run:size=256M,mode=1750,exec
      - /tmp:size=256M,mode=1777,noexec
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/jibri:/config
      - !!DATA_DIR!!/jibri/storage:/storage
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_jibri_data:/config
      - !!DATA_DIR!!/jibri/storage:/storage
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_jibri_data:/config
      - !!DATA_DIR!!/jibri/storage:/storage
    {%- endif %}
    env_file:
      - !!DATA_DIR!!/secrets/jitsi.env
    environment:
      - TZ=!!TIMEZONE!!
      - DISPLAY=:0
      - PUBLIC_URL=https://!!APPDOMAIN!!
      - XMPP_SERVER=prosody
      - XMPP_DOMAIN=meet.!!CUSTOMER!!
      - XMPP_AUTH_DOMAIN=auth.meet.!!CUSTOMER!!
      - XMPP_MUC_DOMAIN=muc.meet.!!CUSTOMER!!
      - XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.!!CUSTOMER!!
      - XMPP_HIDDEN_DOMAIN=hidden.meet.!!CUSTOMER!!
      - XMPP_RECORDER_DOMAIN=recorder.meet.!!CUSTOMER!!
      - JIBRI_XMPP_USER=jibri
      - JIBRI_RECORDER_USER=recorder
      - JIBRI_BREWERY_MUC=jibribrewery
      - JIBRI_RECORDING_DIR=/storage
    depends_on:
      - jicofo
    networks:
      - customer-net
  {%- elif JITSI_RECORDING == "false" %}
  # Jibri recording not enabled (needs ~2 GB RAM plus 2 GB SHM; tight on CAX11)
  {%- endif %}

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_web_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/web
  !!STACKNAME!!_prosody_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/prosody/config
  !!STACKNAME!!_jicofo_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/jicofo
  {%- if JITSI_RECORDING == "true" %}
  !!STACKNAME!!_jibri_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/jibri
  {%- endif %}
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_web_data:
  !!STACKNAME!!_prosody_data:
  !!STACKNAME!!_jicofo_data:
  {%- if JITSI_RECORDING == "true" %}
  !!STACKNAME!!_jibri_data:
  {%- endif %}
{%- endif %}

networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_!!CUSTOMER!!-net
  jitsi-shared:
    external: true
    name: jitsi-shared
{%- endif %}
