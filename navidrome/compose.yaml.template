# App "navidrome" - compose template
# Navidrome music server (Subsonic API). Single instance per customer:
# navidrome_c_<customer>. No database container (embedded SQLite in /data).
# Image: deluan/navidrome (multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/navidrome/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   SPRW_NAVIDROME_AUTH: plain | proxy
#     plain = Navidrome's own user accounts (default)
#     proxy = login via the host Authelia stack (forwardAuth, header Remote-User);
#             the Subsonic API (/rest) stays reachable for apps with their own login.
services:
  navidrome:
    image: ${SPRW_NAVIDROME_IMAGE:-deluan/navidrome:0.64.2}
    container_name: ${SPRW__STACKNAME:-navidrome_c_customer_directory}
    restart: unless-stopped
    user: "${SPRW_NAVIDROME_PUID:-1000}:${SPRW_NAVIDROME_PGID:-1000}"
    mem_limit: ${SPRW_NAVIDROME_MEM_LIMIT:-256m}
    networks:
      - proxy-shared
      - customer-net
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-navidrome_c_customer_directory}/data:/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-navidrome_c_customer_directory}_data:/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-navidrome_c_customer_directory}_data:/data
    {%- endif %}
      # Music library on the host (read-only for Navidrome).
      - ${SPRW_NAVIDROME_MUSIC_DIR}:/music:ro
    environment:
      - TZ=${SPRW_NAVIDROME_TIMEZONE:-Europe/Berlin}
      - ND_MUSICFOLDER=/music
      - ND_DATAFOLDER=/data
      - ND_SCANSCHEDULE=${SPRW_NAVIDROME_SCAN_SCHEDULE:-1h}
      - ND_LOGLEVEL=${SPRW_NAVIDROME_LOG_LEVEL:-info}
      - ND_BASEURL=
      - ND_ENABLEINSIGHTSCOLLECTOR=false
      {%- if SPRW_NAVIDROME_AUTH == "proxy" %}
      # Trust the Remote-User header only from these sources (Traefik on proxy-shared).
      - ND_EXTAUTH_TRUSTEDSOURCES=${SPRW_NAVIDROME_TRUSTED_SOURCES}
      - ND_EXTAUTH_USERHEADER=Remote-User
      {%- elif SPRW_NAVIDROME_AUTH == "plain" %}
      # plain: Navidrome's own logins, no reverse-proxy authentication
      {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "wget -qO /dev/null http://127.0.0.1:4533/ping || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.service=${SPRW__STACKNAME:-navidrome_c_customer_directory}"
      - "traefik.http.services.${SPRW__STACKNAME:-navidrome_c_customer_directory}.loadbalancer.server.port=4533"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      # Only VPN and internal networks. The middleware is defined here, no file provider needed.
      - "traefik.http.middlewares.${SPRW__STACKNAME:-navidrome_c_customer_directory}-iprestrict.ipallowlist.sourcerange=${SPRW_NAVIDROME_INTERNAL_SOURCERANGE}"
      {%- endif %}
      {%- if SPRW_NAVIDROME_AUTH == "proxy" and SPRW__EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.middlewares=authelia@docker,${SPRW__STACKNAME:-navidrome_c_customer_directory}-iprestrict"
      {%- elif SPRW_NAVIDROME_AUTH == "proxy" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.middlewares=authelia@docker"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}.middlewares=${SPRW__STACKNAME:-navidrome_c_customer_directory}-iprestrict"
      {%- endif %}
      {%- if SPRW_NAVIDROME_AUTH == "proxy" %}
      # Subsonic API for mobile/desktop apps: no Authelia (apps log in with their own Navidrome password).
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.rule=Host(`${SPRW__APPDOMAIN}`) && PathPrefix(`/rest`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.entrypoints=websecure"
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.service=${SPRW__STACKNAME:-navidrome_c_customer_directory}"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-navidrome_c_customer_directory}-rest.middlewares=${SPRW__STACKNAME:-navidrome_c_customer_directory}-iprestrict"
      {%- endif %}
      {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-navidrome_c_customer_directory}_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-navidrome_c_customer_directory}/data
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-navidrome_c_customer_directory}_data:
{%- endif %}

# ===================== Networks =====================
# proxy-shared: Traefik (always attached; EXTERNAL_ACCESS=false limits access with an IP allowlist)
# customer-net: other apps of the same customer (created by ensure-networks.sh if missing)
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
