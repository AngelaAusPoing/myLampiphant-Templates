{%- if SPRW_POSTIZ_PROVIDER_DRIBBBLE == "true" %}
offer "Dribbble" "dribbble" DRIBBBLE_CLIENT_ID DRIBBBLE_CLIENT_SECRET || hide "Dribbble" "dribbble" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_DRIBBBLE == "false" %}
hide "Dribbble" "dribbble" "switched off"
{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_DISCORD == "true" %}
offer "Discord" "discord" DISCORD_CLIENT_ID DISCORD_CLIENT_SECRET DISCORD_BOT_TOKEN_ID || hide "Discord" "discord" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_DISCORD == "false" %}
