# it lives in !!DATA_DIR!!/secrets/imapfilter-master.pw
SPRW_IMAPFILTER_MAILHOST=!!MAILHOST!!
SPRW_IMAPFILTER_IMAP_PORT=!!IMAP_PORT!!
