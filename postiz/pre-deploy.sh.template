chmod 600 "$TMP_FILE"
mv -f "$TMP_FILE" "$OUT_FILE"
trap - EXIT
echo "  offered: ${OFFERED#, }"
echo "  hidden:  ${HIDDEN#,}"
echo "Wrote $OUT_FILE (keys not printed). Changes take effect with: app.sh postiz redeploy <customer>"
