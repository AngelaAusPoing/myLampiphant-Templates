# App "easyappointments" - compose template
# Easy!Appointments (online booking) + MariaDB. One stack per domain:
# easyappointments_d_<domain>.
#
# Generated by app.sh from _templates_/easyappointments/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  easyappointments:
    image: ${SPRW_EASYAPPOINTMENTS_IMAGE:-alextselegidis/easyappointments:latest}
    container_name: ${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}
    restart: unless-stopped
    mem_limit: ${SPRW_EASYAPPOINTMENTS_MEM_LIMIT:-256m}
    networks:
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - proxy-shared
      {%- endif %}
      - customer-net
    environment:
      - TZ=${SPRW_EASYAPPOINTMENTS_TIMEZONE:-Europe/Berlin}
      - BASE_URL=https://${SPRW__APPDOMAIN}
      - DEBUG_MODE=FALSE
      - DB_HOST=db
      - DB_PORT=3306
      - DB_NAME=${SPRW_EASYAPPOINTMENTS_DB_NAME:-easyappointments}
      - DB_USERNAME=${SPRW_EASYAPPOINTMENTS_DB_USER:-easyappointments}
      - DB_PASSWORD=${SPRW_EASYAPPOINTMENTS_DB_PASSWORD}
      {%- if SPRW_EASYAPPOINTMENTS_MAIL_ENABLED == "true" %}
      - MAIL_PROTOCOL=smtp
      - MAIL_SMTP_DEBUG=0
      - MAIL_SMTP_AUTH=1
      - MAIL_SMTP_HOST=${SPRW_EASYAPPOINTMENTS_MAIL_HOST}
      - MAIL_SMTP_PORT=${SPRW_EASYAPPOINTMENTS_MAIL_PORT:-587}
      - MAIL_SMTP_CRYPTO=tls
      - MAIL_SMTP_USER=${SPRW_EASYAPPOINTMENTS_MAIL_USER}
      - MAIL_SMTP_PASS=${SPRW_EASYAPPOINTMENTS_MAIL_PASSWORD}
      - MAIL_FROM_ADDRESS=${SPRW_EASYAPPOINTMENTS_MAIL_FROM}
      - MAIL_FROM_NAME=${SPRW_EASYAPPOINTMENTS_MAIL_FROM_NAME:-Terminbuchung}
      - MAIL_REPLY_TO_ADDRESS=${SPRW_EASYAPPOINTMENTS_MAIL_FROM}
      {%- elif SPRW_EASYAPPOINTMENTS_MAIL_ENABLED == "false" %}
      # Mail disabled until a real mailbox exists (MAIL_ENABLED=false).
      {%- endif %}
    depends_on:
      db:
        condition: service_healthy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.loadbalancer.server.port=80"
      {%- if SPRW__EXTERNAL_ACCESS == "true" %}
      - "traefik.docker.network=proxy-shared"
      {%- elif SPRW__EXTERNAL_ACCESS == "false" %}
      # Limit IP access (only VPN and internal networks)
      - "traefik.http.routers.${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}.middlewares=iprestrict@file"
      {%- endif %}

  db:
    image: ${SPRW_EASYAPPOINTMENTS_DB_IMAGE:-mariadb:11.4-noble}
    container_name: ${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}_db
    restart: unless-stopped
    mem_limit: ${SPRW_EASYAPPOINTMENTS_DB_MEM_LIMIT:-256m}
    networks:
      - customer-net
    command:
      - --innodb-buffer-pool-size=${SPRW_EASYAPPOINTMENTS_INNODB_BUFFER_POOL:-64M}
      - --performance-schema=OFF
      - --skip-name-resolve
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}/db:/var/lib/mysql
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}_db:/var/lib/mysql
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}_db:/var/lib/mysql
    {%- endif %}
    environment:
      - MYSQL_ROOT_PASSWORD=${SPRW_EASYAPPOINTMENTS_DB_ROOT_PASSWORD}
      - MYSQL_DATABASE=${SPRW_EASYAPPOINTMENTS_DB_NAME:-easyappointments}
      - MYSQL_USER=${SPRW_EASYAPPOINTMENTS_DB_USER:-easyappointments}
      - MYSQL_PASSWORD=${SPRW_EASYAPPOINTMENTS_DB_PASSWORD}
      - TZ=${SPRW_EASYAPPOINTMENTS_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}_db:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}/db
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-easyappointments_d_buchung_example_com}_db:
{%- endif %}

# ===================== Networks =====================
# customer-net: app + MariaDB (created by ensure-networks.sh / app.sh if missing)
# proxy-shared: Traefik + web frontend only; the database stays off this network
{%- if SPRW__EXTERNAL_ACCESS == "true" %}
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- elif SPRW__EXTERNAL_ACCESS == "false" %}
# Container is accessible only internally, e.g. by LAN or VPN.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
{%- endif %}
