#!/bin/bash
# ovpnadmin.sh - helper for the OpenVPN stack
# Generated from _templates_/openvpn/ovpnadmin.sh.template
# Secrets are never printed. Client configs are only written to files you name.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"

usage() {
    cat <<USAGE
Usage: ovpnadmin.sh <command> [args]

  add-client <name>          Create a client certificate (no-op if it exists).
  export-client <name> <dir> Copy <name>.ovpn into <dir> (chmod 600). Never printed.
  revoke-client <name>       Revoke a client certificate (no confirmation prompt).
  list                       List client names (no keys).
  status                     Show container / tun / listen settings (no secrets).

The image creates one first client (see OVPN_CLIENT_NAME in the persistent
config, default "initial") on the first start. Export or revoke it on purpose.
USAGE
}

container_running() {
    docker inspect "$SPRW__STACKNAME" >/dev/null 2>&1
}

cmd_list() {
    if ! container_running; then
        echo "ERROR: container ${SPRW__STACKNAME} is not running." >&2
        exit 1
    fi
    docker exec "$SPRW__STACKNAME" ovpn_manage --listclients
}

cmd_add_client() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "ERROR: usage: ovpnadmin.sh add-client <name>" >&2
        exit 1
    fi
    if ! container_running; then
        echo "ERROR: container ${SPRW__STACKNAME} is not running." >&2
        exit 1
    fi
    if docker exec "$SPRW__STACKNAME" test -f "/etc/openvpn/server/easy-rsa/pki/issued/${name}.crt"; then
        echo "Client ${name} already exists."
        return 0
    fi
    if ! docker exec "$SPRW__STACKNAME" ovpn_manage --addclient "$name"; then
        echo "ERROR: failed to create client ${name} (details not re-printed if they might contain secrets)." >&2
        exit 1
    fi
    echo "Created client ${name}."
}

cmd_export_client() {
    local name="${1:-}"
    local dest="${2:-}"
    if [ -z "$name" ] || [ -z "$dest" ]; then
        echo "ERROR: usage: ovpnadmin.sh export-client <name> <dir>" >&2
        exit 1
    fi
    if ! container_running; then
        echo "ERROR: container ${SPRW__STACKNAME} is not running." >&2
        exit 1
    fi
    mkdir -p "$dest"
    chmod 700 "$dest"
    if ! docker exec "$SPRW__STACKNAME" test -f "/etc/openvpn/clients/${name}.ovpn"; then
        echo "ERROR: no client config named ${name}.ovpn in the container." >&2
        exit 1
    fi
    local conf="${dest}/${name}.ovpn"
    umask 077
    if ! docker cp "${SPRW__STACKNAME}:/etc/openvpn/clients/${name}.ovpn" "$conf"; then
        echo "ERROR: could not copy configuration for ${name}" >&2
        rm -f "$conf"
        exit 1
    fi
    if [ ! -s "$conf" ]; then
        echo "ERROR: configuration download was empty" >&2
        rm -f "$conf"
        exit 1
    fi
    # Sanity check only; do not print the file.
    if ! grep -q '^client$' "$conf" && ! grep -q '^remote ' "$conf"; then
        echo "ERROR: downloaded file does not look like an OpenVPN client profile (not printed)." >&2
        rm -f "$conf"
        exit 1
    fi
    chmod 600 "$conf"
    echo "Wrote ${name}.ovpn under ${dest} (chmod 600). Contents not printed."
}

cmd_revoke_client() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        echo "ERROR: usage: ovpnadmin.sh revoke-client <name>" >&2
        exit 1
    fi
    if ! container_running; then
        echo "ERROR: container ${SPRW__STACKNAME} is not running." >&2
        exit 1
    fi
    if ! docker exec "$SPRW__STACKNAME" ovpn_manage --revokeclient "$name" -y; then
        echo "ERROR: failed to revoke client ${name}." >&2
        exit 1
    fi
    echo "Revoked client ${name}."
}

cmd_status() {
    echo "stack: ${SPRW__STACKNAME}"
    echo "customer: ${SPRW__CUSTOMER}"
    echo "data: ${SPRW__DATA_DIR}"
    if [ -f "$SPRW__DATA_DIR/scripts/firewall.conf" ]; then
        # Print only non-secret topology fields already in firewall.conf.
        grep -E '^(OVPN_CIDR|CUSTOMER_CIDR|OVPN_PORT|OVPN_PROTO)=' "$SPRW__DATA_DIR/scripts/firewall.conf" || true
    fi
    if container_running; then
        docker inspect "$SPRW__STACKNAME" | jq -r '"container: " + .[0].State.Status + " health=" + (.[0].State.Health.Status // "n/a")'
        docker exec "$SPRW__STACKNAME" sh -c 'ip -brief link show tun0 2>/dev/null || true; echo "---"; grep -E "^(port|proto|server|dev) " /etc/openvpn/server/server.conf 2>/dev/null || true'
    else
        echo "container: not found"
    fi
}

cmd="${1:-}"
shift || true
case "$cmd" in
    add-client)    cmd_add_client "$@" ;;
    export-client) cmd_export_client "$@" ;;
    revoke-client) cmd_revoke_client "$@" ;;
    list)          cmd_list "$@" ;;
    status)        cmd_status "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "ERROR: unknown command ${cmd}" >&2; usage; exit 1 ;;
esac
