# App "postiz" - compose template
# Postiz social media scheduler (AGPL-3.0). Single instance per customer:
# postiz_c_<customer>.
# Services: postiz (frontend + backend + workers), PostgreSQL, Valkey (Redis) and
# Temporal (workflow engine, required by Postiz 2.x). Temporal stores its data in
# the same PostgreSQL instance (databases temporal + temporal_visibility) and runs
# without Elasticsearch to save RAM. No Temporal web UI is published.
# All images are multi-arch, including linux/arm64.
#
# Generated by app.sh from _templates_/postiz/compose.yaml.template - do not
# edit, edit the template or the persistent config.
#
# Options (Docusaurus buttons / Jinja2):
#   SPRW_POSTIZ_REGISTRATION: open | closed
#     open   = anyone can create an account (needed once for the first user)
#     closed = new accounts only by invitation
#   SPRW_POSTIZ_PROVIDER_<NAME>: true | false  (one switch per social network, see
#     profile.template and pre-deploy.sh.template; switched-on networks without
#     keys stay hidden until the keys are in the persistent config)
#   SPRW_POSTIZ_OIDC: false | true
#     true = additional "Sign in with ..." button for a generic OIDC provider
#            (e.g. Authelia or Authentik). Client ID/secret come from the provider.
services:
  postiz:
    image: ${SPRW_POSTIZ_IMAGE:-ghcr.io/gitroomhq/postiz-app:v2.26.0}
    container_name: ${SPRW__STACKNAME:-postiz_c_customer_directory}
    restart: unless-stopped
    mem_limit: ${SPRW_POSTIZ_MEM_LIMIT:-1536m}
    cpus: ${SPRW_POSTIZ_CPUS:-1.5}
    # Social network keys + HIDDEN_PROVIDERS (chmod 600, written by pre-deploy.sh, not sent to Komodo)
    env_file:
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/secrets/providers.env
    networks:
      - proxy-shared
      - customer-net
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/config:/config
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/uploads:/uploads
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_config:/config
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_uploads:/uploads
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_config:/config
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_uploads:/uploads
    {%- endif %}
    environment:
      - TZ=${SPRW_POSTIZ_TIMEZONE:-Europe/Berlin}
      - MAIN_URL=https://${SPRW__APPDOMAIN}
      - FRONTEND_URL=https://${SPRW__APPDOMAIN}
      - NEXT_PUBLIC_BACKEND_URL=https://${SPRW__APPDOMAIN}/api
      - BACKEND_INTERNAL_URL=http://localhost:3000
      - JWT_SECRET=${SPRW_POSTIZ_JWT_SECRET}
      - DATABASE_URL=postgresql://${SPRW_POSTIZ_DB_USER:-postiz}:${SPRW_POSTIZ_DB_PASSWORD}@db:5432/${SPRW_POSTIZ_DB_NAME:-postiz}
      - REDIS_URL=redis://redis:6379
      - TEMPORAL_ADDRESS=temporal:7233
      - IS_GENERAL=true
      {%- if SPRW_POSTIZ_REGISTRATION == "closed" %}
      - DISABLE_REGISTRATION=true
      {%- elif SPRW_POSTIZ_REGISTRATION == "open" %}
      - DISABLE_REGISTRATION=false
      {%- endif %}
      - RUN_CRON=true
      - STORAGE_PROVIDER=local
      - UPLOAD_DIRECTORY=/uploads
      - NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
      - API_LIMIT=30
      - NX_ADD_PLUGINS=false
      # Social networks: keys and HIDDEN_PROVIDERS come from secrets/providers.env
      # (env_file above), written by pre-deploy.sh from the persistent config.
      # Switch networks with SPRW_POSTIZ_PROVIDER_<NAME>=true|false.
      {%- if SPRW_POSTIZ_OIDC == "true" %}
      - POSTIZ_GENERIC_OAUTH=true
      - NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=${SPRW_POSTIZ_OIDC_DISPLAY_NAME}
      {%- if SPRW_POSTIZ_OIDC_URL %}
      - POSTIZ_OAUTH_URL=${SPRW_POSTIZ_OIDC_URL}
      {%- endif %}
      {%- if SPRW_POSTIZ_OIDC_AUTH_URL %}
      - POSTIZ_OAUTH_AUTH_URL=${SPRW_POSTIZ_OIDC_AUTH_URL}
      {%- endif %}
      {%- if SPRW_POSTIZ_OIDC_TOKEN_URL %}
      - POSTIZ_OAUTH_TOKEN_URL=${SPRW_POSTIZ_OIDC_TOKEN_URL}
      {%- endif %}
      {%- if SPRW_POSTIZ_OIDC_USERINFO_URL %}
      - POSTIZ_OAUTH_USERINFO_URL=${SPRW_POSTIZ_OIDC_USERINFO_URL}
      {%- endif %}
      {%- if SPRW_POSTIZ_OIDC_CLIENT_ID %}
      - POSTIZ_OAUTH_CLIENT_ID=${SPRW_POSTIZ_OIDC_CLIENT_ID}
      {%- endif %}
      {%- if SPRW_POSTIZ_OIDC_CLIENT_SECRET %}
      - POSTIZ_OAUTH_CLIENT_SECRET=${SPRW_POSTIZ_OIDC_CLIENT_SECRET}
      {%- endif %}
      - POSTIZ_OAUTH_SCOPE=openid profile email
      {%- endif %}
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      temporal:
        condition: service_healthy
    healthcheck:
      test:
        - CMD-SHELL
        - node -e "require('http').get('http://127.0.0.1:5000/',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 180s
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy-shared"
      - "traefik.http.routers.${SPRW__STACKNAME:-postiz_c_customer_directory}.rule=Host(`${SPRW__APPDOMAIN}`)"
      - "traefik.http.routers.${SPRW__STACKNAME:-postiz_c_customer_directory}.entrypoints=websecure"
      {%- if SPRW__HTTP_REDIRECT == "true" %}
      # HTTP → HTTPS is already done globally by Traefik's web entrypoint (to: websecure).
      {%- elif SPRW__HTTP_REDIRECT == "false" %}
      # Only the websecure entrypoint is used; no extra HTTP router.
      {%- endif %}
      - "traefik.http.routers.${SPRW__STACKNAME:-postiz_c_customer_directory}.tls=true"
      {%- if SPRW__LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-postiz_c_customer_directory}.tls.certresolver=letsencrypt"
      {%- elif SPRW__LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.${SPRW__STACKNAME:-postiz_c_customer_directory}.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      - "traefik.http.services.${SPRW__STACKNAME:-postiz_c_customer_directory}.loadbalancer.server.port=5000"
      {%- if SPRW__EXTERNAL_ACCESS == "false" %}
      # Only VPN and internal networks. The middleware is defined here, no file provider needed.
      - "traefik.http.middlewares.${SPRW__STACKNAME:-postiz_c_customer_directory}-iprestrict.ipallowlist.sourcerange=${SPRW_POSTIZ_INTERNAL_SOURCERANGE}"
      - "traefik.http.routers.${SPRW__STACKNAME:-postiz_c_customer_directory}.middlewares=${SPRW__STACKNAME:-postiz_c_customer_directory}-iprestrict"
      {%- endif %}

  db:
    image: ${SPRW_POSTIZ_DB_IMAGE:-postgres:17.12-alpine}
    container_name: ${SPRW__STACKNAME:-postiz_c_customer_directory}_db
    restart: unless-stopped
    mem_limit: ${SPRW_POSTIZ_DB_MEM_LIMIT:-256m}
    networks:
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_postgres:/var/lib/postgresql/data
    {%- endif %}
    environment:
      - POSTGRES_USER=${SPRW_POSTIZ_DB_USER:-postiz}
      - POSTGRES_PASSWORD=${SPRW_POSTIZ_DB_PASSWORD}
      - POSTGRES_DB=${SPRW_POSTIZ_DB_NAME:-postiz}
      - TZ=${SPRW_POSTIZ_TIMEZONE:-Europe/Berlin}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${SPRW_POSTIZ_DB_USER:-postiz} -d ${SPRW_POSTIZ_DB_NAME:-postiz}"]
      interval: 10s
      timeout: 5s
      retries: 6

  redis:
    image: ${SPRW_POSTIZ_REDIS_IMAGE:-valkey/valkey:9.0.7-alpine}
    container_name: ${SPRW__STACKNAME:-postiz_c_customer_directory}_redis
    restart: unless-stopped
    mem_limit: ${SPRW_POSTIZ_REDIS_MEM_LIMIT:-64m}
    networks:
      - backend
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/redis:/data
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_redis:/data
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-postiz_c_customer_directory}_redis:/data
    {%- endif %}
    healthcheck:
      test: ["CMD-SHELL", "valkey-cli ping | grep -q PONG || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 6

  temporal:
    image: ${SPRW_POSTIZ_TEMPORAL_IMAGE:-temporalio/auto-setup:1.28.1}
    container_name: ${SPRW__STACKNAME:-postiz_c_customer_directory}_temporal
    restart: unless-stopped
    mem_limit: ${SPRW_POSTIZ_TEMPORAL_MEM_LIMIT:-512m}
    networks:
      - backend
    environment:
      - DB=postgres12
      - DB_PORT=5432
      - POSTGRES_SEEDS=db
      - POSTGRES_USER=${SPRW_POSTIZ_DB_USER:-postiz}
      - POSTGRES_PWD=${SPRW_POSTIZ_DB_PASSWORD}
      - ENABLE_ES=false
      - DEFAULT_NAMESPACE=default
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "temporal operator cluster health --address temporal:7233 || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 60s

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-postiz_c_customer_directory}_config:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/config

  ${SPRW__STACKNAME:-postiz_c_customer_directory}_uploads:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/uploads

  ${SPRW__STACKNAME:-postiz_c_customer_directory}_postgres:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/postgres

  ${SPRW__STACKNAME:-postiz_c_customer_directory}_redis:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-postiz_c_customer_directory}/redis
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-postiz_c_customer_directory}_config:
  ${SPRW__STACKNAME:-postiz_c_customer_directory}_uploads:
  ${SPRW__STACKNAME:-postiz_c_customer_directory}_postgres:
  ${SPRW__STACKNAME:-postiz_c_customer_directory}_redis:
{%- endif %}

# ===================== Networks =====================
# proxy-shared: Traefik (always attached; EXTERNAL_ACCESS=false limits access with an IP allowlist)
# customer-net: other apps of the same customer (created by ensure-networks.sh if missing)
# backend:      stack-local, internal network for PostgreSQL, Valkey and Temporal
networks:
  proxy-shared:
    external: true
    name: proxy-shared
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
  backend:
    name: ${SPRW__STACKNAME:-postiz_c_customer_directory}_backend
    internal: true
