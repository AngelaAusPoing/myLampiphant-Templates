SPRW_POSTIZ_PROVIDER_FARCASTER='!!PROVIDER_FARCASTER!!'      # Farcaster (Neynar): true | false
SPRW_POSTIZ_PROVIDER_BLUESKY='!!PROVIDER_BLUESKY!!'          # Bluesky: true | false
SPRW_POSTIZ_PROVIDER_WORDPRESS='!!PROVIDER_WORDPRESS!!'      # WordPress: true | false
SPRW_POSTIZ_PROVIDER_LEMMY='!!PROVIDER_LEMMY!!'              # Lemmy: true | false
SPRW_POSTIZ_PROVIDER_NOSTR='!!PROVIDER_NOSTR!!'              # Nostr: true | false
SPRW_POSTIZ_PROVIDER_MEDIUM='!!PROVIDER_MEDIUM!!'            # Medium: true | false
SPRW_POSTIZ_PROVIDER_DEVTO='!!PROVIDER_DEVTO!!'              # Dev.to: true | false
SPRW_POSTIZ_PROVIDER_HASHNODE='!!PROVIDER_HASHNODE!!'        # Hashnode: true | false
