# myLampiphant app "authelia" - compose template
# Host-level SSO (customer "_host_", stack name "authelia", no suffix).
# Portal + Traefik ForwardAuth middleware "authelia@docker".
# LDAP bind is read-only against the host "ldap" stack on ldap-shared.
# Image: authelia/authelia (multi-arch, including linux/arm64).
#
# Generated by app.sh from _templates_/authelia/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  authelia:
    image: ${AUTHELIA_IMAGE:-authelia/authelia:4.39.28}
    container_name: !!STACKNAME!!
    hostname: authelia
    restart: unless-stopped
    mem_limit: ${AUTHELIA_MEM_LIMIT:-128m}
    user: "1000:1000"
    environment:
      - TZ=${TIMEZONE:-Europe/Berlin}
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/run/secrets/jwt
      - AUTHELIA_SESSION_SECRET_FILE=/run/secrets/session
      - AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/run/secrets/storage
      - AUTHELIA_AUTHENTICATION_BACKEND_LDAP_PASSWORD_FILE=/run/secrets/ldap_bind_pw
      {%- if NOTIFIER == "smtp" %}
      - AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE=/run/secrets/smtp_pw
      {%- endif %}
    {%- if VOLUME_MODE == "bind" %}
    volumes:
      - !!DATA_DIR!!/config:/config
      - !!DATA_DIR!!/secrets/jwt.secret:/run/secrets/jwt:ro
      - !!DATA_DIR!!/secrets/session.secret:/run/secrets/session:ro
      - !!DATA_DIR!!/secrets/storage.secret:/run/secrets/storage:ro
      - !!DATA_DIR!!/secrets/ldap-bind.pw:/run/secrets/ldap_bind_pw:ro
      {%- if NOTIFIER == "smtp" %}
      - !!DATA_DIR!!/secrets/smtp.pw:/run/secrets/smtp_pw:ro
      {%- endif %}
    {%- elif VOLUME_MODE == "named_bind" %}
    volumes:
      - !!STACKNAME!!_config:/config
      - !!DATA_DIR!!/secrets/jwt.secret:/run/secrets/jwt:ro
      - !!DATA_DIR!!/secrets/session.secret:/run/secrets/session:ro
      - !!DATA_DIR!!/secrets/storage.secret:/run/secrets/storage:ro
      - !!DATA_DIR!!/secrets/ldap-bind.pw:/run/secrets/ldap_bind_pw:ro
      {%- if NOTIFIER == "smtp" %}
      - !!DATA_DIR!!/secrets/smtp.pw:/run/secrets/smtp_pw:ro
      {%- endif %}
    {%- elif VOLUME_MODE == "managed" %}
    volumes:
      - !!STACKNAME!!_config:/config
      - !!DATA_DIR!!/secrets/jwt.secret:/run/secrets/jwt:ro
      - !!DATA_DIR!!/secrets/session.secret:/run/secrets/session:ro
      - !!DATA_DIR!!/secrets/storage.secret:/run/secrets/storage:ro
      - !!DATA_DIR!!/secrets/ldap-bind.pw:/run/secrets/ldap_bind_pw:ro
      {%- if NOTIFIER == "smtp" %}
      - !!DATA_DIR!!/secrets/smtp.pw:/run/secrets/smtp_pw:ro
      {%- endif %}
    {%- endif %}
    networks:
      proxy-shared:
        aliases:
          - authelia
      ldap-shared: {}
      {%- if NOTIFIER == "smtp" %}
      mail-shared: {}
      {%- endif %}
      {%- if STORAGE_MODE == "redis" %}
      authelia-internal: {}
      {%- endif %}
    {%- if STORAGE_MODE == "redis" %}
    depends_on:
      redis:
        condition: service_healthy
    {%- endif %}
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:9091/api/health"]
      interval: 15s
      timeout: 5s
      retries: 8
      start_period: 40s
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!STACKNAME!!.rule=!!ROUTER_RULE!!"
      - "traefik.http.routers.!!STACKNAME!!.entrypoints=websecure"
      - "traefik.http.routers.!!STACKNAME!!.tls=true"
      {%- if LETSENCRYPT_METHOD == "acme" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt"
      {%- elif LETSENCRYPT_METHOD == "dns01" %}
      - "traefik.http.routers.!!STACKNAME!!.tls.certresolver=letsencrypt-dns"
      {%- endif %}
      {%- if HTTP_REDIRECT == "true" %}
      - "traefik.http.routers.!!STACKNAME!!-http.rule=!!ROUTER_RULE!!"
      - "traefik.http.routers.!!STACKNAME!!-http.entrypoints=web"
      - "traefik.http.routers.!!STACKNAME!!-http.middlewares=!!STACKNAME!!-https"
      - "traefik.http.middlewares.!!STACKNAME!!-https.redirectscheme.scheme=https"
      {%- endif %}
      {%- if EXTERNAL_ACCESS == "false" %}
      - "traefik.http.routers.!!STACKNAME!!.middlewares=iprestrict@file"
      {%- endif %}
      - "traefik.http.services.!!STACKNAME!!.loadbalancer.server.port=9091"
      - "traefik.docker.network=proxy-shared"
      # Named middleware for other stacks: authelia@docker
      # Opt in with AUTH_PROTECT=true (see README and the dokuwiki template).
      - "traefik.http.middlewares.authelia.forwardauth.address=http://authelia:9091/api/authz/forward-auth"
      - "traefik.http.middlewares.authelia.forwardauth.trustForwardHeader=true"
      - "traefik.http.middlewares.authelia.forwardauth.maxResponseBodySize=8192"
      - "traefik.http.middlewares.authelia.forwardauth.authResponseHeaders=Remote-User,Remote-Groups,Remote-Name,Remote-Email"

  {%- if STORAGE_MODE == "redis" %}
  redis:
    image: ${AUTHELIA_REDIS_IMAGE:-redis:7.4-alpine}
    container_name: !!STACKNAME!!-redis
    hostname: redis
    restart: unless-stopped
    mem_limit: ${AUTHELIA_REDIS_MEM_LIMIT:-64m}
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    networks:
      - authelia-internal
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s
  {%- endif %}

{%- if VOLUME_MODE == "named_bind" %}
volumes:
  !!STACKNAME!!_config:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: !!DATA_DIR!!/config
{%- elif VOLUME_MODE == "managed" %}
volumes:
  !!STACKNAME!!_config:
{%- endif %}

networks:
  proxy-shared:
    external: true
    name: proxy-shared
  ldap-shared:
    external: true
    name: ldap-shared
  {%- if NOTIFIER == "smtp" %}
  mail-shared:
    external: true
    name: mail-shared
  {%- endif %}
  {%- if STORAGE_MODE == "redis" %}
  authelia-internal:
    name: !!STACKNAME!!_internal
    driver: bridge
    internal: true
  {%- endif %}
