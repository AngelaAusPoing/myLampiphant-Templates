# myLampiphant app "ldap" - compose template
# OpenLDAP (Debian slapd, image built by Komodo from the Dockerfile in the compose dir)
# + LDAP Account Manager (official image, bound to 127.0.0.1 only)
# + sidecar that writes a daily LDIF export until a real backup app exists
#
# LDAP has no published port and is reachable only on the internal ldap-shared network
# under the alias "ldap" (ldap://ldap:389). LAM is not routed through Traefik.
# Generated by app.sh from _templates_/ldap/compose.yaml.template - do not edit, edit the template or the persistent config.
services:

  openldap:
    build:
      context: !!COMPOSE_DIR!!
      dockerfile: Dockerfile
    image: mylampiphant/openldap:local
    pull_policy: never
    container_name: !!STACKNAME!!
    hostname: ldap
    restart: unless-stopped
    mem_limit: 128m
    env_file:
      - !!DATA_DIR!!/secrets/openldap.env
    environment:
      - TZ=!!TIMEZONE!!
    volumes:
      - !!DATA_DIR!!/config:/etc/ldap/slapd.d
      - !!DATA_DIR!!/data:/var/lib/ldap
      - !!DATA_DIR!!/secrets/root.pw:/run/secrets/ldap_root_pw:ro
      - !!DATA_DIR!!/secrets/readonly.pw:/run/secrets/ldap_readonly_pw:ro
    networks:
      ldap-shared:
        aliases:
          - ldap
    healthcheck:
      test: ["CMD-SHELL", "ldapsearch -x -H ldap://127.0.0.1:389 -s base -b '' namingContexts >/dev/null"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s

  lam:
    image: !!LAM_IMAGE!!
    container_name: !!STACKNAME!!-lam
    restart: unless-stopped
    mem_limit: 256m
    depends_on:
      openldap:
        condition: service_healthy
    ports:
      - "127.0.0.1:!!LAM_PORT!!:80"
    env_file:
      - !!DATA_DIR!!/secrets/lam.env
    environment:
      - TZ=!!TIMEZONE!!
      - LAM_LANG=!!LAM_LANG!!
      - LDAP_SERVER=ldap://ldap:389
      - LDAP_BASE_DN=!!LDAP_BASE_DN!!
      - LDAP_USER=!!LDAP_ROOT_DN!!
      - LDAP_USERS_DN=!!LDAP_BASE_DN!!
      - LDAP_GROUPS_DN=!!LDAP_BASE_DN!!
    volumes:
      - !!DATA_DIR!!/lam/config:/var/lib/ldap-account-manager/config
    networks:
      - ldap-shared
      # A non-internal network is required so Docker can publish 127.0.0.1:LAM_PORT
      # (ports cannot be published from an --internal network). Nothing else uses this net.
      - lam-host

  backup:
    image: mylampiphant/openldap:local
    pull_policy: never
    container_name: !!STACKNAME!!-backup
    restart: unless-stopped
    mem_limit: 64m
    depends_on:
      openldap:
        condition: service_healthy
    healthcheck:
      disable: true
    entrypoint: ["/opt/mylampiphant/backup-loop.sh"]
    env_file:
      - !!DATA_DIR!!/secrets/openldap.env
    environment:
      - TZ=!!TIMEZONE!!
      - LDAP_BACKUP_INTERVAL=!!BACKUP_INTERVAL!!
      - LDAP_SERVER_URI=ldap://ldap:389
    volumes:
      - !!DATA_DIR!!/backup:/backup
      - !!DATA_DIR!!/secrets/root.pw:/run/secrets/ldap_root_pw:ro
    networks:
      - ldap-shared

networks:
  ldap-shared:
    external: true
  lam-host:
    name: !!STACKNAME!!_lam-host
    driver: bridge
