#!/bin/bash
# install.sh for the app "mailserver" - generated by app.sh from _templates_/mailserver/install.sh.template
# Prepares the host side (directories, helper files, configs) BEFORE the stack is deployed via Komodo.
# Idempotent: existing files are never overwritten. Secrets are generated locally and never printed.
set -euo pipefail

SPRW__CUSTOMER="!!CUSTOMER!!"
SPRW__STACKNAME="!!STACKNAME!!"
SPRW__DATA_DIR="!!DATA_DIR!!"
SPRW__COMPOSE_DIR="!!COMPOSE_DIR!!"
SPRW__APPDOMAIN="!!APPDOMAIN!!"
SPRW_MAIL_MAILHOST="!!MAILHOST!!"
SPRW_MAIL_MAILDOMAIN="!!MAILDOMAIN!!"
SPRW_MAIL_POSTMASTER="!!POSTMASTER!!"
SPRW_MAIL_BIND_IP="!!BIND_IP!!"
SPRW_MAIL_MAILNET_SUBNET="!!MAILNET_SUBNET!!"
SPRW_MAIL_RESOLVER_IP="!!RESOLVER_IP!!"
SPRW_MAIL_TRAEFIK_ACME_DIR="!!TRAEFIK_ACME_DIR!!"
SPRW_MAIL_TIMEZONE="!!TIMEZONE!!"
SPRW_MAIL_DMS_VERSION="!!DMS_VERSION!!"
SPRW_MAIL_ROUNDCUBE_VERSION="!!ROUNDCUBE_VERSION!!"
SPRW_MAIL_MESSAGE_SIZE_LIMIT="!!MESSAGE_SIZE_LIMIT!!"
SPRW_MAIL_DKIM_SELECTOR="!!DKIM_SELECTOR!!"

echo "Preparing mailserver ${SPRW__STACKNAME} (mail host ${SPRW_MAIL_MAILHOST}) ..."

# ---------------------------------------------------------------------------
# 1. Refuse to continue with unresolved placeholders (would produce a broken Komodo stack)
# ---------------------------------------------------------------------------
missing=0
for v in SPRW__STACKNAME SPRW__DATA_DIR SPRW__APPDOMAIN SPRW_MAIL_MAILHOST SPRW_MAIL_MAILDOMAIN SPRW_MAIL_POSTMASTER \
         SPRW_MAIL_BIND_IP SPRW_MAIL_MAILNET_SUBNET SPRW_MAIL_RESOLVER_IP SPRW_MAIL_TRAEFIK_ACME_DIR SPRW_MAIL_TIMEZONE \
         SPRW_MAIL_DMS_VERSION SPRW_MAIL_ROUNDCUBE_VERSION SPRW_MAIL_MESSAGE_SIZE_LIMIT SPRW_MAIL_DKIM_SELECTOR; do
    val="${!v}"
    if [ -z "$val" ] || [[ "$val" == *'!!'* ]]; then
        echo "ERROR: $v is not set (placeholder unresolved). Set it in the persistent config or pass --var ${v#SPRW_MAIL_}=..." >&2
        missing=1
    fi
done
SPRW_MAIL_TOGGLES="webmail=!!ENABLE_WEBMAIL!! imapfilter=!!ENABLE_IMAPFILTER!! pop3=!!ENABLE_POP3!! clamav=!!ENABLE_CLAMAV!! fail2ban=!!ENABLE_FAIL2BAN!! greylisting=!!ENABLE_GREYLISTING!! neural=!!ENABLE_NEURAL!!"
for t in $SPRW_MAIL_TOGGLES; do
    case "${t#*=}" in
        true|false) ;;
        *) echo "ERROR: toggle ${t%%=*} must be true or false" >&2; missing=1 ;;
    esac
done
echo "Toggles: ${SPRW_MAIL_TOGGLES}"
if [ "$missing" -ne 0 ]; then
    echo "Review the persistent config (<customer>/_config_/${SPRW__STACKNAME}.env) and run app.sh again." >&2
    exit 1
fi

if [ ! -f "${SPRW_MAIL_TRAEFIK_ACME_DIR}/acme.json" ]; then
    echo "WARNING: ${SPRW_MAIL_TRAEFIK_ACME_DIR}/acme.json not found - the cert dumper cannot export a certificate." >&2
fi

# ---------------------------------------------------------------------------
# 2. Shared internal Docker networks (idempotent). Declared as external in compose.
#    ldap-shared / mail-shared / komodo-internal are created by ensure-networks.sh.
# ---------------------------------------------------------------------------
# shellcheck source=/opt/docker/_scripts_/ensure-networks.sh
source /opt/docker/_scripts_/ensure-networks.sh
ensure_shared_networks

# LDAP bind password for docker-mailserver (only when ACCOUNT_PROVISIONER=LDAP).
# The file is mounted into the container; it is never written to the Komodo .env.
mkdir -p "$SPRW__DATA_DIR/secrets"
chmod 700 "$SPRW__DATA_DIR/secrets"
if [ "${SPRW_MAIL_ACCOUNT_PROVISIONER:-FILE}" = "LDAP" ]; then
    dest="$SPRW__DATA_DIR/secrets/ldap-bind.pw"
    if [ ! -s "$dest" ]; then
        src="/opt/docker-data/_host_/ldap/secrets/readonly.pw"
        if [ -s "$src" ]; then
            umask 077
            cp "$src" "$dest"
            chmod 600 "$dest"
        else
            echo "ERROR: ACCOUNT_PROVISIONER=LDAP but $dest is missing and $src was not found."
            echo "Place the LDAP read-only bind password in $dest (chmod 600) and run install again."
            exit 1
        fi
    fi
    # docker compose env_file (host path, not the Komodo .env). Needed because DMS
    # LDAP_BIND_PW__FILE is not exported into the environment Postfix templates use.
    envf="$SPRW__DATA_DIR/secrets/ldap-bind.env"
    umask 077
    printf "LDAP_BIND_PW=%s\n" "$(cat "$dest")" > "$envf"
    chmod 600 "$envf"
    # DMS hook: keep Postfix ldap bind_pw in sync with the secret file on every start
    patch="$SPRW__DATA_DIR/config/user-patches.sh"
    cat > "$patch" <<'PATCH'
#!/bin/bash
# managed by myLampiphant mailserver install.sh - no secrets in this file
set -euo pipefail

# 1. Keep Postfix LDAP bind_pw in sync with the secret file
PW_FILE=/run/secrets/ldap_bind_pw
if [ -s "$PW_FILE" ]; then
  pw=$(cat "$PW_FILE")
  for f in /etc/postfix/ldap-users.cf /etc/postfix/ldap-aliases.cf /etc/postfix/ldap-groups.cf /etc/postfix/ldap-domains.cf /etc/postfix/ldap-senders.cf /etc/postfix/maps/sender_login_maps.ldap; do
    [ -f "$f" ] || continue
    tmp="${f}.tmp"
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        bind_pw*|bind_pw[[:space:]]*)
          printf 'bind_pw = %s
' "$pw"
          ;;
        *)
          printf '%s
' "$line"
          ;;
      esac
    done < "$f" > "$tmp"
    mv "$tmp" "$f"
    chmod 600 "$f"
  done
  unset pw
else
  echo "user-patches: $PW_FILE missing, skipping LDAP bind_pw update"
fi

# 2. Enable Dovecot master users also when ACCOUNT_PROVISIONER=LDAP
#    (DMS only runs _create_masters for FILE).
MASTERS_CF=/tmp/docker-mailserver/dovecot-masters.cf
MASTERDB=/etc/dovecot/masterdb
if [ -s "$MASTERS_CF" ]; then
  : > "$MASTERDB"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    login=${line%%|*}
    rest=${line#*|}
    [ -n "$login" ] && [ -n "$rest" ] && printf '%s:%s
' "$login" "$rest"
  done < "$MASTERS_CF" >> "$MASTERDB"
  chown dovecot:dovecot "$MASTERDB"
  chmod 640 "$MASTERDB"
  sed -i -e '/\!include auth-master\.inc/s/^#//' /etc/dovecot/conf.d/10-auth.conf
  echo "user-patches: enabled Dovecot master users from ${MASTERS_CF}"
fi
PATCH
    chmod 700 "$patch"
fi

# ---------------------------------------------------------------------------
# 3. Directories
# ---------------------------------------------------------------------------
mkdir -p "$SPRW__COMPOSE_DIR"
mkdir -p "$SPRW__DATA_DIR"/{mail-data,mail-state,mail-logs,config,tls,certdumper,roundcube/db,roundcube/config,imapfilter}
mkdir -p "$SPRW__DATA_DIR"/config/rspamd/override.d
chmod 700 "$SPRW__DATA_DIR/tls" "$SPRW__DATA_DIR/imapfilter"

# ---------------------------------------------------------------------------
# 4. Cert dumper script (exports only CERT_DOMAIN from Traefik's acme.json)
# ---------------------------------------------------------------------------
cat > "$SPRW__DATA_DIR/certdumper/certdumper.py" <<'PY'
#!/usr/bin/env python3
"""Export ONE certificate (CERT_DOMAIN) from Traefik's acme.json to OUT_DIR as fullchain.pem/privkey.pem.

Only the matching certificate is written; all other keys in acme.json are never copied.
Files are replaced atomically and only when the certificate changed.
"""
import base64, hashlib, json, os, sys, time

SRC = os.environ.get("ACME_JSON", "/traefik/acme.json")
DOMAIN = os.environ["CERT_DOMAIN"].strip().lower()
OUT = os.environ.get("OUT_DIR", "/out")
INTERVAL = int(os.environ.get("INTERVAL", "60"))


def find_cert():
    with open(SRC, "r", encoding="utf-8") as fh:
        data = json.load(fh)
    for resolver in data.values():
        if not isinstance(resolver, dict):
            continue
        for cert in resolver.get("Certificates") or []:
            dom = cert.get("domain") or {}
            names = [dom.get("main", "")] + list(dom.get("sans") or [])
            if DOMAIN in [n.lower() for n in names if n]:
                return base64.b64decode(cert["certificate"]), base64.b64decode(cert["key"])
    return None


def write(name, content, mode):
    path = os.path.join(OUT, name)
    tmp = path + ".tmp"
    with open(tmp, "wb") as fh:
        fh.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def current_hash():
    try:
        with open(os.path.join(OUT, "fullchain.pem"), "rb") as c, open(os.path.join(OUT, "privkey.pem"), "rb") as k:
            return hashlib.sha256(c.read() + k.read()).hexdigest()
    except OSError:
        return None


last_state = None
while True:
    try:
        found = find_cert()
        if found is None:
            state = "missing"
            if state != last_state:
                print(f"certificate for {DOMAIN} not (yet) in acme.json - keeping existing files", flush=True)
        else:
            chain, key = found
            new_hash = hashlib.sha256(chain + key).hexdigest()
            state = new_hash
            if new_hash != current_hash():
                write("privkey.pem", key, 0o600)
                write("fullchain.pem", chain, 0o644)
                print(f"exported certificate for {DOMAIN}", flush=True)
            elif state != last_state:
                print(f"certificate for {DOMAIN} is up to date", flush=True)
        last_state = state
    except Exception as exc:  # keep running, Traefik may be rewriting the file
        print(f"error: {exc}", file=sys.stderr, flush=True)
    time.sleep(INTERVAL)
PY
chmod 644 "$SPRW__DATA_DIR/certdumper/certdumper.py"

# Bootstrap: self-signed certificate until Traefik has issued the real one (replaced automatically)
if [ ! -f "$SPRW__DATA_DIR/tls/fullchain.pem" ] || [ ! -f "$SPRW__DATA_DIR/tls/privkey.pem" ]; then
    openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
        -subj "/CN=${SPRW_MAIL_MAILHOST}" -addext "subjectAltName=DNS:${SPRW_MAIL_MAILHOST}" \
        -keyout "$SPRW__DATA_DIR/tls/privkey.pem" -out "$SPRW__DATA_DIR/tls/fullchain.pem" >/dev/null 2>&1
    chmod 600 "$SPRW__DATA_DIR/tls/privkey.pem"
    echo "Created temporary self-signed certificate for ${SPRW_MAIL_MAILHOST}"
fi

# ---------------------------------------------------------------------------
# 5. docker-mailserver configuration (only created if missing)
# ---------------------------------------------------------------------------
# fail2ban: never ban the stack's own network (webmail/imapfilter), otherwise one wrong
# webmail login would lock out all webmail users. Roundcube has its own login rate limit.
if [ ! -f "$SPRW__DATA_DIR/config/fail2ban-jail.cf" ]; then
    cat > "$SPRW__DATA_DIR/config/fail2ban-jail.cf" <<CFG
[DEFAULT]
ignoreip = 127.0.0.1/8 ${SPRW_MAIL_MAILNET_SUBNET}
bantime = 1h
findtime = 10m
maxretry = 5
CFG
fi

# Rspamd: use the stack's own Unbound resolver (generic fix for RBLs that block public resolvers)
if [ ! -f "$SPRW__DATA_DIR/config/rspamd/override.d/options.inc" ]; then
    cat > "$SPRW__DATA_DIR/config/rspamd/override.d/options.inc" <<CFG
# managed by myLampiphant install.sh - Rspamd must use the local recursive resolver
dns {
  nameserver = ["${SPRW_MAIL_RESOLVER_IP}:53"];
  timeout = 2s;
  retransmits = 3;
}
CFG
fi

# Roundcube can notify Rspamd via markasjunk -> learning is done by Dovecot IMAPSieve (RSPAMD_LEARN=1)

# ---------------------------------------------------------------------------
# 6. Roundcube additional config (included by the official image from /var/roundcube/config/*.php)
# ---------------------------------------------------------------------------
RC_CONF="$SPRW__DATA_DIR/roundcube/config/mylampiphant.inc.php"
if [ ! -f "$RC_CONF" ]; then
    RC_DES_KEY=$(openssl rand -base64 32 | tr -d '/=+' | cut -c1-24)
    cat > "$RC_CONF" <<PHP
<?php
// managed by myLampiphant install.sh - generated once, contains a secret (des_key)
\$config['des_key'] = '${RC_DES_KEY}';
\$config['product_name'] = 'Webmail ${SPRW_MAIL_MAILHOST}';
\$config['login_rate_limit'] = 5;
\$config['imap_conn_options'] = ['ssl' => ['verify_peer' => true, 'verify_peer_name' => true, 'peer_name' => '${SPRW_MAIL_MAILHOST}']];
\$config['smtp_conn_options'] = ['ssl' => ['verify_peer' => true, 'verify_peer_name' => true, 'peer_name' => '${SPRW_MAIL_MAILHOST}']];
// managesieve (Sieve filters, vacation) - port 4190 is only reachable inside the stack network
\$config['managesieve_host'] = 'tls://${SPRW_MAIL_MAILHOST}';
\$config['managesieve_port'] = 4190;
\$config['managesieve_conn_options'] = ['ssl' => ['verify_peer' => true, 'verify_peer_name' => true, 'peer_name' => '${SPRW_MAIL_MAILHOST}']];
\$config['managesieve_vacation'] = 1;
// markasjunk: move to/from Junk, docker-mailserver learns via IMAPSieve
\$config['markasjunk_learning_driver'] = null;
\$config['junk_mbox'] = 'Junk';
PHP
    unset RC_DES_KEY
    # the official Roundcube image runs Apache as www-data (uid 33)
    chown 33:33 "$RC_CONF"
    chmod 640 "$RC_CONF"
fi
chown -R 33:33 "$SPRW__DATA_DIR/roundcube/db"

# ---------------------------------------------------------------------------
# 7. imapfilter example config (no credentials - fill in yourself, keep chmod 600)
# ---------------------------------------------------------------------------
if [ ! -f "$SPRW__DATA_DIR/imapfilter/config.lua" ]; then
    cat > "$SPRW__DATA_DIR/imapfilter/config.lua" <<'LUA'
-- imapfilter example configuration (myLampiphant mailserver)
-- Enable the service with SPRW_MAIL_ENABLE_IMAPFILTER=true in the persistent config and redeploy.
-- Never commit real credentials. Keep this file chmod 600.
options.timeout = 120
options.subscribe = true

-- account1 = IMAP {
--   server = 'mail.example.com',   -- the mail host name (resolves inside the stack network)
--   username = 'user@example.com',
--   password = 'change-me',
--   ssl = 'tls1.2',
-- }
-- account2 = IMAP { server = 'mail.example.com', username = 'other@example.com', password = 'change-me', ssl = 'tls1.2' }
--
-- -- move mails from one account to another
-- local res = account1.INBOX:contain_from('newsletter@example.org')
-- res:move_messages(account2['Newsletter'])
LUA
    chmod 600 "$SPRW__DATA_DIR/imapfilter/config.lua"
fi

echo "✅ Host preparation done for ${SPRW__STACKNAME}"
echo "📁 Data: ${SPRW__DATA_DIR}"
echo "📝 After the stack is running: run mailadmin.sh init (generated next to this install.sh)"
