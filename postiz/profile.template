#!/bin/bash
# Default variables for the app "postiz" (Postiz social media scheduler, AGPL-3.0)
#
# This file is generated ONCE into /opt/docker-data/<customer>/_config_/<app_dir>.env
# and then kept (persistent config). Change values there, not in the generated
# compose/.env files.
#
# Install (one stack per customer; Postiz has teams and several users):
#   app.sh postiz add <customer>
#   app.sh postiz add <customer> --var APPDOMAIN=social.example.com
#
# The stack is named postiz_c_<customer>.
# Register the first user in the web UI, then set REGISTRATION=closed and redeploy.
# Each social network needs a developer app of its own (keys below); see
# https://docs.postiz.com/providers for the callback URLs.
#
# RAM: Postiz plus Temporal need about 1.3-1.8 GB in normal use.
#
# Options (Jinja2 / Docusaurus buttons):
#   SPRW_POSTIZ_REGISTRATION: open (default) | closed
#   SPRW_POSTIZ_OIDC:         false (default) | true   (generic OIDC provider)
#   SPRW_POSTIZ_PROVIDER_<NAME>: true | false   (one switch per social network)
# Postiz has no LDAP.

# The following variables are read by app.sh
SPRW__APP_NAME='postiz'
SPRW__APP_PREFIX='POSTIZ'

# Global environment variables that are used in the app's templates
SPRW__APPDOMAIN='!!APPDOMAIN!!'                     # e.g. social.example.com

# Global Jinja2 variables that are used in the app's templates
SPRW__VOLUME_MODE='!!VOLUME_MODE!!'                 # bind, named_bind, or managed
SPRW__HTTP_REDIRECT='!!HTTP_REDIRECT!!'             # true or false (HTTP→HTTPS)
SPRW__LETSENCRYPT_METHOD='!!LETSENCRYPT_METHOD!!'   # acme or dns01
SPRW__EXTERNAL_ACCESS='!!EXTERNAL_ACCESS!!'         # true or false

# Homer dashboard tile (optional; app.sh default is HOMER_LINK=true)
SPRW__HOMER_LINK='!!HOMER_LINK!!'
SPRW__HOMER_NAME='Postiz'
SPRW__HOMER_ICON='fas fa-share-alt'
SPRW__HOMER_GROUP='Apps'

# App-specific variables (SPRW_POSTIZ_*)
SPRW_POSTIZ_IMAGE='!!IMAGE!!'                       # postiz-app, ARM64-verified
SPRW_POSTIZ_DB_IMAGE='!!DB_IMAGE!!'                 # PostgreSQL (also used by Temporal)
SPRW_POSTIZ_REDIS_IMAGE='!!REDIS_IMAGE!!'           # Valkey (Redis-compatible)
SPRW_POSTIZ_TEMPORAL_IMAGE='!!TEMPORAL_IMAGE!!'     # Temporal server with schema auto-setup (version tested by Postiz)
SPRW_POSTIZ_MEM_LIMIT='!!MEM_LIMIT!!'
SPRW_POSTIZ_CPUS='!!CPUS!!'
SPRW_POSTIZ_DB_MEM_LIMIT='!!DB_MEM_LIMIT!!'
SPRW_POSTIZ_REDIS_MEM_LIMIT='!!REDIS_MEM_LIMIT!!'
SPRW_POSTIZ_TEMPORAL_MEM_LIMIT='!!TEMPORAL_MEM_LIMIT!!'
SPRW_POSTIZ_TIMEZONE='!!TIMEZONE!!'
SPRW_POSTIZ_INTERNAL_SOURCERANGE='!!INTERNAL_SOURCERANGE!!'  # EXTERNAL_ACCESS=false: allowed client networks
SPRW_POSTIZ_REGISTRATION='!!REGISTRATION!!'         # open | closed
SPRW_POSTIZ_OIDC='!!OIDC!!'                         # true | false
SPRW_POSTIZ_DB_NAME='!!DB_NAME!!'
SPRW_POSTIZ_DB_USER='!!DB_USER!!'
SPRW_POSTIZ_DB_PASSWORD="!!NEW_PASSWORD!!"
SPRW_POSTIZ_JWT_SECRET="!!NEW_KEY!!"

# Social networks: one switch per network (true = offered in Postiz, false = hidden).
# A switched-on network that needs a developer app stays hidden until its keys
# below are filled in (pre-deploy.sh writes them to <data_dir>/secrets/providers.env,
# not to Komodo). Networks without keys (Bluesky, WordPress, ...) only need the switch.
# Developer consoles and callback URLs: see the Postiz install page in the docs.
SPRW_POSTIZ_PROVIDER_X='!!PROVIDER_X!!'                      # X: true | false
SPRW_POSTIZ_PROVIDER_LINKEDIN='!!PROVIDER_LINKEDIN!!'        # LinkedIn (Profil + Seite): true | false
SPRW_POSTIZ_PROVIDER_REDDIT='!!PROVIDER_REDDIT!!'            # Reddit: true | false
SPRW_POSTIZ_PROVIDER_FACEBOOK='!!PROVIDER_FACEBOOK!!'        # Facebook + Instagram (Business): true | false
SPRW_POSTIZ_PROVIDER_INSTAGRAM='!!PROVIDER_INSTAGRAM!!'      # Instagram (Standalone): true | false
SPRW_POSTIZ_PROVIDER_THREADS='!!PROVIDER_THREADS!!'          # Threads: true | false
SPRW_POSTIZ_PROVIDER_YOUTUBE='!!PROVIDER_YOUTUBE!!'          # YouTube: true | false
SPRW_POSTIZ_PROVIDER_GMB='!!PROVIDER_GMB!!'                  # Google Business Profile: true | false
SPRW_POSTIZ_PROVIDER_TIKTOK='!!PROVIDER_TIKTOK!!'            # TikTok: true | false
SPRW_POSTIZ_PROVIDER_TIKTOK_BUSINESS='!!PROVIDER_TIKTOK_BUSINESS!!' # TikTok Business: true | false
