{%- endif %}
{%- if SPRW_POSTIZ_PROVIDER_MASTODON == "true" %}
offer "Mastodon" "mastodon" MASTODON_URL MASTODON_CLIENT_ID MASTODON_CLIENT_SECRET || hide "Mastodon" "mastodon" "keys missing"
{%- elif SPRW_POSTIZ_PROVIDER_MASTODON == "false" %}
