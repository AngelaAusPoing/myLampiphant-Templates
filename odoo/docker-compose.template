services:
  postgres:
    image: postgres:16-alpine
    networks:
      - proxy-shared
      - odoo_!!CUSTOMERNAME!!
    volumes:
      - !!DATA_DIR!!/postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_USER=odoo
      - POSTGRES_PASSWORD=!!POSTGRES_PASSWORD!!
      - POSTGRES_DB=odoo
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U odoo"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      restart_policy:
        condition: any

  odoo:
    image: odoo:18.0
    networks:
      - proxy-shared
      - odoo_!!CUSTOMERNAME!!
    volumes:
      - !!DATA_DIR!!/odoo-data:/var/lib/odoo
      - !!DATA_DIR!!/addons:/mnt/extra-addons
      - !!DATA_DIR!!/init-odoo.sh:/usr/local/bin/init-odoo.sh:ro
    environment:
      - HOST=postgres
      - USER=odoo
      - PASSWORD=!!POSTGRES_PASSWORD!!
      - PORT=5432
      - POSTGRES_USER=odoo
      - POSTGRES_PASSWORD=!!POSTGRES_PASSWORD!!
      - PROXY_MODE=True
    command: ["/usr/local/bin/init-odoo.sh"]
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.!!CUSTOMERNAME!!-odoo.rule=Host(`!!ODOO_DOMAIN!!`)"
      - "traefik.http.routers.!!CUSTOMERNAME!!-odoo.entrypoints=websecure"
      - "traefik.http.routers.!!CUSTOMERNAME!!-odoo.tls.certresolver=letsencrypt"
      - "traefik.http.services.!!CUSTOMERNAME!!-odoo.loadbalancer.server.port=8069"
      - "traefik.docker.network=proxy-shared"
    depends_on:
      postgres:
        condition: service_healthy
    deploy:
      restart_policy:
        condition: any

networks:
  odoo_!!CUSTOMERNAME!!:
    driver: overlay
    attachable: true
  proxy-shared:
    external: true
    name: proxy-shared
