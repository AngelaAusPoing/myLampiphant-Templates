# App "rustdesk" - compose template
# RustDesk server OSS: hbbs (ID/rendezvous) + hbbr (relay). Single instance per
# customer: rustdesk_c_<customer>.
#
# RustDesk does not use HTTP, so there is no Traefik router. The clients talk
# directly to the host ports below (TCP + UDP); open them in the firewall.
# The client "ID server" is <APPDOMAIN>:<ID_PORT>, the "Key" is the content of
# <DATA_DIR>/data/id_ed25519.pub (created on first start).
#
# Generated by app.sh from _templates_/rustdesk/compose.yaml.template - do not
# edit, edit the template or the persistent config.
services:
  hbbs:
    image: ${SPRW_RUSTDESK_IMAGE:-rustdesk/rustdesk-server:latest}
    container_name: ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_hbbs
    restart: unless-stopped
    mem_limit: ${SPRW_RUSTDESK_MEM_LIMIT:-64m}
    command: hbbs -p ${SPRW_RUSTDESK_ID_PORT:-21116} -r ${SPRW__APPDOMAIN}:${SPRW_RUSTDESK_RELAY_PORT:-21117}
    networks:
      - customer-net
    ports:
      # NAT test port must be ID_PORT - 1 (clients derive it from the ID port).
      - "${SPRW_RUSTDESK_NAT_PORT:-21115}:${SPRW_RUSTDESK_NAT_PORT:-21115}/tcp"
      - "${SPRW_RUSTDESK_ID_PORT:-21116}:${SPRW_RUSTDESK_ID_PORT:-21116}/tcp"
      - "${SPRW_RUSTDESK_ID_PORT:-21116}:${SPRW_RUSTDESK_ID_PORT:-21116}/udp"
    environment:
      {%- if SPRW_RUSTDESK_ENCRYPTED_ONLY == "true" %}
      - ENCRYPTED_ONLY=1
      {%- elif SPRW_RUSTDESK_ENCRYPTED_ONLY == "false" %}
      - ENCRYPTED_ONLY=0
      {%- endif %}
      - TZ=${SPRW_RUSTDESK_TIMEZONE:-Europe/Berlin}
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-rustdesk_c_customer_directory}/data:/root
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_data:/root
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_data:/root
    {%- endif %}
    depends_on:
      - hbbr

  hbbr:
    image: ${SPRW_RUSTDESK_IMAGE:-rustdesk/rustdesk-server:latest}
    container_name: ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_hbbr
    restart: unless-stopped
    mem_limit: ${SPRW_RUSTDESK_MEM_LIMIT:-64m}
    command: hbbr -p ${SPRW_RUSTDESK_RELAY_PORT:-21117}
    networks:
      - customer-net
    ports:
      - "${SPRW_RUSTDESK_RELAY_PORT:-21117}:${SPRW_RUSTDESK_RELAY_PORT:-21117}/tcp"
    environment:
      {%- if SPRW_RUSTDESK_ENCRYPTED_ONLY == "true" %}
      - ENCRYPTED_ONLY=1
      {%- elif SPRW_RUSTDESK_ENCRYPTED_ONLY == "false" %}
      - ENCRYPTED_ONLY=0
      {%- endif %}
      - TZ=${SPRW_RUSTDESK_TIMEZONE:-Europe/Berlin}
    volumes:
    {%- if SPRW__VOLUME_MODE == "bind" %}
      - /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-rustdesk_c_customer_directory}/data:/root
    {%- elif SPRW__VOLUME_MODE == "named_bind" %}
      - ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_data:/root
    {%- elif SPRW__VOLUME_MODE == "managed" %}
      - ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_data:/root
    {%- endif %}

{%- if SPRW__VOLUME_MODE == "named_bind" %}
# ===================== Volumes =====================
volumes:
  ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /opt/docker-data/${SPRW__CUSTOMER:-customer_directory}/${SPRW__STACKNAME:-rustdesk_c_customer_directory}/data
{%- elif SPRW__VOLUME_MODE == "managed" %}
# ===================== Volumes (managed by Docker) =====================
volumes:
  ${SPRW__STACKNAME:-rustdesk_c_customer_directory}_data:
{%- endif %}

# ===================== Networks =====================
# customer-net only; RustDesk is reached via published host ports, not Traefik.
networks:
  customer-net:
    external: true
    name: c_${SPRW__CUSTOMER:-customer_directory}-net
